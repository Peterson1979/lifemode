---
import type { TopicDataBlock } from '../../../lib/topic-data/types/core.ts';
import type { AirQualityData } from '../../../lib/topic-data/types/topics.ts';
import TopicDataCard from '../TopicDataCard.astro';

export interface Props {
  block: TopicDataBlock<AirQualityData>;
}

const { block } = Astro.props;
const data = block.data;
---

<TopicDataCard block={block}>
  {data && data.readings && (
    <div class="aqi-grid">
      {data.readings.map((reading) => (
        <div class="aqi-card">
          <div class="aqi-header">
            <span class="aqi-city">{reading.city}</span>
            <span class="aqi-country">{reading.country}</span>
          </div>
          <div class="aqi-readout">
            <div class="aqi-score-box" data-cat={reading.aqiCategory.toLowerCase().includes('good') ? 'good' : reading.aqiCategory.toLowerCase().includes('moderate') ? 'moderate' : 'unhealthy'}>
              <span class="aqi-val">{reading.aqi}</span>
              <span class="aqi-unit">AQI</span>
            </div>
            <div class="aqi-detail">
              <span class="aqi-cat-text">{reading.aqiCategory}</span>
              <span class="aqi-pm-text">PM2.5: {reading.pm25} µg/m³</span>
            </div>
          </div>
        </div>
      ))}
    </div>
  )}
</TopicDataCard>

<style>
  .aqi-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 0.65rem;
  }

  @media (max-width: 640px) {
    .aqi-grid {
      grid-template-columns: 1fr;
    }
  }

  .aqi-card {
    padding: 0.75rem;
    background-color: var(--color-surface-subtle, #f2ece0);
    border-radius: var(--radius-xs, 2px);
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
  }

  .aqi-header {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
  }

  .aqi-city {
    font-size: 0.85rem;
    font-weight: 700;
    color: var(--color-text-primary, #1e1b18);
  }

  .aqi-country {
    font-size: 0.68rem;
    color: var(--color-text-muted, #8a8275);
    text-transform: uppercase;
  }

  .aqi-readout {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }

  .aqi-score-box {
    padding: 0.25rem 0.5rem;
    border-radius: var(--radius-xs, 2px);
    display: flex;
    flex-direction: column;
    align-items: center;
    min-width: 48px;
  }

  .aqi-score-box[data-cat='good'] {
    background-color: #326952;
    color: #ffffff;
  }

  .aqi-score-box[data-cat='moderate'] {
    background-color: #b0854c;
    color: #ffffff;
  }

  .aqi-score-box[data-cat='unhealthy'] {
    background-color: #8f343d;
    color: #ffffff;
  }

  .aqi-val {
    font-family: var(--font-mono, monospace);
    font-size: 1.1rem;
    font-weight: 700;
    line-height: 1;
  }

  .aqi-unit {
    font-size: 0.6rem;
    font-weight: 600;
    text-transform: uppercase;
  }

  .aqi-detail {
    display: flex;
    flex-direction: column;
  }

  .aqi-cat-text {
    font-size: 0.78rem;
    font-weight: 600;
    color: var(--color-text-primary, #1e1b18);
  }

  .aqi-pm-text {
    font-size: 0.68rem;
    color: var(--color-text-muted, #8a8275);
  }
</style>
