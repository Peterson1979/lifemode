---
import type { FreshnessMetadata } from '../../lib/topic-data/types/core';

export interface Props {
  freshness: FreshnessMetadata;
  status?: string;
}

const { freshness, status = 'available' } = Astro.props;

const isUnavailable = status === 'unavailable' || freshness.status === 'expired';
const isStale = status === 'stale_available' || freshness.status === 'stale';
---

<div class={`freshness-badge ${isUnavailable ? 'badge-unavailable' : isStale ? 'badge-stale' : 'badge-fresh'}`}>
  <span class="freshness-dot" aria-hidden="true"></span>
  <span class="freshness-text">{freshness.label || (isUnavailable ? 'Temporarily unavailable' : 'Updated recently')}</span>
</div>

<style>
  .freshness-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    font-family: var(--font-sans);
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.02em;
    padding: 0.15rem 0.5rem;
    border-radius: var(--radius-full);
    border: 1px solid transparent;
  }

  .freshness-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    flex-shrink: 0;
  }

  /* Fresh state */
  .badge-fresh {
    background-color: rgba(50, 105, 82, 0.08);
    color: #23543f;
    border-color: rgba(50, 105, 82, 0.2);
  }
  .badge-fresh .freshness-dot {
    background-color: #326952;
  }

  /* Stale / Archived reference state */
  .badge-stale {
    background-color: rgba(176, 133, 76, 0.1);
    color: #8c622d;
    border-color: rgba(176, 133, 76, 0.25);
  }
  .badge-stale .freshness-dot {
    background-color: #b0854c;
  }

  /* Unavailable state */
  .badge-unavailable {
    background-color: rgba(143, 52, 61, 0.08);
    color: #8f343d;
    border-color: rgba(143, 52, 61, 0.2);
  }
  .badge-unavailable .freshness-dot {
    background-color: #8f343d;
  }
</style>
