---
export interface Props {
  author?: string | {
    name: string;
    role?: string;
    avatar?: string;
  };
  reviewedBy?: {
    name: string;
    role?: string;
    credentials?: string;
  };
  publishedDate?: string | Date;
  updatedDate?: string | Date;
  readTime?: string;
}

const {
  author,
  reviewedBy,
  publishedDate,
  updatedDate,
  readTime = '4 min read',
} = Astro.props;

const authorName = typeof author === 'string'
  ? author
  : (author?.name || 'LifeMode Editorial Team');

const authorRole = typeof author === 'object' && author?.role && author.role !== 'Editorial Staff' && author.role !== 'Practical Knowledge Researcher'
  ? author.role
  : undefined;

function formatDateStr(d: string | Date | undefined): string | null {
  if (!d) return null;
  if (d instanceof Date) {
    return d.toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' });
  }
  const parsed = new Date(d);
  if (!isNaN(parsed.getTime())) {
    return parsed.toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' });
  }
  return String(d);
}

const pubDateFormatted = formatDateStr(publishedDate);
const updatedDateFormatted = formatDateStr(updatedDate);
---

<div class="author-byline-bar">
  <div class="byline-primary">
    <div class="author-meta-item">
      <span class="byline-prefix">By</span>
      <span class="byline-author-name">{authorName}</span>
      {authorRole && <span class="byline-author-role">({authorRole})</span>}
    </div>

    {reviewedBy && (
      <div class="reviewer-meta-item">
        <span class="reviewer-divider" aria-hidden="true">•</span>
        <span class="verified-icon" title="Fact-Checked Editorial Standard">
          <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.8" stroke-linecap="round" stroke-linejoin="round">
            <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>
            <path d="m9 12 2 2 4-4"/>
          </svg>
        </span>
        <span class="reviewer-text">
          <span class="byline-prefix">Reviewed by</span>
          <strong>{reviewedBy.name}</strong>
          {reviewedBy.role && <span class="reviewer-role">({reviewedBy.role})</span>}
        </span>
      </div>
    )}
  </div>

  <div class="byline-secondary">
    {pubDateFormatted && (
      <span class="meta-date">
        <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect>
          <line x1="16" y1="2" x2="16" y2="6"></line>
          <line x1="8" y1="2" x2="8" y2="6"></line>
          <line x1="3" y1="10" x2="21" y2="10"></line>
        </svg>
        <span>{pubDateFormatted}</span>
      </span>
    )}

    {updatedDateFormatted && updatedDateFormatted !== pubDateFormatted && (
      <span class="meta-date updated">
        <span class="meta-dot" aria-hidden="true">•</span>
        <span>Updated {updatedDateFormatted}</span>
      </span>
    )}

    <span class="meta-read-time">
      <span class="meta-dot" aria-hidden="true">•</span>
      <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <circle cx="12" cy="12" r="10"></circle>
        <polyline points="12 6 12 12 16 14"></polyline>
      </svg>
      <span>{readTime}</span>
    </span>

    <span class="meta-policy">
      <span class="meta-dot" aria-hidden="true">•</span>
      <a href="/editorial-standards/" class="standards-link">Editorial Policy</a>
    </span>
  </div>
</div>

<style>
  .author-byline-bar {
    background-color: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    padding: var(--space-4) var(--space-5);
    margin: var(--space-4) 0 var(--space-6) 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    box-shadow: var(--shadow-sm);
  }

  .byline-primary {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: var(--space-2) var(--space-3);
    font-size: 0.875rem;
  }

  .author-meta-item {
    display: inline-flex;
    align-items: baseline;
    gap: 0.35rem;
  }

  .byline-prefix {
    color: var(--color-text-muted);
    font-size: 0.8rem;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    font-weight: 700;
  }

  .byline-author-name {
    font-family: var(--font-sans);
    font-weight: 700;
    color: var(--color-text-primary);
  }

  .byline-author-role,
  .reviewer-role {
    font-size: 0.8rem;
    color: var(--color-text-muted);
  }

  .reviewer-meta-item {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
  }

  .reviewer-divider,
  .meta-dot {
    color: var(--color-border-dark, #cbd5e1);
  }

  .verified-icon {
    color: #059669;
    display: inline-flex;
    align-items: center;
    justify-content: center;
  }

  .reviewer-text {
    display: inline-flex;
    align-items: baseline;
    gap: 0.35rem;
    color: var(--color-text-secondary);
  }

  .reviewer-text strong {
    color: var(--color-text-primary);
  }

  .byline-secondary {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: var(--space-2);
    font-size: 0.775rem;
    color: var(--color-text-muted);
    padding-top: var(--space-2);
    border-top: 1px solid var(--color-border-subtle);
  }

  .meta-date,
  .meta-read-time {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
  }

  .standards-link {
    color: var(--color-primary-accent);
    font-weight: 600;
    text-decoration: none;
    transition: color var(--transition-fast);
  }

  .standards-link:hover {
    text-decoration: underline;
  }
</style>
