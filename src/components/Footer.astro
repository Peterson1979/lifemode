---
import { SITE_CONFIG, PILLARS, type PillarSlug } from '../config/site';

const currentYear = new Date().getUTCFullYear();
---

<footer class="site-footer">
  <div class="container">
    <div class="footer-grid">
      <!-- Brand & Manifesto Column -->
      <div class="footer-brand">
        <h3 class="footer-logo">LifeMode</h3>
        <p class="footer-tagline">
          Practical guides, thoughtful tools, and clear ideas across technology, travel, personal finance, wellbeing, and everyday life.
        </p>
        <div class="footer-edition-badge">
          <span>ISSN 2026-LM &bull; Published Globally</span>
        </div>
      </div>

      <!-- Pillar Navigation -->
      <div class="footer-links-group">
        <h4>Explore Topics</h4>
        <ul>
          {SITE_CONFIG.navLinks.map((link) => {
            const pillar = PILLARS[link.slug as PillarSlug];
            return (
              <li>
                <a href={link.href}>
                  <span class="footer-dot" style={pillar ? `background-color: ${pillar.color}` : undefined}></span>
                  <span>{link.name}</span>
                </a>
              </li>
            );
          })}
        </ul>
      </div>

      <!-- Publication Links -->
      <div class="footer-links-group">
        <h4>Publication</h4>
        <ul>
          {SITE_CONFIG.footerLinks.map((link) => (
            <li>
              <a href={link.href}>{link.name}</a>
            </li>
          ))}
        </ul>
      </div>
    </div>

    <!-- Bottom Bar -->
    <div class="footer-bottom">
      <div>
        <span>&copy; {currentYear} {SITE_CONFIG.name}. All rights reserved.</span>
      </div>
      <div class="footer-bottom-meta">
        <span>Ideas for living well now</span>
      </div>
    </div>
  </div>
</footer>

<style>
  .footer-logo {
    font-family: var(--font-display);
    font-size: 1.85rem;
    font-weight: 700;
    color: #f8fafc;
    letter-spacing: -0.025em;
    margin-bottom: 0.75rem;
  }

  .footer-tagline {
    font-size: 0.925rem;
    color: #94a3b8;
    line-height: 1.65;
    max-width: 380px;
    margin-bottom: 1rem;
  }

  .footer-edition-badge {
    display: inline-block;
    font-family: var(--font-sans);
    font-size: 0.725rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: #38bdf8;
    padding: 0.35rem 0.75rem;
    background-color: rgba(56, 189, 248, 0.1);
    border: 1px solid rgba(56, 189, 248, 0.2);
    border-radius: var(--radius-full);
  }

  .footer-links-group h4 {
    font-family: var(--font-sans);
    font-size: 0.75rem;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: #f8fafc;
    margin-bottom: var(--space-4);
  }

  .footer-links-group ul {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0.55rem;
  }

  .footer-links-group a {
    font-size: 0.875rem;
    font-weight: 500;
    color: #94a3b8;
    transition: color var(--transition-fast), transform var(--transition-fast);
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
  }

  .footer-links-group a:hover {
    color: #ffffff;
    transform: translateX(2px);
  }

  .footer-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background-color: #94a3b8;
  }

  .footer-bottom-meta {
    color: #64748b;
  }
</style>
