---
import { SITE_CONFIG, PILLARS, type PillarSlug } from '../config/site';

const currentPath = Astro.url.pathname;

function isActive(href: string): boolean {
  if (href === '/') {
    return currentPath === '/';
  }
  return currentPath.startsWith(href);
}

const todayFormatted = new Intl.DateTimeFormat('en-US', {
  weekday: 'long',
  year: 'numeric',
  month: 'long',
  day: 'numeric',
  timeZone: 'UTC',
}).format(new Date());
---

<!-- Topbar -->
<div class="site-topbar">
  <div class="container site-topbar-inner">
    <div class="site-topbar-badge">
      <span class="site-topbar-pulse" aria-hidden="true"></span>
      <span>{todayFormatted}</span>
    </div>
    <span class="topbar-right">{SITE_CONFIG.slogan}</span>
  </div>
</div>

<!-- Main Sticky Header -->
<header class="site-header">
  <div class="container header-container">
    <!-- Brand Masthead with LifeMode Logo WebP -->
    <a href="/" class="brand-wrapper" aria-label="LifeMode Homepage">
      <img
        src="/assets/branding/lifemode-logo.webp"
        alt="LifeMode"
        class="brand-logo-img"
        width="300"
        height="84"
        loading="eager"
        decoding="async"
      />
    </a>

    <!-- Desktop Navigation -->
    <nav class="nav-desktop" aria-label="Primary Navigation">
      <ul class="nav-list">
        {SITE_CONFIG.navLinks.map((link) => {
          const active = isActive(link.href);
          const pillarConfig = PILLARS[link.slug as PillarSlug];
          return (
            <li>
              <a
                href={link.href}
                class={active ? 'active' : ''}
                style={pillarConfig ? `--nav-accent: ${pillarConfig.color}` : undefined}
              >
                {pillarConfig && <span class="nav-dot" style={`background-color: ${pillarConfig.color}`}></span>}
                <span>{link.name}</span>
              </a>
            </li>
          );
        })}
      </ul>
    </nav>

    <!-- Header Actions (Search Button + Mobile Menu) -->
    <div class="header-actions">
      <button id="open-search-btn" class="header-search-btn" aria-label="Search guides, tools, and recipes">
        <svg class="search-btn-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2">
          <circle cx="11" cy="11" r="8"/>
          <path d="m21 21-4.3-4.3"/>
        </svg>
        <span class="search-btn-label">Search</span>
        <kbd class="search-btn-kbd">⌘K</kbd>
      </button>

      <!-- Mobile Drawer -->
      <details class="mobile-nav-details">
        <summary class="mobile-nav-summary" aria-label="Toggle navigation menu">
          <span class="menu-icon-bar"></span>
          <span class="menu-icon-bar"></span>
          <span class="menu-icon-bar"></span>
        </summary>
        <div class="mobile-drawer-menu">
          <div class="mobile-drawer-header">
            <span class="mobile-drawer-title">Explore LifeMode</span>
          </div>
          <nav aria-label="Mobile Navigation">
            <ul class="mobile-nav-list">
              <li>
                <a href="/" class={`mobile-nav-link ${currentPath === '/' ? 'active' : ''}`}>
                  <span>Home</span>
                </a>
              </li>
              {SITE_CONFIG.navLinks.map((link) => {
                const active = isActive(link.href);
                const pillar = PILLARS[link.slug as PillarSlug];
                return (
                  <li>
                    <a
                      href={link.href}
                      class={`mobile-nav-link ${active ? 'active' : ''}`}
                    >
                      <span class="mobile-nav-dot" style={pillar ? `background-color: ${pillar.color}` : undefined}></span>
                      <span>{link.name}</span>
                    </a>
                  </li>
                );
              })}
            </ul>
          </nav>
        </div>
      </details>
    </div>
  </div>
</header>

<style>
  .topbar-right {
    color: #94a3b8;
    font-weight: 500;
  }

  .brand-wrapper {
    display: inline-flex;
    align-items: center;
    text-decoration: none;
    line-height: 1;
  }

  .brand-logo-img {
    height: 76px;
    width: auto;
    max-height: 80px;
    object-fit: contain;
    transition: opacity var(--transition-fast), transform var(--transition-fast);
  }

  .brand-wrapper:hover .brand-logo-img {
    opacity: 0.9;
    transform: translateY(-1px);
  }

  .nav-list {
    display: flex;
    align-items: center;
    list-style: none;
    gap: 0.25rem;
    margin: 0;
    padding: 0;
  }

  .nav-desktop a {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--color-text-secondary);
    padding: 0.4rem 0.6rem;
    border-radius: var(--radius-full);
    transition: color var(--transition-fast), background-color var(--transition-fast), box-shadow var(--transition-fast);
    white-space: nowrap;
  }

  .nav-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    flex-shrink: 0;
  }

  .nav-desktop a:hover {
    color: var(--color-text-primary);
    background-color: var(--color-surface-subtle);
  }

  .nav-desktop a.active {
    color: var(--color-text-primary);
    background-color: var(--color-surface-subtle);
    box-shadow: inset 0 0 0 1.5px var(--nav-accent, var(--color-primary-accent));
  }

  .header-actions {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }

  .header-search-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    padding: 0.45rem 0.75rem;
    border-radius: var(--radius-full);
    background-color: var(--color-surface-subtle);
    border: 1px solid var(--color-border);
    color: var(--color-text-muted);
    font-family: var(--font-sans);
    font-size: 0.8rem;
    font-weight: 600;
    cursor: pointer;
    transition: all var(--transition-fast);
  }

  .header-search-btn:hover {
    background-color: var(--color-surface-tint);
    border-color: var(--color-border-hover);
    color: var(--color-text-primary);
  }

  .search-btn-icon {
    flex-shrink: 0;
  }

  .search-btn-kbd {
    background-color: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: 4px;
    padding: 0.1rem 0.35rem;
    font-size: 0.675rem;
    font-family: var(--font-mono);
    color: var(--color-text-muted);
  }

  .mobile-nav-details {
    display: none;
    position: relative;
  }

  .mobile-nav-summary {
    list-style: none;
    cursor: pointer;
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 4px;
    padding: 0.55rem;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-sm);
    background-color: var(--color-surface);
    box-shadow: var(--shadow-sm);
    transition: all var(--transition-fast);
  }

  .mobile-nav-summary:hover {
    background-color: var(--color-surface-subtle);
    border-color: var(--color-border-hover);
  }

  .mobile-nav-summary::-webkit-details-marker {
    display: none;
  }

  .menu-icon-bar {
    width: 20px;
    height: 2px;
    background-color: var(--color-text-primary);
    border-radius: 1px;
  }

  .mobile-drawer-menu {
    position: absolute;
    top: calc(100% + 8px);
    right: 0;
    width: 260px;
    background-color: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    box-shadow: var(--shadow-elevated);
    padding: 1rem;
    z-index: 200;
  }

  .mobile-drawer-header {
    padding-bottom: 0.6rem;
    margin-bottom: 0.6rem;
    border-bottom: 1px solid var(--color-border-subtle);
  }

  .mobile-drawer-title {
    font-family: var(--font-sans);
    font-size: 0.725rem;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--color-text-muted);
  }

  .mobile-nav-list {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
  }

  .mobile-nav-link {
    display: flex;
    align-items: center;
    gap: 0.65rem;
    padding: 0.55rem 0.75rem;
    font-size: 0.875rem;
    font-weight: 600;
    color: var(--color-text-secondary);
    border-radius: var(--radius-sm);
    text-decoration: none;
    transition: background-color var(--transition-fast), color var(--transition-fast);
  }

  .mobile-nav-link:hover,
  .mobile-nav-link.active {
    background-color: var(--color-surface-subtle);
    color: var(--color-text-primary);
  }

  .mobile-nav-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background-color: var(--color-primary-accent);
  }

  @media (max-width: 1140px) {
    .nav-desktop {
      display: none;
    }
    .mobile-nav-details {
      display: block;
    }
  }

  @media (max-width: 640px) {
    .search-btn-label, .search-btn-kbd {
      display: none;
    }
    .header-search-btn {
      padding: 0.55rem;
    }
    .brand-logo-img {
      height: 60px;
      max-height: 64px;
    }
  }
</style>
