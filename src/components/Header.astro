---
import { SITE_CONFIG, PILLARS, type PillarSlug } from '../config/site';

const currentPath = Astro.url.pathname;

function isActive(href: string): boolean {
  if (href === '/') {
    return currentPath === '/';
  }
  return currentPath.startsWith(href);
}

const todayFormatted = new Intl.DateTimeFormat('en-US', {
  weekday: 'long',
  year: 'numeric',
  month: 'long',
  day: 'numeric',
  timeZone: 'UTC',
}).format(new Date());
---

<!-- Topbar -->
<div class="site-topbar">
  <div class="container site-topbar-inner">
    <span>Volume 2026 &bull; {todayFormatted}</span>
    <span class="topbar-right">A Journal of Contemporary Living &amp; Culture</span>
  </div>
</div>

<!-- Main Sticky Header -->
<header class="site-header">
  <div class="container header-container">
    <!-- Brand Masthead -->
    <a href="/" class="brand-wrapper" aria-label="LifeMode Homepage">
      <span class="brand-logo">LifeMode</span>
    </a>

    <!-- Desktop Navigation -->
    <nav class="nav-desktop" aria-label="Primary Navigation">
      {SITE_CONFIG.navLinks.map((link) => {
        const active = isActive(link.href);
        const pillarConfig = PILLARS[link.slug as PillarSlug];
        return (
          <li>
            <a
              href={link.href}
              class={active ? 'active' : ''}
              style={pillarConfig ? `--nav-accent: ${pillarConfig.color}` : undefined}
            >
              {link.name}
            </a>
          </li>
        );
      })}
    </nav>

    <!-- Mobile Drawer -->
    <details class="mobile-nav-details">
      <summary class="mobile-nav-summary" aria-label="Toggle navigation menu">
        <span class="menu-icon-bar"></span>
        <span class="menu-icon-bar"></span>
        <span class="menu-icon-bar"></span>
      </summary>
      <div class="mobile-drawer-menu">
        <div class="mobile-drawer-header">
          <span class="mobile-drawer-title">Editorial Pillars</span>
        </div>
        <nav aria-label="Mobile Navigation">
          <ul class="mobile-nav-list">
            <li>
              <a href="/" class={`mobile-nav-link ${currentPath === '/' ? 'active' : ''}`}>
                <span>Home</span>
              </a>
            </li>
            {SITE_CONFIG.navLinks.map((link) => {
              const active = isActive(link.href);
              const pillar = PILLARS[link.slug as PillarSlug];
              return (
                <li>
                  <a
                    href={link.href}
                    class={`mobile-nav-link ${active ? 'active' : ''}`}
                  >
                    <span class="mobile-nav-bullet" style={pillar ? `color: ${pillar.color}` : undefined}>&bull;</span>
                    <span>{link.name}</span>
                  </a>
                </li>
              );
            })}
          </ul>
        </nav>
      </div>
    </details>
  </div>
</header>

<style>
  .topbar-right {
    color: var(--color-text-muted);
    font-weight: 500;
  }

  .brand-logo {
    font-family: var(--font-display);
    font-size: 2.25rem;
    font-weight: 700;
    letter-spacing: -0.03em;
    color: var(--color-text-primary);
    text-decoration: none;
    transition: opacity var(--transition-fast);
  }

  .brand-logo:hover {
    opacity: 0.85;
  }

  .nav-desktop a {
    font-size: 0.775rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-text-secondary);
    padding: 0.45rem 0.65rem;
    border-radius: var(--radius-sm);
    transition: color var(--transition-fast), background-color var(--transition-fast);
  }

  .nav-desktop a:hover {
    color: var(--color-text-primary);
    background-color: var(--color-surface-subtle);
  }

  .nav-desktop a.active {
    color: var(--color-text-primary);
    background-color: var(--color-surface-subtle);
    border-bottom: 2px solid var(--nav-accent, var(--color-olive));
  }

  .mobile-nav-details {
    display: none;
    position: relative;
  }

  .mobile-nav-summary {
    list-style: none;
    cursor: pointer;
    display: flex;
    flex-direction: column;
    gap: 4px;
    padding: 0.5rem;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-sm);
    background-color: var(--color-surface);
  }

  .mobile-nav-summary::-webkit-details-marker {
    display: none;
  }

  .menu-icon-bar {
    width: 18px;
    height: 2px;
    background-color: var(--color-text-primary);
    border-radius: 1px;
  }

  .mobile-drawer-menu {
    position: absolute;
    top: calc(100% + 8px);
    right: 0;
    width: 240px;
    background-color: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    box-shadow: var(--shadow-elevated);
    padding: 1rem;
    z-index: 200;
  }

  .mobile-drawer-header {
    padding-bottom: 0.5rem;
    margin-bottom: 0.5rem;
    border-bottom: 1px solid var(--color-border-subtle);
  }

  .mobile-drawer-title {
    font-family: var(--font-sans);
    font-size: 0.725rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--color-text-muted);
  }

  .mobile-nav-list {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }

  .mobile-nav-link {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.5rem 0.75rem;
    font-size: 0.875rem;
    font-weight: 500;
    color: var(--color-text-secondary);
    border-radius: var(--radius-sm);
    text-decoration: none;
    transition: background-color var(--transition-fast), color var(--transition-fast);
  }

  .mobile-nav-link:hover,
  .mobile-nav-link.active {
    background-color: var(--color-surface-subtle);
    color: var(--color-text-primary);
  }

  .mobile-nav-bullet {
    font-size: 1.1em;
  }

  @media (max-width: 840px) {
    .mobile-nav-details {
      display: block;
    }
    .nav-desktop {
      display: none;
    }
  }
</style>
