---
---

<div class="tool-widget-container" id="cookware-finder-app">
  <div class="tool-controls-grid">
    <div class="tool-field">
      <label for="primary-cooking-select" class="field-label">1. Primary Cooking Style</label>
      <select id="primary-cooking-select" class="tool-select">
        <option value="high-heat-sear">High-Heat Searing & Steaks</option>
        <option value="everyday-versatile">Everyday All-Purpose (Eggs, Veggies, Sauces)</option>
        <option value="acidic-simmer">Acidic Sauces (Tomatoes, Wine, Lemon)</option>
        <option value="quick-stirfry">Fast High-Heat Stir-Frying (Wok / Sauté)</option>
        <option value="delicate-eggs">Delicate Non-Stick Only (Crepes, Eggs, Fish)</option>
      </select>
    </div>

    <div class="tool-field">
      <label for="maintenance-select" class="field-label">2. Maintenance Tolerance</label>
      <select id="maintenance-select" class="tool-select">
        <option value="low">Dishwasher Safe & Zero Seasoning (Low Maintenance)</option>
        <option value="medium">Hand Wash Only, No Seasoning Required (Medium)</option>
        <option value="enthusiast">Willing to Hand-Dry & Season for Lifetime Longevity</option>
      </select>
    </div>

    <div class="tool-field">
      <label for="weight-select" class="field-label">3. Weight & Handling</label>
      <select id="weight-select" class="tool-select">
        <option value="light">Lightweight & Easy to Maneuver</option>
        <option value="moderate">Moderate Balanced Weight</option>
        <option value="heavy">Heavy & High Thermal Mass</option>
      </select>
    </div>
  </div>

  <div class="cookware-recommendation-card" id="cookware-result">
    <!-- Rendered dynamically -->
  </div>
</div>

<script>
  interface CookwareProfile {
    material: string;
    headline: string;
    matchScore: string;
    bestFor: string;
    pros: string[];
    cons: string[];
    lifespan: string;
    careProtocol: string;
    chemistryInsight: string;
  }

  const COOKWARE_DATA: Record<string, CookwareProfile> = {
    'cast-iron': {
      material: 'Traditional Seasoned Cast Iron',
      headline: 'Unrivaled Thermal Retention & Naturally Non-Stick Lifetime Performer',
      matchScore: 'Top Match for High-Heat Searing & Lifetime Durability',
      bestFor: 'Steaks, burgers, deep frying, cornbread, Dutch oven braising, oven-to-stove cooking.',
      pros: [
        'Exceptional heat retention (does not cool down when cold meat hits the pan)',
        'Naturally non-stick when polymer seasoning develops',
        'Virtually indestructible (can last 100+ years and be restored easily)',
        'Zero toxic PFAS/PTFE chemical fumes even at 300°C+'
      ],
      cons: [
        'Heavy (can strain wrists; requires two hands to lift)',
        'Slow and uneven initial heating (requires 5-minute preheat)',
        'Reactive to long-simmering acidic tomato/wine sauces',
        'Never dishwasher safe'
      ],
      lifespan: '100+ Years (Generational Heirloom)',
      careProtocol: 'Wash with hot water & mild soap, dry immediately over stove heat, rub with microscopic drop of oil.',
      chemistryInsight: 'Seasoning is not grease—it is a cross-linked polymer matrix formed by polyunsaturated fats undergoing heat-induced polymerization bonding to microscopic pores in the iron.'
    },
    'stainless-steel': {
      material: 'Tri-Ply Clad Stainless Steel (18/10)',
      headline: 'The Professional Kitchen Workhorse for Sauces, Fond & Versatility',
      matchScore: 'Top Match for All-Purpose Cooking, Acid Resistance & Dishwasher Ease',
      bestFor: 'Pan sauces, acidic tomato reductions, searing, deglazing, sautéing vegetables, soups.',
      pros: [
        '100% non-reactive (cook any vinegar, citrus, or wine sauce safely)',
        'Dishwasher safe and extremely low maintenance',
        'Creates exquisite fond (browned bits) for pan sauces',
        'Rapid, uniform heat distribution across bottom and sidewalls'
      ],
      cons: [
        'Requires proper temperature control (the "Mercury Ball / Leidenfrost effect") to prevent food sticking',
        'Food will stick if added to a cold pan',
        'More expensive for high-grade multi-clad construction'
      ],
      lifespan: '20 to 50+ Years (Commercial Grade)',
      careProtocol: 'Dishwasher safe. Remove stubborn polymerized oil with Bar Keepers Friend (oxalic acid).',
      chemistryInsight: 'The chromium in 18/10 stainless steel forms an invisible, self-healing chromium oxide barrier preventing corrosion and food reactivity.'
    },
    'carbon-steel': {
      material: 'Carbon Steel (Blue / Black Steel)',
      headline: 'The Agility of Stainless with the Natural Non-Stick of Cast Iron',
      matchScore: 'Top Match for Stir-Frying, High-Heat Agility & Wok Cooking',
      bestFor: 'Wok stir-fries, omelets, searing, crepes, rapid heat response dishes.',
      pros: [
        'Half the weight of cast iron while holding high heat seasoning',
        'Blazing-fast responsiveness to flame and temperature changes',
        'Develops slick polymer patina with use',
        'Sloped restaurant-style ergonomic handles'
      ],
      cons: [
        'Prone to rust if left wet; requires hand-drying and seasoning',
        'Reactive to heavy acids like tomato paste or lemon sauces',
        'Can warp if subjected to extreme thermal shock (dunking hot pan in ice water)'
      ],
      lifespan: '30 to 50+ Years',
      careProtocol: 'Hand wash with sponge and hot water; dry instantly over burner flame.',
      chemistryInsight: 'Contains ~1-2% carbon alloyed with iron, yielding a malleable crystalline structure that can be stamped thin while retaining seasoning bonding properties.'
    },
    'ceramic-nonstick': {
      material: 'Ceramic / Reinforced Non-Stick (PTFE-Free)',
      headline: 'Effortless Clean-Up for Low-Fat Cooking and Delicate Eggs',
      matchScore: 'Top Match for Delicate Egg Cooking & Zero Maintenance',
      bestFor: 'French omelets, scrambled eggs, flaky delicate fish fillets, pancakes.',
      pros: [
        'Instant release with zero or minimal oil',
        'Extremely lightweight and easy to handle',
        'No pre-seasoning or maintenance required',
        'Easy rinse clean-up'
      ],
      cons: [
        'Short finite lifespan (coating degrades in 2–4 years regardless of brand)',
        'Cannot be used with metal utensils (will scratch coating)',
        'Cannot be heated dry over high heat (degrades non-stick surface)'
      ],
      lifespan: '2 to 4 Years',
      careProtocol: 'Hand wash with soft silicone sponge; use wooden or silicone utensils only.',
      chemistryInsight: 'Sol-gel ceramic coatings use silica nanoparticles to form a smooth inorganic glass-like release surface.'
    }
  };

  const cookSelect = document.getElementById('primary-cooking-select') as HTMLSelectElement;
  const maintSelect = document.getElementById('maintenance-select') as HTMLSelectElement;
  const weightSelect = document.getElementById('weight-select') as HTMLSelectElement;
  const resultContainer = document.getElementById('cookware-result');

  function calculateRecommendation() {
    if (!resultContainer || !cookSelect || !maintSelect || !weightSelect) return;

    const cooking = cookSelect.value;
    const maint = maintSelect.value;
    const weight = weightSelect.value;

    let selectedKey = 'stainless-steel';

    if (cooking === 'delicate-eggs') {
      selectedKey = 'ceramic-nonstick';
    } else if (cooking === 'high-heat-sear' && maint === 'enthusiast') {
      selectedKey = 'cast-iron';
    } else if (cooking === 'quick-stirfry' || (weight === 'light' && maint === 'enthusiast')) {
      selectedKey = 'carbon-steel';
    } else if (cooking === 'acidic-simmer' || maint === 'low') {
      selectedKey = 'stainless-steel';
    } else if (maint === 'enthusiast' && weight === 'heavy') {
      selectedKey = 'cast-iron';
    }

    const data = COOKWARE_DATA[selectedKey];

    resultContainer.innerHTML = `
      <div class="rec-header">
        <div class="rec-badge">${data.matchScore}</div>
        <h3 class="rec-material-title">${data.material}</h3>
        <p class="rec-headline">${data.headline}</p>
      </div>

      <div class="rec-best-use">
        <strong>🍳 Best Applications:</strong> ${data.bestFor}
      </div>

      <div class="pros-cons-grid">
        <div class="pros-box">
          <h4 class="box-title">✅ Advantages:</h4>
          <ul>
            ${data.pros.map(p => `<li>${p}</li>`).join('')}
          </ul>
        </div>
        <div class="cons-box">
          <h4 class="box-title">⚠️ Trade-Offs & Limitations:</h4>
          <ul>
            ${data.cons.map(c => `<li>${c}</li>`).join('')}
          </ul>
        </div>
      </div>

      <div class="rec-lifespan-row">
        <span class="lifespan-pill">⏳ Expected Lifespan: <strong>${data.lifespan}</strong></span>
        <span class="lifespan-pill">🧼 Care: <strong>${data.careProtocol}</strong></span>
      </div>

      <div class="material-science-box">
        <strong>🔬 Material Science Note:</strong> ${data.chemistryInsight}
      </div>
    `;
  }

  cookSelect?.addEventListener('change', calculateRecommendation);
  maintSelect?.addEventListener('change', calculateRecommendation);
  weightSelect?.addEventListener('change', calculateRecommendation);

  calculateRecommendation();
</script>

<style>
  .tool-widget-container {
    background-color: #ffffff;
    border: 1px solid var(--slate-200);
    border-radius: var(--radius-lg);
    padding: 1.75rem;
    box-shadow: var(--shadow-sm);
    margin: 2rem 0;
  }

  .tool-controls-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
    gap: 1.25rem;
    margin-bottom: 1.75rem;
    padding-bottom: 1.5rem;
    border-bottom: 1px solid var(--slate-200);
  }

  .tool-field {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .field-label {
    font-family: var(--font-heading);
    font-size: 0.88rem;
    font-weight: 700;
    color: var(--slate-800);
  }

  .tool-select {
    padding: 0.65rem 0.85rem;
    font-family: var(--font-body);
    font-size: 0.95rem;
    color: var(--slate-900);
    background-color: var(--slate-50);
    border: 1px solid var(--slate-300);
    border-radius: var(--radius-md);
    outline: none;
    cursor: pointer;
  }

  :global(.rec-header) {
    margin-bottom: 1.25rem;
  }

  :global(.rec-badge) {
    display: inline-block;
    font-size: 0.75rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--accent-blue);
    background-color: var(--accent-blue-light);
    border: 1px solid var(--accent-blue-border);
    padding: 0.2rem 0.6rem;
    border-radius: var(--radius-full);
    margin-bottom: 0.5rem;
  }

  :global(.rec-material-title) {
    font-size: 1.5rem;
    color: var(--slate-900);
    margin: 0 0 0.25rem 0;
  }

  :global(.rec-headline) {
    font-size: 1rem;
    color: var(--slate-600);
    margin: 0;
  }

  :global(.rec-best-use) {
    background-color: var(--slate-50);
    border: 1px solid var(--slate-200);
    border-radius: var(--radius-md);
    padding: 0.85rem 1.15rem;
    font-size: 0.95rem;
    color: var(--slate-800);
    margin-bottom: 1.25rem;
  }

  :global(.pros-cons-grid) {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
    gap: 1.25rem;
    margin-bottom: 1.25rem;
  }

  :global(.pros-box) {
    background-color: #f0fdf4;
    border: 1px solid #bbf7d0;
    border-radius: var(--radius-md);
    padding: 1.15rem;
  }

  :global(.cons-box) {
    background-color: #fffbeb;
    border: 1px solid #fde68a;
    border-radius: var(--radius-md);
    padding: 1.15rem;
  }

  :global(.box-title) {
    font-size: 0.95rem;
    margin-top: 0;
    margin-bottom: 0.5rem;
  }

  :global(.pros-box .box-title) { color: #166534; }
  :global(.cons-box .box-title) { color: #854d0e; }

  :global(.pros-box ul), :global(.cons-box ul) {
    padding-left: 1.15rem;
    margin: 0;
  }

  :global(.pros-box li) {
    font-size: 0.88rem;
    color: #14532d;
    margin-bottom: 0.35rem;
  }

  :global(.cons-box li) {
    font-size: 0.88rem;
    color: #713f12;
    margin-bottom: 0.35rem;
  }

  :global(.rec-lifespan-row) {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-bottom: 1.25rem;
  }

  :global(.lifespan-pill) {
    font-size: 0.82rem;
    color: var(--slate-700);
    background-color: var(--slate-100);
    padding: 0.35rem 0.75rem;
    border-radius: var(--radius-sm);
    border: 1px solid var(--slate-200);
  }

  :global(.material-science-box) {
    background-color: var(--slate-50);
    border-left: 3px solid var(--accent-purple);
    padding: 0.75rem 1rem;
    font-size: 0.88rem;
    color: var(--slate-700);
    border-radius: 0 var(--radius-sm) var(--radius-sm) 0;
  }
</style>
