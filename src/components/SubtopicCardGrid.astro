---
import type { SubtopicConfig } from '../config/site';

export interface Props {
  subtopics: SubtopicConfig[];
  pillarSlug?: string;
  pillarColor?: string;
  title?: string;
}

const { subtopics, pillarSlug, pillarColor = 'var(--color-primary-accent)', title } = Astro.props;
---

<div class="subtopics-wrapper">
  {title && (
    <div class="subtopics-header">
      <span class="subtopics-badge">Core Domains & Knowledge Clusters</span>
      <h2 class="subtopics-heading">{title}</h2>
    </div>
  )}

  <div class="subtopics-grid">
    {subtopics.map((subtopic) => {
      const targetUrl = subtopic.href || (pillarSlug ? `/${pillarSlug}` : '#');
      const isExternalOrDirect = Boolean(subtopic.href);

      return (
        <a
          href={targetUrl}
          class="subtopic-card"
          style={`--accent-color: ${pillarColor};`}
        >
          <div class="subtopic-icon-wrap" aria-hidden="true">
            <span class="subtopic-icon">{subtopic.icon}</span>
          </div>
          <div class="subtopic-content">
            <h3 class="subtopic-title">
              {subtopic.name}
              {isExternalOrDirect && <span class="subtopic-arrow" aria-hidden="true">&rarr;</span>}
            </h3>
            <p class="subtopic-description">{subtopic.description}</p>
          </div>
        </a>
      );
    })}
  </div>
</div>

<style>
  .subtopics-wrapper {
    margin-top: var(--space-4);
    margin-bottom: var(--space-8);
  }

  .subtopics-header {
    margin-bottom: var(--space-4);
  }

  .subtopics-badge {
    display: inline-block;
    font-family: var(--font-mono);
    font-size: 0.725rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--color-text-muted);
    margin-bottom: var(--space-1);
  }

  .subtopics-heading {
    font-family: var(--font-display);
    font-size: 1.35rem;
    font-weight: 700;
    color: var(--color-text-primary);
  }

  .subtopics-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
    gap: var(--space-4);
  }

  .subtopic-card {
    background-color: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    padding: 1.15rem 1.25rem;
    text-decoration: none;
    display: flex;
    align-items: flex-start;
    gap: var(--space-3);
    box-shadow: var(--shadow-sm);
    transition: transform var(--transition-fast), border-color var(--transition-fast), box-shadow var(--transition-fast);
    position: relative;
    overflow: hidden;
  }

  .subtopic-card::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    width: 3px;
    height: 100%;
    background-color: var(--accent-color, var(--color-primary-accent));
    opacity: 0;
    transition: opacity var(--transition-fast);
  }

  .subtopic-card:hover {
    transform: translateY(-2px);
    border-color: var(--color-border-hover);
    box-shadow: var(--shadow-card);
    text-decoration: none;
  }

  .subtopic-card:hover::before {
    opacity: 1;
  }

  .subtopic-card:focus-visible {
    outline: 2px solid var(--accent-color, var(--color-primary-accent));
    outline-offset: 2px;
  }

  .subtopic-icon-wrap {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 2.75rem;
    height: 2.75rem;
    border-radius: var(--radius-sm);
    background-color: var(--color-surface-subtle);
    flex-shrink: 0;
  }

  .subtopic-icon {
    font-size: 1.45rem;
    line-height: 1;
  }

  .subtopic-content {
    flex-grow: 1;
    min-width: 0;
  }

  .subtopic-title {
    font-family: var(--font-sans);
    font-size: 0.975rem;
    font-weight: 700;
    color: var(--color-text-primary);
    margin: 0 0 0.25rem 0;
    line-height: 1.3;
    display: flex;
    align-items: center;
    gap: 0.35rem;
  }

  .subtopic-arrow {
    font-size: 0.85rem;
    color: var(--accent-color, var(--color-primary-accent));
    opacity: 0.7;
    transition: transform var(--transition-fast), opacity var(--transition-fast);
  }

  .subtopic-card:hover .subtopic-arrow {
    transform: translateX(3px);
    opacity: 1;
  }

  .subtopic-description {
    font-size: 0.8125rem;
    color: var(--color-text-secondary);
    margin: 0;
    line-height: 1.45;
  }
</style>
