---
import type { EcosystemProject } from '../config/ecosystem';

export interface Props {
  project: EcosystemProject;
  compact?: boolean;
}

const { project, compact = false } = Astro.props;
---

<article class={`ecosystem-card ${compact ? 'ecosystem-card-compact' : ''}`}>
  <div class="ecosystem-header">
    <span class="ecosystem-kicker">Project</span>
    <span class="ecosystem-categories">
      {project.categories.slice(0, 2).join(' / ')}
    </span>
  </div>

  <h3 class="ecosystem-title">
    <a href={project.url} target="_blank" rel="noopener noreferrer" class="ecosystem-title-link">
      {project.name}
    </a>
  </h3>

  <p class="ecosystem-tagline">{project.tagline}</p>
  <p class="ecosystem-desc">{project.description}</p>

  <div class="ecosystem-footer">
    <a href={project.url} target="_blank" rel="noopener noreferrer" class="ecosystem-link">
      <span>{project.ctaText}</span>
      <span aria-hidden="true" class="link-arrow">&rarr;</span>
    </a>
  </div>
</article>

<style>
  .ecosystem-card {
    background-color: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-sm);
    padding: var(--space-6);
    display: flex;
    flex-direction: column;
    transition: border-color var(--transition-fast), transform var(--transition-fast);
  }

  .ecosystem-card:hover {
    border-color: var(--color-border-hover);
    transform: translateY(-2px);
  }

  .ecosystem-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: var(--space-3);
    font-size: 0.7rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.1em;
  }

  .ecosystem-kicker {
    color: var(--color-olive);
  }

  .ecosystem-categories {
    color: var(--color-text-muted);
  }

  .ecosystem-title {
    font-family: var(--font-display);
    font-size: 1.35rem;
    font-weight: 600;
    letter-spacing: -0.015em;
    margin-bottom: 0.25rem;
  }

  .ecosystem-title-link {
    color: var(--color-text-primary);
    text-decoration: none;
    transition: color var(--transition-fast);
  }

  .ecosystem-title-link:hover {
    color: var(--color-olive);
  }

  .ecosystem-tagline {
    font-family: var(--font-serif);
    font-size: 0.925rem;
    font-style: italic;
    color: var(--color-text-secondary);
    margin-bottom: var(--space-3);
    line-height: 1.4;
  }

  .ecosystem-desc {
    font-size: 0.875rem;
    color: var(--color-text-secondary);
    line-height: 1.6;
    margin-bottom: var(--space-5);
    flex-grow: 1;
  }

  .ecosystem-footer {
    margin-top: auto;
    padding-top: var(--space-3);
    border-top: 1px solid var(--color-border-subtle);
  }

  .ecosystem-link {
    font-family: var(--font-sans);
    font-size: 0.775rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--color-olive);
    text-decoration: none;
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    transition: gap var(--transition-fast), color var(--transition-fast);
  }

  .ecosystem-link:hover {
    color: var(--color-primary-hover);
    gap: 0.55rem;
  }

  .link-arrow {
    font-size: 1em;
  }

  /* Compact Variant */
  .ecosystem-card-compact {
    padding: var(--space-4);
  }

  .ecosystem-card-compact .ecosystem-title {
    font-size: 1.15rem;
  }

  .ecosystem-card-compact .ecosystem-desc {
    font-size: 0.825rem;
    margin-bottom: var(--space-3);
  }
</style>
