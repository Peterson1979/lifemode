---
import { getCollection } from 'astro:content';
import { getCategory } from '../utils/categories';
import { isPubliclyVisibleGuide, guideSlug } from '../utils/guides';
import { LIFE_HACK_VIDEOS } from '../utils/life-hacks';

export interface Props {
  currentCategory?: string;
  relatedGuides?: string[];
  relatedTools?: string[];
  relatedChecklists?: string[];
  relatedVideos?: string[];
  relatedEntries?: any[];
}

const {
  currentCategory = '',
  relatedGuides = [],
  relatedTools = [],
  relatedChecklists = [],
  relatedVideos = [],
  relatedEntries = [],
} = Astro.props;

const [allGuides, allTools, allChecklists] = await Promise.all([
  getCollection('guides', isPubliclyVisibleGuide).catch(() => []),
  getCollection('tools').catch(() => []),
  getCollection('checklists').catch(() => []),
]);

// Resolve valid matching items by slug/ID
const matchedGuides = relatedGuides
  .map((slug) => allGuides.find((g) => guideSlug(g.id) === slug))
  .filter((g): g is NonNullable<typeof g> => Boolean(g));

const matchedTools = relatedTools
  .map((slug) => allTools.find((t) => t.id.replace(/\.[^/.]+$/, '') === slug))
  .filter((t): t is NonNullable<typeof t> => Boolean(t));

const matchedChecklists = relatedChecklists
  .map((slug) => allChecklists.find((c) => c.id.replace(/\.[^/.]+$/, '') === slug))
  .filter((c): c is NonNullable<typeof c> => Boolean(c));

const matchedVideos = relatedVideos
  .map((id) => LIFE_HACK_VIDEOS.find((v) => v.id === id && !v.hidden))
  .filter((v): v is NonNullable<typeof v> => Boolean(v));

// Consolidate into structured recommendations, capped at 4 items, prioritizing format diversity
interface RecommendationItem {
  type: 'guide' | 'tool' | 'checklist' | 'video';
  title: string;
  desc: string;
  url: string;
  badge: string;
  action: string;
  target?: string;
  rel?: string;
}

const recommendations: RecommendationItem[] = [];

// Interleave across available types up to a maximum of 4 items
const maxPerType = Math.max(
  matchedGuides.length,
  matchedTools.length,
  matchedChecklists.length,
  matchedVideos.length,
  relatedEntries.length
);

for (let i = 0; i < maxPerType && recommendations.length < 4; i++) {
  if (i < matchedGuides.length && recommendations.length < 4) {
    const g = matchedGuides[i];
    recommendations.push({
      type: 'guide',
      title: g.data.title,
      desc: g.data.description || '',
      url: `/guides/${guideSlug(g.id)}/`,
      badge: '📖 Planning Guide',
      action: 'Read Guide →',
    });
  }
  if (i < matchedTools.length && recommendations.length < 4) {
    const t = matchedTools[i];
    recommendations.push({
      type: 'tool',
      title: t.data.title,
      desc: t.data.summary,
      url: `/tools/${t.id.replace(/\.[^/.]+$/, '')}/`,
      badge: '🛠️ Interactive Tool',
      action: 'Use Tool →',
    });
  }
  if (i < matchedChecklists.length && recommendations.length < 4) {
    const c = matchedChecklists[i];
    recommendations.push({
      type: 'checklist',
      title: c.data.title,
      desc: c.data.summary,
      url: `/checklists/${c.id.replace(/\.[^/.]+$/, '')}/`,
      badge: '📋 Checklist & Printable',
      action: 'View Checklist →',
    });
  }
  if (i < matchedVideos.length && recommendations.length < 4) {
    const v = matchedVideos[i];
    recommendations.push({
      type: 'video',
      title: v.title,
      desc: v.description,
      url: `/life-hacks/#video-${v.id}`,
      badge: '🎬 Video Demonstration',
      action: 'Watch Video →',
    });
  }
}

// Append legacy entries if space permits
for (const e of relatedEntries) {
  if (recommendations.length >= 4) break;
  recommendations.push({
    type: 'guide',
    title: e.data.title,
    desc: e.data.description || e.data.quickSummary || '',
    url: `/${e.collection || currentCategory}/${e.id.replace(/\.[^/.]+$/, '')}/`,
    badge: '📄 Practical Guide',
    action: 'Read Guide →',
  });
}

const categoryMeta = currentCategory ? getCategory(currentCategory) : undefined;
const hasContent = recommendations.length > 0;
---

{hasContent && (
  <aside class="related-cluster-container no-print" aria-labelledby="cluster-resources-heading">
    <div class="cluster-header">
      <span class="cluster-badge">Connected Knowledge</span>
      <h3 id="cluster-resources-heading" class="cluster-title">Related Practical Resources</h3>
      <p class="cluster-sub">
        Explore vetted companion guides, interactive calculators, checklists, and video demonstrations
        {categoryMeta ? ` in ${categoryMeta.title}` : ''}:
      </p>
    </div>

    <div class="cluster-grid">
      {recommendations.map((item) => (
        <a
          href={item.url}
          class={`cluster-card ${item.type}-card`}
          target={item.target}
          rel={item.rel}
        >
          <div class="card-icon-badge">{item.badge}</div>
          <h4 class="card-item-title">{item.title}</h4>
          <p class="card-item-desc">{item.desc}</p>
          <span class="card-action">{item.action}</span>
        </a>
      ))}
    </div>

    {categoryMeta && (
      <div class="cluster-footer">
        <a href={`/${categoryMeta.slug}/`} class="category-hub-link">
          Browse the complete <strong>{categoryMeta.title}</strong> editorial hub &rarr;
        </a>
      </div>
    )}
  </aside>
)}

<style>
  .related-cluster-container {
    background: linear-gradient(180deg, var(--color-surface, #ffffff) 0%, var(--color-surface-subtle, #f8fafc) 100%);
    border: 1px solid var(--color-border, #e2e8f0);
    border-radius: var(--radius-lg, 12px);
    padding: 2rem;
    margin: 3.5rem 0 2rem 0;
    box-shadow: var(--shadow-sm);
  }

  .cluster-header {
    margin-bottom: 1.5rem;
  }

  .cluster-badge {
    font-size: 0.72rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--color-primary-accent, #2563eb);
    background-color: rgba(37, 99, 235, 0.08);
    border: 1px solid rgba(37, 99, 235, 0.2);
    padding: 0.25rem 0.65rem;
    border-radius: var(--radius-full, 9999px);
    display: inline-block;
    margin-bottom: 0.5rem;
  }

  .cluster-title {
    font-family: var(--font-display, var(--font-heading, sans-serif));
    font-size: 1.45rem;
    font-weight: 700;
    color: var(--color-text-primary, #0f172a);
    margin-top: 0.25rem;
    margin-bottom: 0.35rem;
  }

  .cluster-sub {
    font-size: 0.95rem;
    color: var(--color-text-secondary, #475569);
    margin: 0;
    line-height: 1.5;
  }

  .cluster-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
    gap: 1.25rem;
    margin-bottom: 1.5rem;
  }

  .cluster-card {
    background-color: var(--color-surface, #ffffff);
    border: 1px solid var(--color-border, #e2e8f0);
    border-radius: var(--radius-md, 8px);
    padding: 1.25rem;
    display: flex;
    flex-direction: column;
    text-decoration: none;
    transition: all var(--transition-fast, 0.15s ease);
    position: relative;
  }

  .cluster-card:hover {
    transform: translateY(-2px);
    box-shadow: var(--shadow-md);
    border-color: var(--color-border-hover, #cbd5e1);
    text-decoration: none;
  }

  .guide-card {
    border-top: 3px solid #7c3aed;
  }

  .tool-card {
    border-top: 3px solid #2563eb;
  }

  .checklist-card {
    border-top: 3px solid #059669;
  }

  .video-card {
    border-top: 3px solid #0891b2;
  }

  .card-icon-badge {
    font-size: 0.75rem;
    font-weight: 700;
    color: var(--color-text-muted, #64748b);
    margin-bottom: 0.5rem;
  }

  .card-item-title {
    font-family: var(--font-display, var(--font-sans, sans-serif));
    font-size: 1.05rem;
    font-weight: 700;
    color: var(--color-text-primary, #0f172a);
    margin-top: 0;
    margin-bottom: 0.4rem;
    line-height: 1.35;
  }

  .card-item-desc {
    font-size: 0.85rem;
    color: var(--color-text-secondary, #475569);
    line-height: 1.45;
    margin-bottom: 1rem;
    flex-grow: 1;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .card-action {
    font-size: 0.825rem;
    font-weight: 700;
    color: var(--color-primary-accent, #2563eb);
    display: inline-flex;
    align-items: center;
    gap: 0.25rem;
  }

  .cluster-card:hover .card-action {
    text-decoration: underline;
  }

  .cluster-footer {
    border-top: 1px solid var(--color-border-subtle, #e2e8f0);
    padding-top: 1.25rem;
    text-align: center;
  }

  .category-hub-link {
    font-size: 0.925rem;
    color: var(--color-text-secondary, #475569);
    font-weight: 600;
    text-decoration: none;
    transition: color var(--transition-fast, 0.15s ease);
  }

  .category-hub-link:hover {
    color: var(--color-primary-accent, #2563eb);
    text-decoration: underline;
  }
</style>
