---
export interface Props {
  variant?: 'takeaway' | 'tip' | 'important' | 'warning' | 'expert' | 'why-it-matters';
  title?: string;
  kicker?: string;
}

const {
  variant = 'takeaway',
  title,
  kicker
} = Astro.props;

const defaultKickers: Record<string, string> = {
  'takeaway': 'Key Takeaway',
  'tip': 'Practical Tip',
  'important': 'Important Protocol Note',
  'warning': 'Caution / Watch Out',
  'expert': 'Expert Insight',
  'why-it-matters': 'Why It Matters',
};

const displayKicker = kicker || defaultKickers[variant] || 'Editorial Note';
---

<aside class={`editorial-callout callout-${variant}`} role="note">
  <div class="callout-header">
    {variant === 'takeaway' && (
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <polyline points="20 6 9 17 4 12"></polyline>
      </svg>
    )}
    {variant === 'tip' && (
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <circle cx="12" cy="12" r="10"></circle>
        <line x1="12" y1="16" x2="12" y2="12"></line>
        <line x1="12" y1="8" x2="12.01" y2="8"></line>
      </svg>
    )}
    {variant === 'important' && (
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <circle cx="12" cy="12" r="10"></circle>
        <line x1="12" y1="8" x2="12" y2="12"></line>
        <line x1="12" y1="16" x2="12.01" y2="16"></line>
      </svg>
    )}
    {variant === 'warning' && (
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="M10.29 3.86L1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z"></path>
        <line x1="12" y1="9" x2="12" y2="13"></line>
        <line x1="12" y1="17" x2="12.01" y2="17"></line>
      </svg>
    )}
    {variant === 'expert' && (
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path>
        <circle cx="12" cy="7" r="4"></circle>
      </svg>
    )}
    {variant === 'why-it-matters' && (
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <circle cx="12" cy="12" r="10"></circle>
        <line x1="12" y1="16" x2="12" y2="12"></line>
        <line x1="12" y1="8" x2="12.01" y2="8"></line>
      </svg>
    )}
    <span>{displayKicker}</span>
  </div>
  {title && <h4 class="callout-title">{title}</h4>}
  <div class="callout-body">
    <slot />
  </div>
</aside>

<style>
  .callout-title {
    font-family: var(--font-display);
    font-size: 1.05rem;
    font-weight: 700;
    color: var(--color-text-primary);
    margin: var(--space-1) 0 var(--space-2) 0;
  }
</style>
