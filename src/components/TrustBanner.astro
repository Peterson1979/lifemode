<section class="trust-banner-section" aria-label="Editorial Standards and Trust">
  <div class="container trust-banner-inner">
    <div class="trust-banner-col">
      <div class="trust-shield-icon">🛡️</div>
      <h3 class="trust-col-title">Evidence-Based &amp; Fact-Checked</h3>
      <p class="trust-col-desc">Practical guides and decision protocols reference agricultural extension data, verified testing standards, and manufacturer guidelines.</p>
    </div>
    <div class="trust-banner-col">
      <div class="trust-shield-icon">🚫</div>
      <h3 class="trust-col-title">Zero AI Search Farm Content</h3>
      <p class="trust-col-desc">No generic fluff, fabricated tips, or unverified claims. High-density, practical reference instructions tested for real-world execution.</p>
    </div>
    <div class="trust-banner-col">
      <div class="trust-shield-icon">⚡</div>
      <h3 class="trust-col-title">Fast, Static &amp; Privacy-First</h3>
      <p class="trust-col-desc">Zero intrusive trackers, zero account walls. Pure high-speed static architecture engineered for instant answer discovery.</p>
    </div>
  </div>
</section>

<style>
  .trust-banner-section {
    background: linear-gradient(180deg, var(--color-surface) 0%, var(--color-surface-subtle) 100%);
    border-top: 1px solid var(--color-border);
    border-bottom: 1px solid var(--color-border);
    padding: var(--space-12) 0;
    margin-top: var(--space-12);
  }

  .trust-banner-inner {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: var(--space-8);
  }

  .trust-banner-col {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
  }

  .trust-shield-icon {
    font-size: 2rem;
    line-height: 1;
    margin-bottom: var(--space-3);
  }

  .trust-col-title {
    font-family: var(--font-display);
    font-size: 1.15rem;
    font-weight: 700;
    color: var(--color-text-primary);
    margin: 0 0 var(--space-2) 0;
  }

  .trust-col-desc {
    font-size: 0.875rem;
    color: var(--color-text-secondary);
    line-height: 1.6;
    margin: 0;
  }
</style>
