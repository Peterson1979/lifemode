---
import type { CuratedProduct } from '../lib/commerce/types';

export interface Props {
  products: CuratedProduct[];
  title?: string;
  kicker?: string;
  subtitle?: string;
}

const {
  products = [],
  title = 'Featured Daily Ideas Store Picks',
  kicker = 'Daily Ideas Store',
  subtitle = 'Curated home, kitchen, style and self-care finds you can actually use every day.',
} = Astro.props;

if (!products || products.length === 0) {
  return null;
}
---

<section class="daily-ideas-section" aria-label="Daily Ideas Store Recommendations">
  <div class="daily-ideas-card">
    <header class="daily-ideas-header">
      <div class="daily-ideas-kicker-row">
        <span class="daily-ideas-badge">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M6 2 3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4Z"/>
            <path d="M3 6h18"/>
            <path d="M16 10a4 4 0 0 1-8 0"/>
          </svg>
          {kicker}
        </span>
        <span class="kicker-dot" aria-hidden="true">&bull;</span>
        <span class="daily-ideas-editorial-label">Curated Recommendations</span>
      </div>
      <h3 class="daily-ideas-title">{title}</h3>
      <p class="daily-ideas-subtitle">{subtitle}</p>
    </header>

    <div class="daily-ideas-grid">
      {products.map((product) => (
        <article class="daily-ideas-item">
          <div class="item-header">
            {product.badge && <span class="item-badge">{product.badge}</span>}
            {product.brand && <span class="item-brand">{product.brand}</span>}
          </div>

          <h4 class="item-name">{product.name}</h4>
          <p class="item-desc">{product.description}</p>

          <div class="item-editorial-box">
            <span class="editorial-box-label">Why Editors Recommend It:</span>
            <p class="editorial-box-note">{product.editorialNote}</p>
          </div>

          <div class="item-footer">
            {product.priceRange && (
              <div class="item-price">
                <span class="price-label">Typical Range</span>
                <span class="price-val">{product.priceRange}</span>
              </div>
            )}
            <a
              href={product.affiliateUrl}
              target="_blank"
              rel="nofollow noopener sponsored"
              class="btn-amazon"
              aria-label={`View ${product.name} on Amazon (opens in a new tab)`}
            >
              <span>View on Amazon</span>
              <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"></path>
                <polyline points="15 3 21 3 21 9"></polyline>
                <line x1="10" y1="14" x2="21" y2="3"></line>
              </svg>
            </a>
          </div>
        </article>
      ))}
    </div>

    <footer class="daily-ideas-footer">
      <p class="affiliate-disclosure">
        <strong>Editorial Transparency:</strong> When you buy through curated links on LifeMode, we may earn an affiliate commission at no extra cost to you. We only recommend products tested, vetted, or aligned with our practical standards.
      </p>
    </footer>
  </div>
</section>

<style>
  .daily-ideas-section {
    margin: var(--space-10) 0;
  }

  .daily-ideas-card {
    background: linear-gradient(180deg, var(--color-surface) 0%, var(--color-surface-subtle) 100%);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-xl);
    padding: var(--space-6);
    box-shadow: var(--shadow-sm);
    position: relative;
    overflow: hidden;
  }

  .daily-ideas-card::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 3px;
    background: linear-gradient(90deg, #ea580c 0%, #f59e0b 100%);
  }

  .daily-ideas-header {
    margin-bottom: var(--space-6);
    padding-bottom: var(--space-4);
    border-bottom: 1px solid var(--color-border-subtle);
  }

  .daily-ideas-kicker-row {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    margin-bottom: var(--space-2);
    flex-wrap: wrap;
  }

  .daily-ideas-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    font-family: var(--font-sans);
    font-size: 0.725rem;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: #ea580c;
    background-color: rgba(234, 88, 12, 0.08);
    border: 1px solid rgba(234, 88, 12, 0.2);
    padding: 0.2rem 0.6rem;
    border-radius: var(--radius-full);
  }

  .kicker-dot {
    color: var(--color-text-dim);
  }

  .daily-ideas-editorial-label {
    font-family: var(--font-sans);
    font-size: 0.7rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--color-text-muted);
  }

  .daily-ideas-title {
    font-family: var(--font-display);
    font-size: 1.35rem;
    font-weight: 700;
    color: var(--color-text-primary);
    line-height: 1.25;
    margin: 0 0 var(--space-1) 0;
  }

  .daily-ideas-subtitle {
    font-size: 0.925rem;
    color: var(--color-text-secondary);
    line-height: 1.5;
    margin: 0;
  }

  .daily-ideas-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: var(--space-5);
  }

  .daily-ideas-item {
    background-color: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    padding: var(--space-5);
    display: flex;
    flex-direction: column;
    box-shadow: var(--shadow-sm);
    transition: transform var(--transition-fast), border-color var(--transition-fast), box-shadow var(--transition-fast);
  }

  .daily-ideas-item:hover {
    transform: translateY(-2px);
    border-color: var(--color-border-hover);
    box-shadow: var(--shadow-md);
  }

  .item-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: var(--space-2);
    margin-bottom: var(--space-2);
    flex-wrap: wrap;
  }

  .item-badge {
    font-family: var(--font-mono);
    font-size: 0.675rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    padding: 0.15rem 0.5rem;
    background-color: rgba(234, 88, 12, 0.1);
    color: #c2410c;
    border-radius: var(--radius-sm);
  }

  .item-brand {
    font-size: 0.75rem;
    font-weight: 700;
    color: var(--color-text-muted);
    text-transform: uppercase;
    letter-spacing: 0.06em;
  }

  .item-name {
    font-family: var(--font-display);
    font-size: 1.1rem;
    font-weight: 700;
    color: var(--color-text-primary);
    line-height: 1.3;
    margin: 0 0 var(--space-2) 0;
  }

  .item-desc {
    font-size: 0.85rem;
    color: var(--color-text-secondary);
    line-height: 1.45;
    margin-bottom: var(--space-3);
  }

  .item-editorial-box {
    background-color: var(--color-surface-subtle);
    border-left: 3px solid #ea580c;
    border-radius: 0 var(--radius-sm) var(--radius-sm) 0;
    padding: var(--space-3);
    margin-bottom: var(--space-4);
    margin-top: auto;
  }

  .editorial-box-label {
    display: block;
    font-size: 0.65rem;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: #ea580c;
    margin-bottom: 0.2rem;
  }

  .editorial-box-note {
    font-size: 0.8rem;
    color: var(--color-text-primary);
    line-height: 1.4;
    margin: 0;
  }

  .item-footer {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: var(--space-3);
    padding-top: var(--space-3);
    border-top: 1px solid var(--color-border-subtle);
  }

  .item-price {
    display: flex;
    flex-direction: column;
  }

  .price-label {
    font-size: 0.65rem;
    color: var(--color-text-muted);
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }

  .price-val {
    font-family: var(--font-mono);
    font-size: 0.9rem;
    font-weight: 700;
    color: var(--color-text-primary);
  }

  .btn-amazon {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    background-color: #0f172a;
    color: #ffffff;
    font-family: var(--font-sans);
    font-size: 0.8rem;
    font-weight: 700;
    padding: 0.4rem 0.85rem;
    border-radius: var(--radius-md);
    text-decoration: none;
    transition: all var(--transition-fast);
  }

  .btn-amazon:hover {
    background-color: #ea580c;
    color: #ffffff;
    text-decoration: none;
    transform: translateY(-1px);
  }

  .daily-ideas-footer {
    margin-top: var(--space-6);
    padding-top: var(--space-3);
    border-top: 1px solid var(--color-border-subtle);
  }

  .affiliate-disclosure {
    font-size: 0.725rem;
    color: var(--color-text-muted);
    line-height: 1.45;
    margin: 0;
  }
</style>
