---
import { formatDate, toISODate } from '../utils/date';
import PillarBadge from './PillarBadge.astro';
import { PILLARS, type PillarSlug } from '../config/site';

export interface Props {
  pillar: PillarSlug | string;
  slug: string;
  title: string;
  description: string;
  pubDate: Date | string;
  author?: string;
  image?: string;
  imageAlt?: string;
  readingTime?: string;
  format?: string;
  tags?: string[];
  variant?: 'lead' | 'card' | 'compact' | 'horizontal';
  featured?: boolean;
}

const {
  pillar,
  slug,
  title,
  description,
  pubDate,
  author = 'LifeMode Editorial',
  image,
  imageAlt,
  readingTime,
  format = 'standard',
  variant = 'card',
  featured = false,
} = Astro.props;

const articleUrl = `/${pillar}/${slug}`;
const formattedDate = formatDate(pubDate);
const isoDate = toISODate(pubDate);

const pillarConfig = PILLARS[pillar as PillarSlug] || {
  name: pillar,
  slug: pillar,
  color: 'var(--color-olive)',
  bgLight: 'rgba(72, 92, 75, 0.08)',
};

const displayReadingTime = readingTime || `${Math.max(3, Math.ceil((description?.length || 100) / 45))} min read`;
const showFormat = format && format !== 'standard';
---

<article class={`story-preview story-${variant} ${featured ? 'story-featured' : ''}`}>
  <!-- Media / Image Container -->
  {variant !== 'compact' && (
    <a href={articleUrl} class="story-media" aria-label={title} tabindex="-1">
      {image ? (
        <img
          src={image}
          alt={imageAlt || title}
          loading={variant === 'lead' ? 'eager' : 'lazy'}
          class="story-img"
        />
      ) : (
        <div class="story-fallback" style={`--fallback-color: ${pillarConfig.color};`}>
          <div class="fallback-inner">
            <span class="fallback-monogram">LM</span>
            <span class="fallback-pillar">{pillarConfig.name}</span>
          </div>
        </div>
      )}
    </a>
  )}

  <!-- Story Content -->
  <div class="story-content">
    <div class="story-kicker-row">
      <PillarBadge pillar={pillar} size={variant === 'lead' ? 'sm' : 'xs'} />
      {showFormat && (
        <span class="story-format-tag">{format.replace('-', ' ')}</span>
      )}
    </div>

    <h3 class="story-title">
      <a href={articleUrl} class="story-title-link">{title}</a>
    </h3>

    {description && (
      <p class="story-description">{description}</p>
    )}

    <div class="story-meta">
      <time datetime={isoDate} class="meta-date">{formattedDate}</time>
      <span class="meta-sep">&bull;</span>
      <span class="meta-read-time">{displayReadingTime}</span>
      {author && variant === 'lead' && (
        <>
          <span class="meta-sep">&bull;</span>
          <span class="meta-author">By {author}</span>
        </>
      )}
    </div>
  </div>
</article>

<style>
  .story-preview {
    display: flex;
    flex-direction: column;
    position: relative;
    transition: opacity var(--transition-fast);
  }

  /* Media Container */
  .story-media {
    position: relative;
    width: 100%;
    aspect-ratio: 16 / 10;
    overflow: hidden;
    background-color: var(--color-surface-subtle);
    border-radius: var(--radius-sm);
    display: block;
    margin-bottom: var(--space-4);
    text-decoration: none;
  }

  .story-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.6s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .story-preview:hover .story-img {
    transform: scale(1.03);
  }

  /* Restrained Quiet Fallback Canvas */
  .story-fallback {
    width: 100%;
    height: 100%;
    background-color: var(--color-surface-subtle);
    border: 1px solid var(--color-border);
    display: flex;
    align-items: center;
    justify-content: center;
    transition: background-color var(--transition-fast);
  }

  .story-preview:hover .story-fallback {
    background-color: var(--color-surface-tint);
  }

  .fallback-inner {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.25rem;
    opacity: 0.6;
  }

  .fallback-monogram {
    font-family: var(--font-display);
    font-size: 2rem;
    font-weight: 700;
    font-style: italic;
    color: var(--color-text-muted);
    line-height: 1;
  }

  .fallback-pillar {
    font-family: var(--font-sans);
    font-size: 0.65rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--color-text-muted);
  }

  /* Story Content */
  .story-content {
    display: flex;
    flex-direction: column;
    flex-grow: 1;
  }

  .story-kicker-row {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin-bottom: 0.5rem;
    flex-wrap: wrap;
  }

  .story-format-tag {
    font-family: var(--font-sans);
    font-size: 0.65rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--color-olive);
    padding: 0.15rem 0.4rem;
    background-color: var(--color-olive-tint);
    border-radius: var(--radius-xs);
  }

  .story-title {
    font-family: var(--font-display);
    font-size: 1.35rem;
    font-weight: 600;
    line-height: 1.25;
    letter-spacing: -0.015em;
    margin-bottom: 0.65rem;
  }

  .story-title-link {
    color: var(--color-text-primary);
    text-decoration: none;
    transition: color var(--transition-fast);
  }

  .story-title-link:hover {
    color: var(--color-olive);
  }

  .story-description {
    font-size: 0.925rem;
    color: var(--color-text-secondary);
    line-height: 1.6;
    margin-bottom: 0.85rem;
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .story-meta {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    font-family: var(--font-sans);
    font-size: 0.775rem;
    color: var(--color-text-muted);
    margin-top: auto;
  }

  .meta-sep {
    color: var(--color-text-dim);
  }

  /* Lead Variant */
  .story-lead {
    display: flex;
    flex-direction: column;
  }

  .story-lead .story-media {
    aspect-ratio: 16 / 9;
    margin-bottom: var(--space-6);
  }

  .story-lead .story-title {
    font-size: clamp(1.85rem, 3.5vw, 2.6rem);
    line-height: 1.15;
    letter-spacing: -0.02em;
    margin-bottom: 0.85rem;
  }

  .story-lead .story-description {
    font-size: 1.1rem;
    line-height: 1.65;
    color: var(--color-text-secondary);
    max-width: 740px;
    -webkit-line-clamp: 4;
    margin-bottom: 1rem;
  }

  /* Horizontal Variant */
  .story-horizontal {
    flex-direction: row;
    gap: var(--space-6);
    align-items: flex-start;
    padding-bottom: var(--space-6);
    border-bottom: 1px solid var(--color-border-subtle);
  }

  .story-horizontal .story-media {
    width: 38%;
    aspect-ratio: 4 / 3;
    margin-bottom: 0;
    flex-shrink: 0;
  }

  .story-horizontal .story-content {
    width: 62%;
  }

  .story-horizontal .story-title {
    font-size: 1.15rem;
    margin-bottom: 0.45rem;
  }

  .story-horizontal .story-description {
    font-size: 0.875rem;
    -webkit-line-clamp: 2;
    margin-bottom: 0.65rem;
  }

  /* Compact Variant */
  .story-compact {
    padding-bottom: var(--space-5);
    border-bottom: 1px solid var(--color-border-subtle);
  }

  .story-compact .story-title {
    font-size: 1.05rem;
    margin-bottom: 0.35rem;
  }

  .story-compact .story-description {
    font-size: 0.85rem;
    -webkit-line-clamp: 2;
    margin-bottom: 0.5rem;
  }

  @media (max-width: 768px) {
    .story-horizontal {
      flex-direction: column;
      gap: 0;
    }
    .story-horizontal .story-media {
      width: 100%;
      aspect-ratio: 16 / 10;
      margin-bottom: var(--space-4);
    }
    .story-horizontal .story-content {
      width: 100%;
    }
  }
</style>
