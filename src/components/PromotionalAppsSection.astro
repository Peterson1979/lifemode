---
import { OWNED_PROJECTS } from '../lib/projects/config';

export interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'Apps & Tools',
  description = 'Helpful tools and interactive experiences built by our team.',
} = Astro.props;
---

<section class="promotional-apps-section" id="apps-and-tools" aria-labelledby="promotional-apps-heading">
  <div class="container">
    <div class="section-header">
      <div>
        <h2 id="promotional-apps-heading" class="section-title">{title}</h2>
        <p class="section-desc">{description}</p>
      </div>
    </div>

    <div class="promotional-apps-grid">
      {OWNED_PROJECTS.map((app) => (
        <article class="promotional-app-card" id={`app-card-${app.id}`}>
          <div class="app-card-top-row">
            <div class="app-icon-wrap">
              <img
                src={app.logoUrl}
                alt={`${app.name} Icon`}
                class="app-icon-img"
                width="60"
                height="60"
                loading="lazy"
              />
            </div>
            <div class="app-badge-col">
              <span class="app-category-badge">{app.categories[0] || 'Application'}</span>
              <span class="app-badge-owned">Featured App</span>
            </div>
          </div>

          <h3 class="app-card-title">
            <a href={app.url} target="_blank" rel="noopener noreferrer" class="app-title-link">
              {app.name}
            </a>
          </h3>

          <p class="app-card-subtitle">{app.tagline}</p>
          <p class="app-card-description">{app.description}</p>

          <div class="app-card-footer">
            <a
              href={app.url}
              target="_blank"
              rel="noopener noreferrer"
              class="btn-promotional-cta"
              aria-label={`${app.ctaLabel} (opens in a new tab)`}
            >
              <span>{app.ctaLabel}</span>
              <svg class="cta-arrow" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <line x1="7" y1="17" x2="17" y2="7"></line>
                <polyline points="7 7 17 7 17 17"></polyline>
              </svg>
            </a>
          </div>
        </article>
      ))}
    </div>
  </div>
</section>

<style>
  .promotional-apps-section {
    padding: var(--space-16) 0;
    background: linear-gradient(180deg, var(--color-surface-subtle) 0%, var(--color-bg) 100%);
    border-top: 1px solid var(--color-border);
    margin-top: var(--space-12);
  }

  .promotional-apps-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
    gap: var(--space-6);
  }

  .promotional-app-card {
    background-color: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    padding: var(--space-8) var(--space-6);
    display: flex;
    flex-direction: column;
    box-shadow: var(--shadow-sm);
    position: relative;
    overflow: hidden;
    transition: transform var(--transition-base), box-shadow var(--transition-base), border-color var(--transition-base);
  }

  .promotional-app-card::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 3px;
    background: linear-gradient(90deg, var(--color-primary-accent), #7c3aed, #ec4899);
    opacity: 0.8;
  }

  .promotional-app-card:hover {
    transform: translateY(-4px);
    box-shadow: var(--shadow-hover);
    border-color: var(--color-border-hover);
  }

  .app-card-top-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: var(--space-4);
    gap: var(--space-4);
  }

  .app-icon-wrap {
    width: 60px;
    height: 60px;
    border-radius: var(--radius-md);
    background-color: var(--color-surface-subtle);
    border: 1px solid var(--color-border);
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 6px;
    box-shadow: var(--shadow-sm);
    flex-shrink: 0;
  }

  .app-icon-img {
    width: 100%;
    height: 100%;
    object-fit: contain;
    border-radius: var(--radius-sm);
  }

  .app-badge-col {
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: 0.35rem;
  }

  .app-category-badge {
    font-family: var(--font-sans);
    font-size: 0.725rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--color-primary-accent);
    background-color: rgba(37, 99, 235, 0.08);
    padding: 0.2rem 0.6rem;
    border-radius: var(--radius-full);
  }

  .app-badge-owned {
    font-family: var(--font-mono);
    font-size: 0.675rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--color-text-muted);
  }

  .app-card-title {
    font-family: var(--font-display);
    font-size: 1.45rem;
    font-weight: 700;
    line-height: 1.2;
    letter-spacing: -0.02em;
    margin-bottom: var(--space-2);
  }

  .app-title-link {
    color: var(--color-text-primary);
    text-decoration: none;
    transition: color var(--transition-fast);
  }

  .app-title-link:hover {
    color: var(--color-primary-accent);
  }

  .app-card-subtitle {
    font-family: var(--font-serif);
    font-size: 0.95rem;
    font-style: italic;
    color: var(--color-text-secondary);
    line-height: 1.4;
    margin-bottom: var(--space-4);
  }

  .app-card-description {
    font-size: 0.9rem;
    color: var(--color-text-secondary);
    line-height: 1.6;
    margin-bottom: var(--space-6);
    flex-grow: 1;
  }

  .app-card-footer {
    margin-top: auto;
    padding-top: var(--space-4);
    border-top: 1px solid var(--color-border-subtle);
  }

  .btn-promotional-cta {
    display: inline-flex;
    align-items: center;
    justify-content: space-between;
    width: 100%;
    padding: 0.75rem 1rem;
    font-family: var(--font-sans);
    font-size: 0.85rem;
    font-weight: 700;
    letter-spacing: 0.02em;
    color: var(--color-text-primary);
    background-color: var(--color-surface-subtle);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    text-decoration: none;
    transition: all var(--transition-fast);
  }

  .btn-promotional-cta:hover {
    background-color: var(--color-primary-accent);
    color: #ffffff;
    border-color: var(--color-primary-accent);
    transform: translateY(-1px);
    box-shadow: 0 4px 12px rgba(37, 99, 235, 0.25);
  }

  .cta-arrow {
    transition: transform var(--transition-fast);
  }

  .btn-promotional-cta:hover .cta-arrow {
    transform: translate(2px, -2px);
  }

  @media (max-width: 640px) {
    .promotional-apps-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
