---
import { PILLARS, type PillarSlug } from '../config/site';

export interface Props {
  pillar: PillarSlug | string;
  size?: 'xs' | 'sm' | 'md' | 'lg';
  asLink?: boolean;
}

const { pillar, size = 'sm', asLink = true } = Astro.props;
const pillarConfig = PILLARS[pillar as PillarSlug] || {
  name: pillar,
  slug: pillar,
  color: 'var(--color-olive)',
  bgLight: 'rgba(72, 92, 75, 0.08)',
};
---

{asLink ? (
  <a
    href={`/${pillarConfig.slug}`}
    class={`pillar-kicker pillar-kicker-${size}`}
    style={`--kicker-color: ${pillarConfig.color};`}
  >
    <span class="kicker-bullet">&bull;</span>
    <span>{pillarConfig.name}</span>
  </a>
) : (
  <span
    class={`pillar-kicker pillar-kicker-${size}`}
    style={`--kicker-color: ${pillarConfig.color};`}
  >
    <span class="kicker-bullet">&bull;</span>
    <span>{pillarConfig.name}</span>
  </span>
)}

<style>
  .pillar-kicker {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    font-family: var(--font-sans);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: var(--kicker-color, var(--color-olive));
    text-decoration: none;
    line-height: 1;
    white-space: nowrap;
    transition: color var(--transition-fast), opacity var(--transition-fast);
  }

  .pillar-kicker:hover {
    opacity: 0.8;
  }

  .kicker-bullet {
    font-size: 0.9em;
    opacity: 0.7;
  }

  .pillar-kicker-xs {
    font-size: 0.65rem;
  }

  .pillar-kicker-sm {
    font-size: 0.725rem;
  }

  .pillar-kicker-md {
    font-size: 0.8rem;
  }

  .pillar-kicker-lg {
    font-size: 0.875rem;
  }
</style>
