---
import { CATEGORIES } from '../utils/categories';

export interface Props {
  checklist: {
    id: string;
    data: {
      title: string;
      category?: string;
      summary: string;
      sections?: { title: string; items: any[] }[];
    };
  };
}

const { checklist } = Astro.props;
const slug = checklist.id.replace(/\.[^/.]+$/, '');
const cat = checklist.data.category ? CATEGORIES[checklist.data.category] : undefined;
const taskCount = checklist.data.sections?.reduce((acc, s) => acc + (s.items?.length || 0), 0) || 0;
---

<div class="chk-showcase-card">
  <div class="chk-meta">
    {taskCount > 0 && (
      <span class="badge chk-pill">📋 {taskCount} Tasks</span>
    )}
    {cat && (
      <span class="chk-cat" style={`color: ${cat.badgeColor}; background-color: ${cat.lightBg}; border: 1px solid ${cat.borderColor};`}>
        {cat.icon} {cat.title}
      </span>
    )}
  </div>
  <h3 class="chk-title">
    <a href={`/checklists/${slug}/`}>{checklist.data.title}</a>
  </h3>
  <p class="chk-summary">{checklist.data.summary}</p>
  <div class="chk-card-action">
    <a href={`/checklists/${slug}/`} class="btn btn-outline chk-btn">
      View &amp; Print Checklist &rarr;
    </a>
  </div>
</div>

<style>
  .chk-showcase-card {
    background-color: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    padding: var(--space-6);
    display: flex;
    flex-direction: column;
    box-shadow: var(--shadow-sm);
    transition: transform var(--transition-fast), border-color var(--transition-fast), box-shadow var(--transition-fast);
  }

  .chk-showcase-card:hover {
    transform: translateY(-2px);
    border-color: var(--color-border-hover);
    box-shadow: var(--shadow-card);
  }

  .chk-meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-2);
    margin-bottom: var(--space-3);
  }

  .chk-pill {
    font-size: 0.725rem;
    font-weight: 700;
    padding: 0.15rem 0.55rem;
    border-radius: var(--radius-full);
    background-color: rgba(5, 150, 105, 0.08);
    color: #059669;
    border: 1px solid rgba(5, 150, 105, 0.2);
  }

  .chk-cat {
    font-size: 0.725rem;
    font-weight: 700;
    padding: 0.15rem 0.55rem;
    border-radius: var(--radius-full);
  }

  .chk-title {
    font-family: var(--font-display);
    font-size: 1.2rem;
    font-weight: 700;
    line-height: 1.3;
    margin: 0 0 var(--space-2) 0;
  }

  .chk-title a {
    color: var(--color-text-primary);
    text-decoration: none;
    transition: color var(--transition-fast);
  }

  .chk-title a:hover {
    color: var(--color-primary-accent);
  }

  .chk-summary {
    font-size: 0.875rem;
    color: var(--color-text-secondary);
    line-height: 1.55;
    margin-bottom: var(--space-5);
    flex-grow: 1;
  }

  .chk-card-action {
    margin-top: auto;
  }

  .chk-btn {
    font-size: 0.8125rem;
    font-weight: 600;
    padding: 0.4rem 0.85rem;
    border-radius: var(--radius-sm);
    color: var(--color-text-primary);
    border-color: var(--color-border);
  }

  .chk-btn:hover {
    background-color: var(--color-surface-subtle);
    border-color: var(--color-border-hover);
  }
</style>
