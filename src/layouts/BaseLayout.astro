---
import SEO, { type Props as SEOProps } from '../components/SEO.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import SearchModal from '../components/SearchModal.astro';
import PromotionalAppsSection from '../components/PromotionalAppsSection.astro';
import '../styles/global.css';

export interface Props extends SEOProps {
  showPromotionalApps?: boolean;
}

const { showPromotionalApps = true, ...seoProps } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;500;600&family=Newsreader:ital,opsz,wght@0,6..72,400..700;1,6..72,400..700&family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap"
      rel="stylesheet"
    />
    <SEO {...seoProps} />
  </head>
  <body>
    <Header />
    <main id="main-content">
      <slot />
    </main>
    {showPromotionalApps && <PromotionalAppsSection />}
    <Footer />
    <SearchModal />
  </body>
</html>
