---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import { CATEGORIES } from '../utils/categories';

const categories = Object.values(CATEGORIES);
const [allGuides, allTools, allChecklists] = await Promise.all([
  getCollection('guides'),
  getCollection('tools'),
  getCollection('checklists'),
]);

// Featured Guides
const featuredGuides = allGuides.slice(0, 6);
// Featured Tools
const featuredTools = allTools.slice(0, 4);
// Featured Checklists
const featuredChecklists = allChecklists.slice(0, 3);
---

<BaseLayout
  title="LifeMode — Practical Guides, Tools & Ideas for Modern Life"
  description="Practical answers for everyday decisions, problems, and tasks. High-quality reference guides, evidence-based care instructions, and interactive tools."
  canonicalUrl="https://lifemode.life/"
>
  <!-- Hero Section -->
  <section class="hero-section">
    <div class="container hero-inner">
      <div class="hero-badge">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
          <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>
          <path d="m9 12 2 2 4-4"/>
        </svg>
        <span>Authoritative Everyday Reference & Decision Library</span>
      </div>

      <h1 class="hero-heading">
        Everyday answers.<br />
        <span class="hero-highlight">Practical decisions.</span><br />
        Better ways to do things.
      </h1>

      <p class="hero-subheading">
        Clear, fact-checked reference guidance, evidence-based care protocols, and interactive decision tools for everyday household life.
      </p>

      <!-- Centerpiece Search Trigger Box -->
      <div class="hero-search-box">
        <button class="hero-search-btn" id="hero-open-search">
          <svg class="search-svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2">
            <circle cx="11" cy="11" r="8"/>
            <path d="m21 21-4.3-4.3"/>
          </svg>
          <span class="search-prompt">What are you trying to figure out? (e.g. coffee stain, cast iron, store rice...)</span>
          <kbd class="hero-kbd">/</kbd>
        </button>

        <div class="hero-quick-chips">
          <span class="chips-title">Frequent queries:</span>
          <button class="hero-chip" data-search="cast iron">🍳 Cast-Iron Pan Care</button>
          <button class="hero-chip" data-search="coffee stain">✨ Coffee Stain Removal</button>
          <button class="hero-chip" data-search="rice">🍚 Rice Storage Safety</button>
          <button class="hero-chip" data-search="winter">🏡 Winter Home Prep</button>
        </div>
      </div>
    </div>
  </section>

  <!-- 5 Core Knowledge Clusters -->
  <section class="clusters-section">
    <div class="container">
      <div class="section-header">
        <span class="section-badge">Knowledge Taxonomy</span>
        <h2 class="section-title">Browse by Knowledge Cluster</h2>
        <p class="section-desc">Explore structured reference guides, decision tools, and preventative checklists across 5 core household domains.</p>
      </div>

      <div class="clusters-grid">
        {categories.map((cat) => {
          const catGuidesCount = allGuides.filter(g => g.data.category === cat.id).length;
          return (
            <a href={`/${cat.slug}/`} class="cluster-hub-card" style={`--cat-color: ${cat.badgeColor};`}>
              <div class="cluster-card-top">
                <span class="cluster-icon">{cat.icon}</span>
                <span class="cluster-count">{catGuidesCount} {catGuidesCount === 1 ? 'Guide' : 'Guides'}</span>
              </div>
              <h3 class="cluster-name">{cat.title}</h3>
              <p class="cluster-info">{cat.description}</p>
              <div class="cluster-topics-list">
                {cat.popularTopics.slice(0, 3).map((t) => (
                  <span class="cluster-mini-tag">• {t}</span>
                ))}
              </div>
              <span class="cluster-card-link">Explore {cat.shortTitle} →</span>
            </a>
          );
        })}
      </div>
    </div>
  </section>

  <!-- Interactive Utility Tools Showcase -->
  <section class="tools-showcase-section">
    <div class="container">
      <div class="section-header">
        <span class="section-badge tools-badge">Interactive Decision Support</span>
        <h2 class="section-title">Browser-Based Household Decision Tools</h2>
        <p class="section-desc">No accounts, no paywalls, no clutter. Instant calculations and targeted diagnosis protocols right in your browser.</p>
      </div>

      <div class="tools-showcase-grid">
        {featuredTools.map((tool) => {
          const cat = CATEGORIES[tool.data.category];
          const slug = tool.id.replace(/\.[^/.]+$/, '');
          return (
            <div class="tool-showcase-card">
              <div class="tool-showcase-meta">
                <span class="badge tool-badge-pill">🛠️ Interactive Utility</span>
                {cat && <span class="tool-cat-badge">{cat.icon} {cat.title}</span>}
              </div>
              <h3 class="tool-showcase-title">
                <a href={`/tools/${slug}/`}>{tool.data.title}</a>
              </h3>
              <p class="tool-showcase-summary">{tool.data.summary}</p>
              <a href={`/tools/${slug}/`} class="btn btn-primary tool-launch-btn">Use Tool →</a>
            </div>
          );
        })}
      </div>

      <div class="section-footer-link">
        <a href="/tools/" class="btn btn-secondary">View All Interactive Decision Tools →</a>
      </div>
    </div>
  </section>

  <!-- Popular Practical Reference Guides -->
  <section class="guides-showcase-section">
    <div class="container">
      <div class="section-header">
        <span class="section-badge guides-badge">Practical Reference Library</span>
        <h2 class="section-title">Popular Step-by-Step Reference Guides</h2>
        <p class="section-desc">Curated practical instructions with direct answers, common mistake warnings, and verified chemistry protocols.</p>
      </div>

      <div class="guide-grid">
        {featuredGuides.map((guide) => {
          const cat = CATEGORIES[guide.data.category];
          const slug = guide.id.replace(/\.[^/.]+$/, '');
          return (
            <a href={`/${guide.data.category}/${slug}/`} class="guide-card">
              <div class="card-meta-top">
                {cat && (
                  <span class="badge" style={`color: ${cat.badgeColor}; background-color: ${cat.lightBg};`}>
                    {cat.icon} {cat.title}
                  </span>
                )}
                <span class="type-pill">{guide.data.contentType === 'decision' ? '⚖️ Decision' : '📖 Reference'}</span>
              </div>
              <h3>{guide.data.title}</h3>
              <p>{guide.data.quickSummary}</p>
              <div class="guide-card-footer">
                <span>⏱️ {guide.data.readTime || '4 min read'}</span>
                <span>Verified: {guide.data.updatedDate}</span>
              </div>
            </a>
          );
        })}
      </div>

      <div class="section-footer-link">
        <a href="/guides/" class="btn btn-secondary">Browse Complete Reference Library ({allGuides.length} Guides) →</a>
      </div>
    </div>
  </section>

  <!-- Checklists & Printables Spotlight -->
  <section class="checklists-showcase-section">
    <div class="container">
      <div class="section-header">
        <span class="section-badge check-badge">Practical Printables</span>
        <h2 class="section-title">Household Checklists & Cheat Sheets</h2>
        <p class="section-desc">Interactive browser tracking and clean, printer-optimized layouts for routine household upkeep.</p>
      </div>

      <div class="checklists-showcase-grid">
        {featuredChecklists.map((chk) => {
          const cat = CATEGORIES[chk.data.category];
          const slug = chk.id.replace(/\.[^/.]+$/, '');
          const count = chk.data.sections.reduce((acc, s) => acc + s.items.length, 0);

          return (
            <div class="chk-showcase-card">
              <div class="chk-meta">
                <span class="badge chk-pill">📋 {count} Checkable Tasks</span>
                {cat && <span class="chk-cat">{cat.icon} {cat.title}</span>}
              </div>
              <h3 class="chk-title">
                <a href={`/checklists/${slug}/`}>{chk.data.title}</a>
              </h3>
              <p class="chk-summary">{chk.data.summary}</p>
              <a href={`/checklists/${slug}/`} class="btn btn-secondary chk-btn">Open & Print Checklist →</a>
            </div>
          );
        })}
      </div>
    </div>
  </section>

  <!-- Editorial Standards & Trust Banner -->
  <section class="trust-banner-section">
    <div class="container trust-banner-inner">
      <div class="trust-banner-col">
        <div class="trust-shield-icon">🛡️</div>
        <h3>Evidence-Based & Fact-Checked</h3>
        <p>Every guide references agricultural extensions, manufacturer guidelines, and recognized testing standards.</p>
      </div>
      <div class="trust-banner-col">
        <div class="trust-shield-icon">🚫</div>
        <h3>Zero AI Search Farm Content</h3>
        <p>No generic summaries, fake expertise, or filler. Human-reviewed clarity focused on practical everyday execution.</p>
      </div>
      <div class="trust-banner-col">
        <div class="trust-shield-icon">⚡</div>
        <h3>Fast, Static & Privacy-First</h3>
        <p>Zero tracking cookies required. Lightweight, instant page loads with Core Web Vitals optimization.</p>
      </div>
    </div>
  </section>
</BaseLayout>

<script>
  const heroSearchBtn = document.getElementById('hero-open-search');
  const openSearchBtn = document.getElementById('open-search-btn');

  heroSearchBtn?.addEventListener('click', () => {
    openSearchBtn?.click();
  });

  document.querySelectorAll('.hero-chip').forEach(chip => {
    chip.addEventListener('click', () => {
      const q = chip.getAttribute('data-search') || '';
      openSearchBtn?.click();
      setTimeout(() => {
        const input = document.getElementById('global-search-input') as HTMLInputElement;
        if (input) {
          input.value = q;
          input.dispatchEvent(new Event('input'));
        }
      }, 100);
    });
  });
</script>

<style>
  /* Hero Section */
  .hero-section {
    background: linear-gradient(180deg, #ffffff 0%, var(--slate-50) 100%);
    border-bottom: 1px solid var(--slate-200);
    padding: 4.5rem 0 3.5rem 0;
  }

  .hero-inner {
    text-align: center;
    max-width: 860px;
  }

  .hero-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.8rem;
    font-weight: 700;
    color: var(--slate-700);
    background-color: #ffffff;
    border: 1px solid var(--slate-200);
    padding: 0.35rem 0.85rem;
    border-radius: var(--radius-full);
    margin-bottom: 1.5rem;
    box-shadow: var(--shadow-xs);
  }

  .hero-heading {
    font-size: clamp(2.4rem, 5.5vw, 3.6rem);
    font-weight: 800;
    line-height: 1.15;
    letter-spacing: -0.03em;
    color: var(--slate-950);
    margin-bottom: 1.25rem;
  }

  .hero-highlight {
    background: linear-gradient(135deg, var(--accent-blue) 0%, var(--accent-emerald) 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
  }

  .hero-subheading {
    font-size: 1.2rem;
    color: var(--slate-600);
    line-height: 1.6;
    margin-bottom: 2.25rem;
  }

  /* Centerpiece Search */
  .hero-search-box {
    max-width: 640px;
    margin: 0 auto;
  }

  .hero-search-btn {
    width: 100%;
    display: flex;
    align-items: center;
    gap: 0.85rem;
    background-color: #ffffff;
    border: 2px solid var(--slate-300);
    border-radius: var(--radius-full);
    padding: 0.85rem 1.35rem;
    cursor: pointer;
    box-shadow: var(--shadow-md), 0 0 0 4px rgba(37, 99, 235, 0.05);
    transition: all var(--transition-normal);
  }

  .hero-search-btn:hover {
    border-color: var(--accent-blue);
    box-shadow: var(--shadow-lg), 0 0 0 6px rgba(37, 99, 235, 0.1);
    transform: translateY(-1px);
  }

  .search-svg {
    color: var(--accent-blue);
    flex-shrink: 0;
  }

  .search-prompt {
    font-family: var(--font-body);
    font-size: 1.05rem;
    color: var(--slate-500);
    text-align: left;
    flex-grow: 1;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .hero-kbd {
    background-color: var(--slate-100);
    border: 1px solid var(--slate-300);
    border-radius: var(--radius-sm);
    padding: 0.15rem 0.5rem;
    font-family: var(--font-mono);
    font-size: 0.85rem;
    font-weight: 700;
    color: var(--slate-600);
  }

  .hero-quick-chips {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    margin-top: 1rem;
  }

  .chips-title {
    font-size: 0.8rem;
    font-weight: 600;
    color: var(--slate-500);
  }

  .hero-chip {
    background-color: #ffffff;
    border: 1px solid var(--slate-200);
    border-radius: var(--radius-full);
    padding: 0.25rem 0.65rem;
    font-size: 0.8rem;
    font-weight: 500;
    color: var(--slate-700);
    cursor: pointer;
    transition: all var(--transition-fast);
  }

  .hero-chip:hover {
    background-color: var(--slate-100);
    border-color: var(--slate-300);
    color: var(--slate-900);
  }

  /* Section Headings */
  .section-header {
    text-align: center;
    max-width: 720px;
    margin: 0 auto 2.5rem auto;
  }

  .section-badge {
    display: inline-block;
    font-size: 0.75rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--slate-600);
    background-color: var(--slate-100);
    border: 1px solid var(--slate-200);
    padding: 0.2rem 0.6rem;
    border-radius: var(--radius-full);
    margin-bottom: 0.5rem;
  }

  .tools-badge { color: var(--accent-blue); background-color: var(--accent-blue-light); border-color: var(--accent-blue-border); }
  .guides-badge { color: var(--slate-700); background-color: var(--slate-100); border-color: var(--slate-200); }
  .check-badge { color: var(--accent-emerald); background-color: var(--accent-emerald-light); border-color: var(--accent-emerald-border); }

  .section-title {
    font-size: clamp(1.6rem, 3vw, 2.2rem);
    margin-top: 0.25rem;
    margin-bottom: 0.5rem;
    color: var(--slate-950);
  }

  .section-desc {
    font-size: 1.05rem;
    color: var(--slate-600);
    margin: 0;
  }

  /* Clusters Section */
  .clusters-section {
    padding: 4.5rem 0;
    background-color: #ffffff;
  }

  .clusters-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: 1.5rem;
  }

  .cluster-hub-card {
    background-color: var(--slate-50);
    border: 1px solid var(--slate-200);
    border-radius: var(--radius-lg);
    padding: 1.6rem;
    display: flex;
    flex-direction: column;
    text-decoration: none;
    transition: all var(--transition-normal);
    position: relative;
    overflow: hidden;
  }

  .cluster-hub-card::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 4px;
    background-color: var(--cat-color, var(--slate-900));
  }

  .cluster-hub-card:hover {
    background-color: #ffffff;
    transform: translateY(-4px);
    box-shadow: var(--shadow-md);
    border-color: var(--slate-300);
    text-decoration: none;
  }

  .cluster-card-top {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 0.75rem;
  }

  .cluster-icon {
    font-size: 2rem;
  }

  .cluster-count {
    font-size: 0.75rem;
    font-weight: 700;
    color: var(--slate-500);
    background-color: #ffffff;
    border: 1px solid var(--slate-200);
    padding: 0.15rem 0.5rem;
    border-radius: var(--radius-full);
  }

  .cluster-name {
    font-size: 1.25rem;
    color: var(--slate-900);
    margin-top: 0;
    margin-bottom: 0.4rem;
  }

  .cluster-info {
    font-size: 0.88rem;
    color: var(--slate-600);
    line-height: 1.5;
    margin-bottom: 1rem;
    flex-grow: 1;
  }

  .cluster-topics-list {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    margin-bottom: 1rem;
    border-top: 1px solid var(--slate-200);
    padding-top: 0.75rem;
  }

  .cluster-mini-tag {
    font-size: 0.78rem;
    color: var(--slate-500);
  }

  .cluster-card-link {
    font-size: 0.88rem;
    font-weight: 700;
    color: var(--slate-900);
    margin-top: auto;
  }

  /* Tools Showcase */
  .tools-showcase-section {
    padding: 4.5rem 0;
    background-color: var(--slate-50);
    border-top: 1px solid var(--slate-200);
    border-bottom: 1px solid var(--slate-200);
  }

  .tools-showcase-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(270px, 1fr));
    gap: 1.5rem;
    margin-bottom: 2rem;
  }

  .tool-showcase-card {
    background-color: #ffffff;
    border: 1px solid var(--slate-200);
    border-radius: var(--radius-lg);
    padding: 1.6rem;
    display: flex;
    flex-direction: column;
    box-shadow: var(--shadow-xs);
    transition: all var(--transition-normal);
  }

  .tool-showcase-card:hover {
    transform: translateY(-3px);
    box-shadow: var(--shadow-md);
  }

  .tool-showcase-meta {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 0.75rem;
  }

  .tool-badge-pill {
    background-color: var(--accent-blue-light);
    color: var(--accent-blue);
  }

  .tool-cat-badge {
    font-size: 0.75rem;
    font-weight: 600;
    color: var(--slate-500);
  }

  .tool-showcase-title {
    font-size: 1.2rem;
    margin-top: 0;
    margin-bottom: 0.4rem;
  }

  .tool-showcase-title a {
    color: var(--slate-900);
    text-decoration: none;
  }

  .tool-showcase-title a:hover {
    color: var(--accent-blue);
    text-decoration: underline;
  }

  .tool-showcase-summary {
    font-size: 0.9rem;
    color: var(--slate-600);
    line-height: 1.5;
    margin-bottom: 1.25rem;
    flex-grow: 1;
  }

  .tool-launch-btn {
    width: 100%;
  }

  .section-footer-link {
    text-align: center;
    margin-top: 1.5rem;
  }

  /* Guides Showcase */
  .guides-showcase-section {
    padding: 4.5rem 0;
    background-color: #ffffff;
  }

  .type-pill {
    font-size: 0.75rem;
    font-weight: 600;
    color: var(--slate-500);
  }

  /* Checklists Showcase */
  .checklists-showcase-section {
    padding: 4.5rem 0;
    background-color: var(--slate-50);
    border-top: 1px solid var(--slate-200);
    border-bottom: 1px solid var(--slate-200);
  }

  .checklists-showcase-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
    gap: 1.5rem;
  }

  .chk-showcase-card {
    background-color: #ffffff;
    border: 1px solid var(--slate-200);
    border-radius: var(--radius-lg);
    padding: 1.6rem;
    display: flex;
    flex-direction: column;
    box-shadow: var(--shadow-xs);
  }

  .chk-meta {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 0.75rem;
  }

  .chk-pill {
    background-color: var(--accent-emerald-light);
    color: var(--accent-emerald);
  }

  .chk-cat {
    font-size: 0.75rem;
    font-weight: 600;
    color: var(--slate-500);
  }

  .chk-title {
    font-size: 1.25rem;
    margin-top: 0;
    margin-bottom: 0.4rem;
  }

  .chk-title a {
    color: var(--slate-900);
    text-decoration: none;
  }

  .chk-title a:hover {
    color: var(--accent-blue);
    text-decoration: underline;
  }

  .chk-summary {
    font-size: 0.92rem;
    color: var(--slate-600);
    line-height: 1.5;
    margin-bottom: 1.25rem;
    flex-grow: 1;
  }

  .chk-btn {
    width: 100%;
  }

  /* Trust Banner */
  .trust-banner-section {
    padding: 3.5rem 0;
    background-color: #ffffff;
  }

  .trust-banner-inner {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
    gap: 2rem;
  }

  .trust-banner-col {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
  }

  .trust-shield-icon {
    font-size: 1.75rem;
    margin-bottom: 0.5rem;
  }

  .trust-banner-col h3 {
    font-size: 1.15rem;
    color: var(--slate-900);
    margin-top: 0;
    margin-bottom: 0.4rem;
  }

  .trust-banner-col p {
    font-size: 0.92rem;
    color: var(--slate-600);
    line-height: 1.5;
    margin: 0;
  }
</style>
