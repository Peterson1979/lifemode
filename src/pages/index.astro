---
import BaseLayout from '../layouts/BaseLayout.astro';
import ArticleCard from '../components/ArticleCard.astro';
import PillarBadge from '../components/PillarBadge.astro';
import EcosystemCard from '../components/EcosystemCard.astro';
import { getCollection } from 'astro:content';
import { PILLARS, PILLAR_SLUGS, SITE_CONFIG, type PillarSlug } from '../config/site';
import { ECOSYSTEM_PROJECTS } from '../config/ecosystem';
import { generateWebsiteSchema } from '../utils/seo';

// Fetch articles from all 7 collections
const [
  styleDocs,
  travelDocs,
  foodDrinkDocs,
  techAiDocs,
  moneyDocs,
  wellbeingDocs,
  cultureDocs,
] = await Promise.all([
  getCollection('style'),
  getCollection('travel'),
  getCollection('food-drink'),
  getCollection('tech-ai'),
  getCollection('money'),
  getCollection('wellbeing'),
  getCollection('culture'),
]);

interface ArticleEntry {
  id: string;
  pillar: PillarSlug;
  data: {
    title: string;
    description: string;
    pubDate: Date;
    updatedDate?: Date;
    author?: string;
    featured?: boolean;
    draft?: boolean;
    image?: string;
    imageAlt?: string;
    imagePrompt?: string;
    readingTime?: string;
    format?: string;
    tags?: string[];
  };
}

// Gather all articles from all collections
const allArticles: ArticleEntry[] = [
  ...styleDocs.map((doc) => ({ id: doc.id, pillar: 'style' as PillarSlug, data: doc.data })),
  ...travelDocs.map((doc) => ({ id: doc.id, pillar: 'travel' as PillarSlug, data: doc.data })),
  ...foodDrinkDocs.map((doc) => ({ id: doc.id, pillar: 'food-drink' as PillarSlug, data: doc.data })),
  ...techAiDocs.map((doc) => ({ id: doc.id, pillar: 'tech-ai' as PillarSlug, data: doc.data })),
  ...moneyDocs.map((doc) => ({ id: doc.id, pillar: 'money' as PillarSlug, data: doc.data })),
  ...wellbeingDocs.map((doc) => ({ id: doc.id, pillar: 'wellbeing' as PillarSlug, data: doc.data })),
  ...cultureDocs.map((doc) => ({ id: doc.id, pillar: 'culture' as PillarSlug, data: doc.data })),
];

// Deduplicate all non-draft articles and sort deterministically by publication date (newest first)
const seenIds = new Set<string>();
const uniqueArticles: ArticleEntry[] = [];
for (const article of allArticles) {
  if (!article.data.draft && !seenIds.has(article.id)) {
    seenIds.add(article.id);
    uniqueArticles.push(article);
  }
}

uniqueArticles.sort((a, b) => {
  const timeA = new Date(a.data.pubDate).getTime();
  const timeB = new Date(b.data.pubDate).getTime();
  if (timeB !== timeA) return timeB - timeA;
  return a.id.localeCompare(b.id);
});

// Deterministic Latest-3 Featured package:
// Automatically driven by the latest 3 unique articles from daily content refresh
const leadArticle = uniqueArticles[0] || null;
const secondaryArticles = uniqueArticles
  .filter((a) => a.id !== leadArticle?.id)
  .slice(0, 2);

const featuredIds = new Set<string>();
if (leadArticle) featuredIds.add(leadArticle.id);
secondaryArticles.forEach((a) => featuredIds.add(a.id));

// Latest stories section displays the subsequent recent articles (deduplicated against featured)
const latestDispatches = uniqueArticles
  .filter((a) => !featuredIds.has(a.id))
  .slice(0, 6);

const websiteSchema = generateWebsiteSchema();
---

<BaseLayout
  title="LifeMode — Ideas for living well now"
  description={SITE_CONFIG.description}
  jsonLd={websiteSchema}
>
  <!-- Main Intro Header -->
  <section class="hero-editorial">
    <div class="container">
      <h1 class="hero-heading">
        Ideas for living well now
      </h1>
      <p class="hero-lead">
        Practical guides, thoughtful tools, and clear ideas across technology, travel, food &amp; drink, personal finance, wellbeing, and everyday life.
      </p>

      <!-- Topic Quick Nav Ribbon -->
      <div class="hero-pillar-ribbon">
        <span class="ribbon-label">Explore Topics:</span>
        <div class="ribbon-badges">
          {PILLAR_SLUGS.map((slug) => (
            <PillarBadge pillar={slug} size="sm" />
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- Featured 3-Article Magazine Package (Dominant Lead + 2 Secondary Stories) -->
  {leadArticle ? (
    <section class="section">
      <div class="container">
        <div class="section-header">
          <div>
            <span class="section-kicker">Featured</span>
            <h2 class="section-title">Today's Highlights</h2>
          </div>
          <a href={`/${leadArticle.pillar}`} class="section-link">
            Explore {PILLARS[leadArticle.pillar]?.name || leadArticle.pillar} &rarr;
          </a>
        </div>

        <div class={secondaryArticles.length > 0 ? "grid-lead-secondary" : "lead-single-wrap"}>
          <!-- Dominant Lead Feature -->
          <div class="lead-card-col">
            <ArticleCard
              pillar={leadArticle.pillar}
              slug={leadArticle.id}
              title={leadArticle.data.title}
              description={leadArticle.data.description}
              pubDate={leadArticle.data.pubDate}
              author={leadArticle.data.author}
              image={leadArticle.data.image}
              imageAlt={leadArticle.data.imageAlt}
              readingTime={leadArticle.data.readingTime}
              format={leadArticle.data.format}
              tags={leadArticle.data.tags}
              variant="lead"
              featured={true}
            />
          </div>

          <!-- Secondary Companion Stories -->
          {secondaryArticles.length > 0 && (
            <div class="secondary-col">
              <span class="secondary-header-kicker">More Recent Stories</span>
              {secondaryArticles.map((article) => (
                <ArticleCard
                  pillar={article.pillar}
                  slug={article.id}
                  title={article.data.title}
                  description={article.data.description}
                  pubDate={article.data.pubDate}
                  author={article.data.author}
                  image={article.data.image}
                  imageAlt={article.data.imageAlt}
                  readingTime={article.data.readingTime}
                  format={article.data.format}
                  tags={article.data.tags}
                  variant="horizontal"
                />
              ))}
            </div>
          )}
        </div>
      </div>
    </section>
  ) : (
    <section class="section">
      <div class="container">
        <div class="empty-state-editorial">
          <span class="section-kicker">Welcome</span>
          <h2 class="empty-state-title">Welcome to LifeMode</h2>
          <p class="empty-state-text">
            Our first collection of stories and guides is on the way. Explore our topics and tools below.
          </p>
        </div>
      </div>
    </section>
  )}

  <!-- Latest Stories (Deduplicated Grid) -->
  {latestDispatches.length > 0 && (
    <section class="section latest-stories-section">
      <div class="container">
        <div class="section-header">
          <div>
            <span class="section-kicker">Fresh Perspectives</span>
            <h2 class="section-title">Latest Stories</h2>
            <p class="section-subtitle">Recent articles, deep dives, and practical guides</p>
          </div>
        </div>

        <div class="grid-3">
          {latestDispatches.map((article) => (
            <ArticleCard
              pillar={article.pillar}
              slug={article.id}
              title={article.data.title}
              description={article.data.description}
              pubDate={article.data.pubDate}
              author={article.data.author}
              image={article.data.image}
              imageAlt={article.data.imageAlt}
              readingTime={article.data.readingTime}
              format={article.data.format}
              tags={article.data.tags}
              variant="card"
            />
          ))}
        </div>
      </div>
    </section>
  )}

  <!-- Topics Discovery Showcase -->
  <section class="section pillar-showcase-section">
    <div class="container">
      <div class="section-header">
        <div>
          <span class="section-kicker">Topics</span>
          <h2 class="section-title">Explore Topics</h2>
          <p class="section-subtitle">Browse stories across all LifeMode subjects</p>
        </div>
      </div>

      <div class="pillar-showcase-grid">
        {PILLAR_SLUGS.map((slug) => {
          const pillar = PILLARS[slug];
          return (
            <article class="pillar-card" style={`--pillar-color: ${pillar.color}; --pillar-bg: ${pillar.bgLight};`}>
              <div class="pillar-accent-bar" style={`background-color: ${pillar.color};`}></div>
              <div class="pillar-card-content">
                <div class="pillar-card-header">
                  <PillarBadge pillar={slug} size="sm" asLink={false} />
                </div>
                <h3 class="pillar-card-title">{pillar.tagline}</h3>
                <p class="pillar-card-desc">{pillar.description}</p>
                <div class="pillar-card-footer">
                  <a href={`/${pillar.slug}`} class="pillar-card-link">
                    <span>Explore {pillar.name}</span>
                    <span aria-hidden="true">&rarr;</span>
                  </a>
                </div>
              </div>
            </article>
          );
        })}
      </div>
    </div>
  </section>

  <!-- Apps & Tools Discovery Showcase -->
  <section class="section ecosystem-showcase-section">
    <div class="container">
      <div class="section-header">
        <div>
          <span class="section-kicker">Interactive</span>
          <h2 class="section-title">Apps &amp; Tools</h2>
          <p class="section-subtitle">Helpful tools and interactive experiences built by our team</p>
        </div>
      </div>

      <div class="grid-2">
        {ECOSYSTEM_PROJECTS.map((project) => (
          <EcosystemCard project={project} />
        ))}
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .hero-kicker-wrap {
    margin-bottom: 0.5rem;
  }

  .hero-pillar-ribbon {
    display: flex;
    align-items: center;
    gap: 0.85rem;
    flex-wrap: wrap;
    padding-top: var(--space-6);
    border-top: 1px solid var(--color-border);
  }

  .ribbon-label {
    font-family: var(--font-sans);
    font-size: 0.75rem;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--color-text-muted);
  }

  .ribbon-badges {
    display: flex;
    gap: 0.65rem;
    flex-wrap: wrap;
  }

  .lead-single-wrap {
    max-width: 880px;
    margin: 0 auto;
  }

  .secondary-col {
    display: flex;
    flex-direction: column;
    gap: var(--space-5);
  }

  .secondary-header-kicker {
    font-family: var(--font-sans);
    font-size: 0.725rem;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: var(--color-text-muted);
    padding-bottom: var(--space-2);
    border-bottom: 2px solid var(--color-border);
  }

  .empty-state-editorial {
    padding: var(--space-16) var(--space-8);
    text-align: center;
    background-color: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    box-shadow: var(--shadow-sm);
  }

  .empty-state-title {
    font-family: var(--font-display);
    font-size: 2.2rem;
    font-weight: 700;
    color: var(--color-text-primary);
    margin-top: 0.5rem;
    margin-bottom: 0.75rem;
  }

  .empty-state-text {
    color: var(--color-text-secondary);
    font-size: 1.05rem;
    line-height: 1.65;
    max-width: 560px;
    margin: 0 auto;
  }

  .latest-stories-section {
    padding-top: var(--space-6);
  }

  /* Pillar Showcase Section */
  .pillar-showcase-section {
    background-color: #f1f5f9;
    border-top: 1px solid var(--color-border);
    border-bottom: 1px solid var(--color-border);
  }

  .pillar-showcase-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: var(--space-6);
  }

  .pillar-card {
    background-color: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    overflow: hidden;
    display: flex;
    flex-direction: column;
    box-shadow: var(--shadow-sm);
    transition: transform var(--transition-base), box-shadow var(--transition-base), border-color var(--transition-base);
  }

  .pillar-card:hover {
    border-color: var(--color-border-hover);
    transform: translateY(-3px);
    box-shadow: var(--shadow-hover);
  }

  .pillar-accent-bar {
    height: 4px;
    width: 100%;
  }

  .pillar-card-content {
    padding: 1.75rem;
    display: flex;
    flex-direction: column;
    flex-grow: 1;
  }

  .pillar-card-header {
    margin-bottom: 0.85rem;
  }

  .pillar-card-title {
    font-family: var(--font-display);
    font-size: 1.3rem;
    font-weight: 700;
    color: var(--color-text-primary);
    margin-bottom: 0.5rem;
    line-height: 1.25;
  }

  .pillar-card-desc {
    font-size: 0.875rem;
    color: var(--color-text-secondary);
    line-height: 1.6;
    margin-bottom: 1.5rem;
    flex-grow: 1;
  }

  .pillar-card-footer {
    margin-top: auto;
    padding-top: 1rem;
    border-top: 1px solid var(--color-border-subtle);
  }

  .pillar-card-link {
    font-family: var(--font-sans);
    font-size: 0.775rem;
    font-weight: 800;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--pillar-color, var(--color-primary-accent));
    text-decoration: none;
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    transition: gap var(--transition-fast);
  }

  .pillar-card-link:hover {
    gap: 0.55rem;
  }

  /* Ecosystem Section */
  .ecosystem-showcase-section {
    padding-top: var(--space-12);
    padding-bottom: var(--space-16);
  }
</style>
