---
import BaseLayout from '../layouts/BaseLayout.astro';
import ArticleCard from '../components/ArticleCard.astro';
import PillarBadge from '../components/PillarBadge.astro';
import EcosystemCard from '../components/EcosystemCard.astro';
import { getCollection } from 'astro:content';
import { PILLARS, PILLAR_SLUGS, SITE_CONFIG, type PillarSlug } from '../config/site';
import { ECOSYSTEM_PROJECTS } from '../config/ecosystem';
import { generateWebsiteSchema } from '../utils/seo';

// Fetch articles from all 7 collections
const [
  lifeDocs,
  travelDocs,
  techAiDocs,
  moneyDocs,
  wellbeingDocs,
  discoverDocs,
  nowDocs,
] = await Promise.all([
  getCollection('life'),
  getCollection('travel'),
  getCollection('tech-ai'),
  getCollection('money'),
  getCollection('wellbeing'),
  getCollection('discover'),
  getCollection('now'),
]);

interface ArticleEntry {
  id: string;
  pillar: PillarSlug;
  data: {
    title: string;
    description: string;
    pubDate: Date;
    updatedDate?: Date;
    author?: string;
    featured?: boolean;
    image?: string;
    imageAlt?: string;
    imagePrompt?: string;
    readingTime?: string;
    format?: string;
    tags?: string[];
  };
}

const allArticles: ArticleEntry[] = [
  ...lifeDocs.map((doc) => ({ id: doc.id, pillar: 'life' as PillarSlug, data: doc.data })),
  ...travelDocs.map((doc) => ({ id: doc.id, pillar: 'travel' as PillarSlug, data: doc.data })),
  ...techAiDocs.map((doc) => ({ id: doc.id, pillar: 'tech-ai' as PillarSlug, data: doc.data })),
  ...moneyDocs.map((doc) => ({ id: doc.id, pillar: 'money' as PillarSlug, data: doc.data })),
  ...wellbeingDocs.map((doc) => ({ id: doc.id, pillar: 'wellbeing' as PillarSlug, data: doc.data })),
  ...discoverDocs.map((doc) => ({ id: doc.id, pillar: 'discover' as PillarSlug, data: doc.data })),
  ...nowDocs.map((doc) => ({ id: doc.id, pillar: 'now' as PillarSlug, data: doc.data })),
].sort((a, b) => new Date(b.data.pubDate).getTime() - new Date(a.data.pubDate).getTime());

// Deduplicated article selection
const displayedIds = new Set<string>();

const leadArticle = allArticles.find((a) => a.data.featured) || allArticles[0];
if (leadArticle) {
  displayedIds.add(leadArticle.id);
}

const secondaryArticles = allArticles
  .filter((a) => !displayedIds.has(a.id))
  .slice(0, 2);
secondaryArticles.forEach((a) => displayedIds.add(a.id));

const latestDispatches = allArticles
  .filter((a) => !displayedIds.has(a.id))
  .slice(0, 6);

const websiteSchema = generateWebsiteSchema();
---

<BaseLayout
  title="LifeMode — Ideas for living well now"
  description={SITE_CONFIG.description}
  jsonLd={websiteSchema}
>
  <!-- Issue Header / Editorial Intro -->
  <section class="hero-editorial">
    <div class="container">
      <div class="hero-kicker-wrap">
        <span class="hero-tag">LifeMode</span>
      </div>
      <h1 class="hero-heading">
        Ideas for living well now
      </h1>
      <p class="hero-lead">
        Practical guides, thoughtful tools, and clear ideas across technology, travel, money, wellbeing, and everyday life.
      </p>

      <!-- Topic Quick Nav Ribbon -->
      <div class="hero-pillar-ribbon">
        <span class="ribbon-label">Topics:</span>
        <div class="ribbon-badges">
          {PILLAR_SLUGS.map((slug) => (
            <PillarBadge pillar={slug} size="sm" />
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- Lead Story & Secondary Features (Asymmetric Magazine Composition) -->
  {leadArticle ? (
    <section class="section">
      <div class="container">
        <div class="section-header">
          <div>
            <span class="section-kicker">Featured</span>
            <h2 class="section-title">Featured story</h2>
          </div>
          <a href={`/${leadArticle.pillar}`} class="section-link">
            Explore {PILLARS[leadArticle.pillar]?.name || leadArticle.pillar} &rarr;
          </a>
        </div>

        <div class={secondaryArticles.length > 0 ? "grid-lead-secondary" : "lead-single-wrap"}>
          <!-- Dominant Lead Feature -->
          <div class="lead-card-col">
            <ArticleCard
              pillar={leadArticle.pillar}
              slug={leadArticle.id}
              title={leadArticle.data.title}
              description={leadArticle.data.description}
              pubDate={leadArticle.data.pubDate}
              author={leadArticle.data.author}
              image={leadArticle.data.image}
              imageAlt={leadArticle.data.imageAlt}
              readingTime={leadArticle.data.readingTime}
              format={leadArticle.data.format}
              tags={leadArticle.data.tags}
              variant="lead"
              featured={true}
            />
          </div>

          <!-- Secondary Companion Stories -->
          {secondaryArticles.length > 0 && (
            <div class="secondary-col">
              <span class="secondary-header-kicker">More stories</span>
              {secondaryArticles.map((article) => (
                <ArticleCard
                  pillar={article.pillar}
                  slug={article.id}
                  title={article.data.title}
                  description={article.data.description}
                  pubDate={article.data.pubDate}
                  author={article.data.author}
                  image={article.data.image}
                  imageAlt={article.data.imageAlt}
                  readingTime={article.data.readingTime}
                  format={article.data.format}
                  tags={article.data.tags}
                  variant="horizontal"
                />
              ))}
            </div>
          )}
        </div>
      </div>
    </section>
  ) : (
    <section class="section">
      <div class="container">
        <div class="empty-state-editorial">
          <span class="section-kicker">Welcome</span>
          <h2 class="empty-state-title">Welcome to LifeMode</h2>
          <p class="empty-state-text">
            Our first collection of stories and guides is on the way. Explore our topics and tools below.
          </p>
        </div>
      </div>
    </section>
  )}

  <!-- Latest Stories (Deduplicated Grid) -->
  {latestDispatches.length > 0 && (
    <section class="section" style="padding-top: var(--space-6);">
      <div class="container">
        <div class="section-header">
          <div>
            <span class="section-kicker">Latest</span>
            <h2 class="section-title">Latest stories</h2>
            <p class="section-subtitle">Recent articles and guides</p>
          </div>
        </div>

        <div class="grid-3">
          {latestDispatches.map((article) => (
            <ArticleCard
              pillar={article.pillar}
              slug={article.id}
              title={article.data.title}
              description={article.data.description}
              pubDate={article.data.pubDate}
              author={article.data.author}
              image={article.data.image}
              imageAlt={article.data.imageAlt}
              readingTime={article.data.readingTime}
              format={article.data.format}
              tags={article.data.tags}
              variant="card"
            />
          ))}
        </div>
      </div>
    </section>
  )}

  <!-- Topics Discovery Showcase -->
  <section class="section pillar-showcase-section">
    <div class="container">
      <div class="section-header">
        <div>
          <span class="section-kicker">Topics</span>
          <h2 class="section-title">Explore topics</h2>
          <p class="section-subtitle">Browse stories across our main subjects</p>
        </div>
      </div>

      <div class="pillar-showcase-grid">
        {PILLAR_SLUGS.map((slug) => {
          const pillar = PILLARS[slug];
          return (
            <article class="pillar-card" style={`--pillar-color: ${pillar.color};`}>
              <div class="pillar-card-header">
                <PillarBadge pillar={slug} size="sm" asLink={false} />
              </div>
              <h3 class="pillar-card-title">{pillar.tagline}</h3>
              <p class="pillar-card-desc">{pillar.description}</p>
              <div class="pillar-card-footer">
                <a href={`/${pillar.slug}`} class="pillar-card-link">
                  <span>Explore {pillar.name}</span>
                  <span aria-hidden="true">&rarr;</span>
                </a>
              </div>
            </article>
          );
        })}
      </div>
    </div>
  </section>

  <!-- Apps & Tools Discovery Showcase -->
  <section class="section ecosystem-showcase-section">
    <div class="container">
      <div class="section-header">
        <div>
          <span class="section-kicker">From our projects</span>
          <h2 class="section-title">Apps & tools</h2>
          <p class="section-subtitle">Helpful tools and companion projects built by our team</p>
        </div>
      </div>

      <div class="grid-2">
        {ECOSYSTEM_PROJECTS.map((project) => (
          <EcosystemCard project={project} />
        ))}
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .hero-kicker-wrap {
    margin-bottom: 0.5rem;
  }

  .hero-pillar-ribbon {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    flex-wrap: wrap;
    padding-top: var(--space-5);
    border-top: 1px solid var(--color-border);
  }

  .ribbon-label {
    font-family: var(--font-sans);
    font-size: 0.75rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--color-text-muted);
  }

  .ribbon-badges {
    display: flex;
    gap: 0.85rem;
    flex-wrap: wrap;
  }

  .lead-single-wrap {
    max-width: 860px;
    margin: 0 auto;
  }

  .secondary-col {
    display: flex;
    flex-direction: column;
    gap: var(--space-6);
  }

  .secondary-header-kicker {
    font-family: var(--font-sans);
    font-size: 0.725rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: var(--color-text-muted);
    padding-bottom: var(--space-2);
    border-bottom: 1px solid var(--color-border);
  }

  .empty-state-editorial {
    padding: var(--space-16) var(--space-8);
    text-align: center;
    background-color: var(--color-surface-subtle);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-sm);
  }

  .empty-state-title {
    font-family: var(--font-display);
    font-size: 2rem;
    color: var(--color-text-primary);
    margin-top: 0.5rem;
    margin-bottom: 0.75rem;
  }

  .empty-state-text {
    color: var(--color-text-secondary);
    font-size: 1.05rem;
    line-height: 1.65;
    max-width: 560px;
    margin: 0 auto;
  }

  /* Pillar Showcase Section */
  .pillar-showcase-section {
    background-color: var(--color-surface-subtle);
    border-top: 1px solid var(--color-border);
    border-bottom: 1px solid var(--color-border);
  }

  .pillar-showcase-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: var(--space-6);
  }

  .pillar-card {
    background-color: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-sm);
    padding: 1.75rem;
    display: flex;
    flex-direction: column;
    transition: border-color var(--transition-fast), transform var(--transition-fast);
  }

  .pillar-card:hover {
    border-color: var(--color-border-hover);
    transform: translateY(-2px);
  }

  .pillar-card-header {
    margin-bottom: 0.75rem;
  }

  .pillar-card-title {
    font-family: var(--font-display);
    font-size: 1.25rem;
    font-weight: 600;
    color: var(--color-text-primary);
    margin-bottom: 0.5rem;
    line-height: 1.3;
  }

  .pillar-card-desc {
    font-size: 0.875rem;
    color: var(--color-text-secondary);
    line-height: 1.6;
    margin-bottom: 1.5rem;
    flex-grow: 1;
  }

  .pillar-card-footer {
    margin-top: auto;
    padding-top: 1rem;
    border-top: 1px solid var(--color-border-subtle);
  }

  .pillar-card-link {
    font-family: var(--font-sans);
    font-size: 0.775rem;
    font-weight: 700;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    color: var(--pillar-color, var(--color-olive));
    text-decoration: none;
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    transition: gap var(--transition-fast);
  }

  .pillar-card-link:hover {
    gap: 0.55rem;
  }

  /* Ecosystem Section */
  .ecosystem-showcase-section {
    padding-top: var(--space-12);
    padding-bottom: var(--space-16);
  }
</style>
