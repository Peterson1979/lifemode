---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import { CATEGORIES } from '../utils/categories';
import { isPubliclyVisibleGuide } from '../utils/guides';
import { isPubliclyVisiblePicksArticle, picksArticleSlug, getPicksArticleCategories } from '../utils/picks';
import { getAllPicksCategories } from '../utils/picks-categories';
import { listPublicOffers } from '../lib/commerce/offer-store';
import { getPrimaryProductImage } from '../lib/commerce/types';
import { LIFE_HACK_VIDEOS } from '../utils/life-hacks';

// 1. Picks Articles (up to 3, sorted newest first)
const allPicksArticles = await getCollection('picks', isPubliclyVisiblePicksArticle);
const picksArticles = allPicksArticles
  .sort((a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime())
  .slice(0, 3);

// Centralized Picks categories for homepage
const allPicksCategories = getAllPicksCategories();

// 2. Guide Categories with assigned images
const allGuides = await getCollection('guides', isPubliclyVisibleGuide);
const guideCategories = Object.values(CATEGORIES);

const defaultCategoryImages: Record<string, string> = {
  'food-kitchen': '/images/guides/pexels-kampus-8629103-52777aa1c3ba.jpg',
  'home-maintenance': '/images/guides/How-to-Prepare-Your-Home-for-W-5dfa9d167224.jpg',
  'cleaning-laundry': '/images/guides/washing-mahine-d04862495502.jpg',
  'home-organization': '/images/guides/Small-Kitchen-a4fa5f1b3ba9.jpg',
  'smart-home': '/images/guides/Wi-Fi-Thermostat-bcaf4c0d86a4.jpg',
  'home-garden': '/images/guides/Houseplant-Dying-ffef8ef3d3b3.jpg',
};

const categoryCards = guideCategories.map((cat) => {
  const guideWithImg = allGuides.find((g) => g.data.category === cat.id && g.data.image);
  const image = guideWithImg?.data.image || defaultCategoryImages[cat.id];
  return {
    ...cat,
    image,
  };
});

// 3. Practical Resources: Tools, Checklists, Life Hacks
const featuredLifeHack = LIFE_HACK_VIDEOS.find((v) => !v.hidden && v.thumbnail);
const resourceCards = [
  {
    title: 'Smart Tools',
    description: 'Interactive decision helpers, calculators, and diagnostic frameworks for everyday tasks.',
    href: '/tools/',
    icon: '🛠️',
    badge: 'Interactive Decision Helpers',
    image: null,
  },
  {
    title: 'Printable Checklists',
    description: 'Evidence-based routines, cleaning schedules, and seasonal home maintenance cheat sheets.',
    href: '/checklists/',
    icon: '📋',
    badge: 'Print-Friendly Routines',
    image: null,
  },
  {
    title: 'Life Hacks',
    description: 'Practical video solutions, quick fixes, and clever household shortcuts with zero fluff.',
    href: '/life-hacks/',
    icon: '🎬',
    badge: 'Video Solutions',
    image: featuredLifeHack?.thumbnail || null,
  },
];

// 4. Daily Ideas Store
const storeOffers = await listPublicOffers();
const featuredStoreProducts = storeOffers.slice(0, 3);
---

<BaseLayout
  title="LifeMode — Practical Tools, Checklists & Ideas for Modern Life"
  description="Practical answers for everyday decisions, problems, and tasks. Interactive tools, printable checklists, life hacks, and everyday ideas."
  canonicalUrl="https://lifemode.site/"
>
  <!-- 1. Hero Section -->
  <section class="hero-section">
    <div class="container hero-inner">
      <h1 class="hero-heading">
        Practical ideas for everyday life.
      </h1>

      <p class="hero-subheading">
        Useful guides, smart tools, checklists, and carefully selected recommendations to help you make better decisions.
      </p>

      <div class="hero-cta-wrapper">
        <a href="#picks" class="hero-cta-btn">
          <span>Explore LifeMode</span>
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M12 5v14"/>
            <path d="m19 12-7 7-7-7"/>
          </svg>
        </a>
      </div>
    </div>
  </section>

  <!-- 2. Prominent LifeMode Picks Section -->
  <section id="picks" class="picks-homepage-section">
    <div class="container">
      <div class="section-top-row">
        <div class="section-titles">
          <span class="section-kicker">Curated Recommendations</span>
          <h2 class="section-title">Discover LifeMode Picks</h2>
          <p class="section-desc">Thoughtful recommendations, useful products, and curated ideas for everyday life.</p>
        </div>
        <a href="/picks/" class="section-more-link">
          <span>Explore All Picks</span>
          <span aria-hidden="true">&rarr;</span>
        </a>
      </div>

      <!-- Published Picks Articles Grid (up to 3) -->
      {picksArticles.length > 0 && (
        <div class={`picks-articles-grid count-${picksArticles.length}`}>
          {picksArticles.map((article) => {
            const slug = picksArticleSlug(article.id);
            const cats = getPicksArticleCategories(article);
            const primaryCat = cats[0];
            return (
              <article class="picks-article-card">
                {article.data.image && (
                  <a href={`/picks/articles/${slug}/`} class="picks-card-image-wrap" tabindex="-1" aria-hidden="true">
                    <img
                      src={article.data.image}
                      alt={article.data.imageAlt || article.data.title}
                      class="picks-card-img"
                      loading="lazy"
                      decoding="async"
                    />
                  </a>
                )}
                <div class="picks-card-body">
                  {primaryCat && (
                    <div class="picks-card-cat-row">
                      <a
                        href={`/picks/category/${primaryCat.slug}/`}
                        class="picks-cat-tag"
                        style={`color: ${primaryCat.badgeColor}; background-color: ${primaryCat.lightBg}; border-color: ${primaryCat.borderColor};`}
                      >
                        <span>{primaryCat.icon}</span>
                        <span>{primaryCat.title}</span>
                      </a>
                    </div>
                  )}
                  <h3 class="picks-card-title">
                    <a href={`/picks/articles/${slug}/`}>{article.data.title}</a>
                  </h3>
                  <p class="picks-card-desc">{article.data.description}</p>
                  <div class="picks-card-footer">
                    <a href={`/picks/articles/${slug}/`} class="card-read-link">
                      <span>Read Guide</span>
                      <span aria-hidden="true">&rarr;</span>
                    </a>
                  </div>
                </div>
              </article>
            );
          })}
        </div>
      )}

      <!-- Compact Visual Category Navigation from Centralized Taxonomy -->
      <div class="picks-taxonomy-nav">
        <div class="taxonomy-nav-header">
          <span class="taxonomy-label">Browse Recommendations by Lifestyle Topic:</span>
        </div>
        <div class="picks-taxonomy-grid">
          {allPicksCategories.map((cat) => (
            <a
              href={`/picks/category/${cat.slug}/`}
              class="picks-topic-tile"
              style={`--topic-accent: ${cat.badgeColor}; --topic-bg: ${cat.lightBg}; --topic-border: ${cat.borderColor};`}
            >
              <span class="topic-tile-icon">{cat.icon}</span>
              <span class="topic-tile-title">{cat.shortTitle}</span>
            </a>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- 3. Guides Section -->
  <section class="guides-homepage-section">
    <div class="container">
      <div class="section-top-row">
        <div class="section-titles">
          <span class="section-kicker">In-Depth Walkthroughs</span>
          <h2 class="section-title">Practical Guides for Everyday Challenges</h2>
          <p class="section-desc">Evidence-based planning guides and step-by-step protocols across essential household domains.</p>
        </div>
        <a href="/guides/" class="section-more-link">
          <span>All Practical Guides</span>
          <span aria-hidden="true">&rarr;</span>
        </a>
      </div>

      <div class="guide-categories-grid">
        {categoryCards.map((category) => (
          <a href={`/${category.slug}/`} class="guide-cat-card" style={`--cat-accent: ${category.badgeColor};`}>
            {category.image && (
              <div class="guide-cat-img-wrapper">
                <img
                  src={category.image}
                  alt={`${category.title} Guides`}
                  class="guide-cat-img"
                  loading="lazy"
                  decoding="async"
                />
              </div>
            )}
            <div class="guide-cat-body">
              <div class="guide-cat-badge-row">
                <span class="guide-cat-icon">{category.icon}</span>
                <span class="guide-cat-name">{category.title}</span>
              </div>
              <p class="guide-cat-desc">{category.description}</p>
              <span class="guide-cat-action">Explore {category.shortTitle} &rarr;</span>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- 4. Practical Resources Section (Tools, Checklists, Life Hacks) -->
  <section class="resources-homepage-section">
    <div class="container">
      <div class="section-top-row">
        <div class="section-titles">
          <span class="section-kicker">Interactive & Visual</span>
          <h2 class="section-title">Practical Resources</h2>
          <p class="section-desc">Instant decision calculators, printable checklists, and fast video demonstrations.</p>
        </div>
      </div>

      <div class="resources-grid">
        {resourceCards.map((res) => (
          <a href={res.href} class="resource-card">
            {res.image ? (
              <div class="resource-img-wrap">
                <img src={res.image} alt={res.title} class="resource-card-img" loading="lazy" decoding="async" />
                <span class="resource-img-badge">{res.badge}</span>
              </div>
            ) : (
              <div class="resource-icon-wrap">
                <span class="resource-main-icon">{res.icon}</span>
                <span class="resource-text-badge">{res.badge}</span>
              </div>
            )}
            <div class="resource-card-body">
              <h3 class="resource-card-title">{res.title}</h3>
              <p class="resource-card-desc">{res.description}</p>
              <span class="resource-card-link">Open {res.title} &rarr;</span>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- 5. Daily Ideas Store Section -->
  <section class="store-homepage-section">
    <div class="container">
      <div class="store-banner-card">
        <div class="store-banner-text">
          <span class="section-kicker store-kicker">Everyday Essentials</span>
          <h2 class="store-title">Explore the Daily Ideas Store</h2>
          <p class="store-desc">Discover useful everyday products selected for practical living.</p>
          <a href="/daily-ideas/" class="btn btn-primary store-cta-btn">
            <span>Visit the Store</span>
            <span aria-hidden="true">&rarr;</span>
          </a>
        </div>
        {featuredStoreProducts.length > 0 && (
          <div class="store-preview-grid">
            {featuredStoreProducts.slice(0, 3).map((prod) => {
              const img = getPrimaryProductImage(prod);
              return (
                <a href="/daily-ideas/" class="store-mini-card">
                  {img && (
                    <div class="store-mini-img-wrap">
                      <img src={img.url} alt={img.alt || prod.title} class="store-mini-img" loading="lazy" decoding="async" />
                    </div>
                  )}
                  <span class="store-mini-name">{prod.name || prod.title}</span>
                </a>
              );
            })}
          </div>
        )}
      </div>
    </div>
  </section>

  <!-- Editorial Standards & Trust Banner (rendered after Apps & Tools by BaseLayout) -->
  <section slot="after-promotional-apps" class="trust-banner-section">
    <div class="container trust-banner-inner">
      <div class="trust-banner-col">
        <div class="trust-shield-icon">🛡️</div>
        <h3>Evidence-Based & Fact-Checked</h3>
        <p>Every tool and checklist references manufacturer guidelines, recognized testing standards, and practical evidence.</p>
      </div>
      <div class="trust-banner-col">
        <div class="trust-shield-icon">🚫</div>
        <h3>Zero AI Search Farm Content</h3>
        <p>No generic summaries, fake expertise, or filler. Human-reviewed clarity focused on practical everyday execution.</p>
      </div>
      <div class="trust-banner-col">
        <div class="trust-shield-icon">⚡</div>
        <h3>Fast, Static & Privacy-First</h3>
        <p>Zero tracking cookies required. Lightweight, instant page loads with Core Web Vitals optimization.</p>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  /* 1. Hero Section */
  .hero-section {
    background: linear-gradient(180deg, #ffffff 0%, var(--slate-50) 100%);
    border-bottom: 1px solid var(--slate-200);
    padding: 4rem 0 3.25rem;
  }

  .hero-inner {
    text-align: center;
    max-width: 860px;
  }

  .hero-heading {
    font-size: clamp(2.35rem, 5vw, 3.35rem);
    font-weight: 800;
    line-height: 1.15;
    letter-spacing: -0.03em;
    color: var(--slate-950);
    margin: 0 0 1rem;
  }

  .hero-subheading {
    max-width: 700px;
    margin: 0 auto 1.75rem;
    font-size: 1.1rem;
    color: var(--slate-600);
    line-height: 1.6;
  }

  .hero-cta-wrapper {
    display: flex;
    justify-content: center;
  }

  .hero-cta-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.75rem 1.75rem;
    font-size: 0.95rem;
    font-weight: 700;
    color: #ffffff;
    background-color: var(--color-primary-accent, #6366f1);
    border-radius: var(--radius-full, 9999px);
    text-decoration: none;
    box-shadow: 0 4px 14px rgba(99, 102, 241, 0.3);
    transition: all 0.2s ease;
  }

  .hero-cta-btn:hover {
    background-color: var(--color-primary-accent-hover, #4f46e5);
    transform: translateY(-2px);
    box-shadow: 0 6px 20px rgba(99, 102, 241, 0.4);
    text-decoration: none;
    color: #ffffff;
  }

  /* Shared Section Headers */
  .section-top-row {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    margin-bottom: var(--space-6, 1.5rem);
    flex-wrap: wrap;
    gap: 1rem;
  }

  .section-titles {
    max-width: 680px;
  }

  .section-kicker {
    display: inline-block;
    font-size: 0.75rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--color-primary-accent, #6366f1);
    margin-bottom: 0.35rem;
  }

  .section-title {
    font-size: clamp(1.75rem, 3vw, 2.25rem);
    font-weight: 800;
    line-height: 1.2;
    margin: 0 0 0.4rem;
    color: var(--slate-950);
  }

  .section-desc {
    font-size: 1rem;
    color: var(--slate-600);
    margin: 0;
    line-height: 1.55;
  }

  .section-more-link {
    font-size: 0.9rem;
    font-weight: 700;
    color: var(--color-primary-accent, #6366f1);
    text-decoration: none;
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    padding-bottom: 0.2rem;
    border-bottom: 2px solid transparent;
    transition: all 0.15s ease;
  }

  .section-more-link:hover {
    border-bottom-color: var(--color-primary-accent, #6366f1);
    text-decoration: none;
  }

  /* 2. Prominent LifeMode Picks Section */
  .picks-homepage-section {
    padding: 4.5rem 0 3.75rem;
    background-color: var(--slate-50, #f8fafc);
    border-bottom: 1px solid var(--color-border, #e2e8f0);
  }

  .picks-articles-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--space-6, 1.5rem);
    margin-bottom: 2.5rem;
  }

  .picks-articles-grid.count-1 {
    grid-template-columns: minmax(0, 720px);
    justify-content: center;
  }

  .picks-articles-grid.count-2 {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }

  .picks-article-card {
    background-color: var(--color-surface, #ffffff);
    border: 1px solid var(--color-border, #e2e8f0);
    border-radius: var(--radius-lg, 12px);
    overflow: hidden;
    display: flex;
    flex-direction: column;
    box-shadow: var(--shadow-sm, 0 1px 3px rgba(0, 0, 0, 0.05));
    transition: transform 0.2s ease, box-shadow 0.2s ease, border-color 0.2s ease;
  }

  .picks-article-card:hover {
    transform: translateY(-4px);
    box-shadow: 0 12px 24px -10px rgba(0, 0, 0, 0.1);
    border-color: var(--color-primary-accent, #6366f1);
  }

  .picks-card-image-wrap {
    display: block;
    aspect-ratio: 16 / 10;
    overflow: hidden;
    background-color: var(--slate-100, #f1f5f9);
  }

  .picks-card-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.3s ease;
  }

  .picks-article-card:hover .picks-card-img {
    transform: scale(1.03);
  }

  .picks-card-body {
    padding: 1.5rem;
    display: flex;
    flex-direction: column;
    flex-grow: 1;
  }

  .picks-card-cat-row {
    margin-bottom: 0.75rem;
  }

  .picks-cat-tag {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    font-size: 0.75rem;
    font-weight: 700;
    padding: 0.2rem 0.55rem;
    border-radius: var(--radius-full, 9999px);
    border: 1px solid transparent;
    text-decoration: none;
    transition: opacity 0.15s ease;
  }

  .picks-cat-tag:hover {
    opacity: 0.85;
    text-decoration: none;
  }

  .picks-card-title {
    font-size: 1.25rem;
    font-weight: 700;
    line-height: 1.35;
    margin: 0 0 0.5rem;
    color: var(--slate-950);
  }

  .picks-card-title a {
    color: inherit;
    text-decoration: none;
    transition: color 0.15s ease;
  }

  .picks-card-title a:hover {
    color: var(--color-primary-accent, #6366f1);
  }

  .picks-card-desc {
    font-size: 0.92rem;
    color: var(--slate-600);
    line-height: 1.55;
    margin: 0 0 1.25rem;
    flex-grow: 1;
  }

  .picks-card-footer {
    padding-top: 1rem;
    border-top: 1px solid var(--slate-100, #f1f5f9);
  }

  .card-read-link {
    font-size: 0.85rem;
    font-weight: 700;
    color: var(--color-primary-accent, #6366f1);
    text-decoration: none;
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    transition: gap 0.15s ease;
  }

  .picks-article-card:hover .card-read-link {
    gap: 0.55rem;
  }

  /* Compact Category Navigation Strip */
  .picks-taxonomy-nav {
    background-color: var(--color-surface, #ffffff);
    border: 1px solid var(--color-border, #e2e8f0);
    border-radius: var(--radius-lg, 12px);
    padding: 1.25rem 1.5rem;
  }

  .taxonomy-nav-header {
    margin-bottom: 0.85rem;
  }

  .taxonomy-label {
    font-size: 0.8rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--slate-500);
  }

  .picks-taxonomy-grid {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
  }

  .picks-topic-tile {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.45rem 0.85rem;
    border-radius: var(--radius-md, 8px);
    background-color: var(--topic-bg, #f1f5f9);
    border: 1px solid var(--topic-border, #e2e8f0);
    color: var(--topic-accent, var(--slate-800));
    font-size: 0.85rem;
    font-weight: 600;
    text-decoration: none;
    transition: all 0.15s ease;
  }

  .picks-topic-tile:hover {
    transform: translateY(-2px);
    box-shadow: 0 4px 10px rgba(0, 0, 0, 0.06);
    text-decoration: none;
  }

  .topic-tile-all {
    background-color: var(--slate-100, #f1f5f9);
    border-color: var(--slate-300, #cbd5e1);
    color: var(--slate-800);
  }

  /* 3. Guides Section */
  .guides-homepage-section {
    padding: 4.5rem 0;
    background-color: #ffffff;
    border-bottom: 1px solid var(--color-border, #e2e8f0);
  }

  .guide-categories-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--space-6, 1.5rem);
  }

  .guide-cat-card {
    background-color: var(--color-surface, #ffffff);
    border: 1px solid var(--color-border, #e2e8f0);
    border-radius: var(--radius-lg, 12px);
    overflow: hidden;
    display: flex;
    flex-direction: column;
    text-decoration: none;
    box-shadow: var(--shadow-sm, 0 1px 3px rgba(0, 0, 0, 0.05));
    transition: transform 0.2s ease, box-shadow 0.2s ease, border-color 0.2s ease;
  }

  .guide-cat-card:hover {
    transform: translateY(-4px);
    box-shadow: 0 12px 24px -10px rgba(0, 0, 0, 0.1);
    border-color: var(--cat-accent, var(--color-primary-accent));
    text-decoration: none;
  }

  .guide-cat-img-wrapper {
    aspect-ratio: 16 / 9;
    overflow: hidden;
    background-color: var(--slate-100, #f1f5f9);
  }

  .guide-cat-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.3s ease;
  }

  .guide-cat-card:hover .guide-cat-img {
    transform: scale(1.03);
  }

  .guide-cat-body {
    padding: 1.25rem 1.5rem 1.5rem;
    display: flex;
    flex-direction: column;
    flex-grow: 1;
  }

  .guide-cat-badge-row {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin-bottom: 0.5rem;
  }

  .guide-cat-icon {
    font-size: 1.25rem;
  }

  .guide-cat-name {
    font-size: 1.15rem;
    font-weight: 700;
    color: var(--slate-950);
  }

  .guide-cat-desc {
    font-size: 0.88rem;
    color: var(--slate-600);
    line-height: 1.5;
    margin: 0 0 1.25rem;
    flex-grow: 1;
  }

  .guide-cat-action {
    font-size: 0.85rem;
    font-weight: 700;
    color: var(--cat-accent, var(--color-primary-accent));
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
  }

  /* 4. Practical Resources Section */
  .resources-homepage-section {
    padding: 4.5rem 0;
    background-color: var(--slate-50, #f8fafc);
    border-bottom: 1px solid var(--color-border, #e2e8f0);
  }

  .resources-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--space-6, 1.5rem);
  }

  .resource-card {
    background-color: var(--color-surface, #ffffff);
    border: 1px solid var(--color-border, #e2e8f0);
    border-radius: var(--radius-lg, 12px);
