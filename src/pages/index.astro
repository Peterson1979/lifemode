---
import BaseLayout from '../layouts/BaseLayout.astro';
import { CATEGORIES } from '../utils/categories';

const categories = Object.values(CATEGORIES);
const homepageCategories = categories.filter((category) =>
  !['cleaning-laundry', 'storage-organization'].includes(category.id)
);
const utilityLinks = [
  { href: '/guides/', icon: '📖', title: 'Guides', description: 'Step-by-step answers.' },
  { href: '/tools/', icon: '🛠️', title: 'Tools', description: 'Interactive decision helpers.' },
  { href: '/checklists/', icon: '📋', title: 'Checklists', description: 'Print-friendly routines.' },
];
const topicLinks = [
  ...homepageCategories.map((category) => ({
    href: `/${category.slug}/`,
    icon: category.icon,
    title: category.title,
    description: category.description,
    color: category.badgeColor,
  })),
  {
    href: '/life-hacks/',
    icon: '🎬',
    title: 'Life Hacks',
    description: 'Practical video demonstrations for useful everyday improvements.',
    color: '#db2777',
  },
  {
    href: '/daily-ideas/',
    icon: '🛍️',
    title: 'Daily Ideas Store',
    description: 'A small set of practical recommendations selected for everyday use.',
    color: '#ea580c',
  },
];
---

<BaseLayout
  title="LifeMode — Practical Guides, Tools & Ideas for Modern Life"
  description="Practical answers for everyday decisions, problems, and tasks. High-quality reference guides, evidence-based care instructions, and interactive tools."
  canonicalUrl="https://lifemode.life/"
>
  <!-- Hero Section -->
  <section class="hero-section">
    <div class="container hero-inner">
      <div class="hero-badge">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
          <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>
          <path d="m9 12 2 2 4-4"/>
        </svg>
        <span>Authoritative Everyday Reference & Decision Library</span>
      </div>

      <h1 class="hero-heading">
        Everyday answers.<br />
        <span class="hero-highlight">Practical decisions.</span><br />
        Better ways to do things.
      </h1>

      <p class="hero-subheading">
        Clear, fact-checked reference guidance, evidence-based care protocols, and interactive decision tools for everyday household life.
      </p>

      <!-- Centerpiece Search Trigger Box -->
      <div class="hero-search-box">
        <button class="hero-search-btn" id="hero-open-search">
          <svg class="search-svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2">
            <circle cx="11" cy="11" r="8"/>
            <path d="m21 21-4.3-4.3"/>
          </svg>
          <span class="search-prompt">What are you trying to figure out? (e.g. coffee stain, cast iron, store rice...)</span>
          <kbd class="hero-kbd">/</kbd>
        </button>

        <div class="hero-quick-chips">
          <span class="chips-title">Frequent queries:</span>
          <button class="hero-chip" data-search="cast iron">🍳 Cast-Iron Pan Care</button>
          <button class="hero-chip" data-search="coffee stain">✨ Coffee Stain Removal</button>
          <button class="hero-chip" data-search="rice">🍚 Rice Storage Safety</button>
          <button class="hero-chip" data-search="winter">🏡 Winter Home Prep</button>
        </div>
      </div>
    </div>
  </section>

  <!-- Main topics -->
  <section class="clusters-section">
    <div class="container">
      <div class="section-header">
        <span class="section-badge">Explore LifeMode</span>
        <h2 class="section-title">Find the right place to start</h2>
        <p class="section-desc">Choose a practical topic for the problem, project, or idea you have in mind.</p>
      </div>

      <div class="clusters-grid">
        {topicLinks.map((topic) => (
          <a href={topic.href} class="cluster-hub-card" style={`--cat-color: ${topic.color};`}>
            <div class="cluster-card-top"><span class="cluster-icon">{topic.icon}</span></div>
            <h3 class="cluster-name">{topic.title}</h3>
            <p class="cluster-info">{topic.description}</p>
            <span class="cluster-card-link">Explore {topic.title} →</span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- Guides, tools, and checklists -->
  <section class="utility-nav-section" aria-labelledby="utility-nav-title">
    <div class="container">
      <div class="utility-nav-block">
        <div class="utility-nav-heading">
          <span class="section-badge">Practical resources</span>
          <h2 id="utility-nav-title">Guides, tools & checklists</h2>
        </div>
        <nav class="utility-nav-links" aria-label="Practical resources">
          {utilityLinks.map((item) => (
            <a href={item.href} class="utility-nav-link">
              <span class="utility-nav-icon" aria-hidden="true">{item.icon}</span>
              <span>
                <strong>{item.title}</strong>
                <small>{item.description}</small>
              </span>
              <span class="utility-nav-arrow" aria-hidden="true">→</span>
            </a>
          ))}
        </nav>
      </div>
    </div>
  </section>

  <!-- Editorial Standards & Trust Banner (rendered after Apps & Tools by BaseLayout) -->
  <section slot="after-promotional-apps" class="trust-banner-section">
    <div class="container trust-banner-inner">
      <div class="trust-banner-col">
        <div class="trust-shield-icon">🛡️</div>
        <h3>Evidence-Based & Fact-Checked</h3>
        <p>Every guide references agricultural extensions, manufacturer guidelines, and recognized testing standards.</p>
      </div>
      <div class="trust-banner-col">
        <div class="trust-shield-icon">🚫</div>
        <h3>Zero AI Search Farm Content</h3>
        <p>No generic summaries, fake expertise, or filler. Human-reviewed clarity focused on practical everyday execution.</p>
      </div>
      <div class="trust-banner-col">
        <div class="trust-shield-icon">⚡</div>
        <h3>Fast, Static & Privacy-First</h3>
        <p>Zero tracking cookies required. Lightweight, instant page loads with Core Web Vitals optimization.</p>
      </div>
    </div>
  </section>
</BaseLayout>

<script>
  const heroSearchBtn = document.getElementById('hero-open-search');
  const openSearchBtn = document.getElementById('open-search-btn');

  heroSearchBtn?.addEventListener('click', () => {
    openSearchBtn?.click();
  });

  document.querySelectorAll('.hero-chip').forEach(chip => {
    chip.addEventListener('click', () => {
      const q = chip.getAttribute('data-search') || '';
      openSearchBtn?.click();
      setTimeout(() => {
        const input = document.getElementById('global-search-input') as HTMLInputElement;
        if (input) {
          input.value = q;
          input.dispatchEvent(new Event('input'));
        }
      }, 100);
    });
  });
</script>

<style>
  /* Hero Section */
  .hero-section {
    background: linear-gradient(180deg, #ffffff 0%, var(--slate-50) 100%);
    border-bottom: 1px solid var(--slate-200);
    padding: 3.75rem 0 3rem;
  }

  .hero-inner {
    text-align: center;
    max-width: 860px;
  }

  .hero-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.8rem;
    font-weight: 700;
    color: var(--slate-700);
    background-color: #ffffff;
    border: 1px solid var(--slate-200);
    padding: 0.35rem 0.85rem;
    border-radius: var(--radius-full);
    margin-bottom: 1.5rem;
    box-shadow: var(--shadow-xs);
  }

  .hero-heading {
    font-size: clamp(2.35rem, 5vw, 3.35rem);
    font-weight: 800;
    line-height: 1.15;
    letter-spacing: -0.03em;
    color: var(--slate-950);
    margin: 0 0 1rem;
  }

  .hero-highlight {
    background: linear-gradient(135deg, var(--accent-blue) 0%, var(--accent-emerald) 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
  }

  .hero-subheading {
    max-width: 700px;
    margin: 0 auto 1.75rem;
    font-size: 1.1rem;
    color: var(--slate-600);
    line-height: 1.6;
  }

  /* Centerpiece Search */
  .hero-search-box {
    max-width: 640px;
    margin: 0 auto;
  }

  .hero-search-btn {
    width: 100%;
    display: flex;
    align-items: center;
    gap: 0.85rem;
    background-color: #ffffff;
    border: 2px solid var(--slate-300);
    border-radius: var(--radius-full);
    padding: 0.85rem 1.35rem;
    cursor: pointer;
    box-shadow: var(--shadow-md), 0 0 0 4px rgba(37, 99, 235, 0.05);
    transition: all var(--transition-normal);
  }

  .hero-search-btn:hover {
    border-color: var(--accent-blue);
    box-shadow: var(--shadow-lg), 0 0 0 6px rgba(37, 99, 235, 0.1);
    transform: translateY(-1px);
  }

  .search-svg {
    color: var(--accent-blue);
    flex-shrink: 0;
  }

  .search-prompt {
    font-family: var(--font-body);
    font-size: 1.05rem;
    color: var(--slate-500);
    text-align: left;
    flex-grow: 1;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .hero-kbd {
    background-color: var(--slate-100);
    border: 1px solid var(--slate-300);
    border-radius: var(--radius-sm);
    padding: 0.15rem 0.5rem;
    font-family: var(--font-mono);
    font-size: 0.85rem;
    font-weight: 700;
    color: var(--slate-600);
  }

  .hero-quick-chips {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    margin-top: 1rem;
  }

  .chips-title {
    font-size: 0.8rem;
    font-weight: 600;
    color: var(--slate-500);
  }

  .hero-chip {
    background-color: #ffffff;
    border: 1px solid var(--slate-200);
    border-radius: var(--radius-full);
    padding: 0.25rem 0.65rem;
    font-size: 0.8rem;
    font-weight: 500;
    color: var(--slate-700);
    cursor: pointer;
    transition: all var(--transition-fast);
  }

  .hero-chip:hover {
    background-color: var(--slate-100);
    border-color: var(--slate-300);
    color: var(--slate-900);
  }

  /* Section Headings */
  .section-header {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    max-width: 720px;
    margin: 0 auto 1.75rem;
  }

  .section-badge {
    display: inline-block;
    font-size: 0.75rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--slate-600);
    background-color: var(--slate-100);
    border: 1px solid var(--slate-200);
    padding: 0.2rem 0.6rem;
    border-radius: var(--radius-full);
    margin-bottom: 0.5rem;
  }

  .tools-badge { color: var(--accent-blue); background-color: var(--accent-blue-light); border-color: var(--accent-blue-border); }
  .guides-badge { color: var(--slate-700); background-color: var(--slate-100); border-color: var(--slate-200); }
  .check-badge { color: var(--accent-emerald); background-color: var(--accent-emerald-light); border-color: var(--accent-emerald-border); }

  .section-title {
    font-size: clamp(1.75rem, 3vw, 2.35rem);
    font-weight: 800;
    line-height: 1.2;
    margin: 0.15rem 0 0.45rem;
    color: var(--slate-950);
  }

  .section-desc {
    max-width: 620px;
    font-size: 0.95rem;
    line-height: 1.5;
    color: var(--slate-600);
    margin: 0;
  }

  /* Clusters Section */
  .clusters-section {
    padding: 3rem 0 2.75rem;
    background-color: #ffffff;
  }

  .clusters-grid {
    display: grid;
    grid-template-columns: repeat(6, minmax(0, 1fr));
    gap: 1rem;
  }

  .cluster-hub-card:nth-child(-n + 5) { grid-column: span 2; }
  .cluster-hub-card:nth-child(4) { grid-column: 2 / span 2; }
  .cluster-hub-card:nth-child(5) { grid-column: 4 / span 2; }

  .cluster-hub-card {
    background-color: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    min-height: 245px;
    padding: var(--space-6) var(--space-5);
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    text-decoration: none;
    box-shadow: var(--shadow-sm);
    transition: transform var(--transition-base), box-shadow var(--transition-base), border-color var(--transition-base);
    position: relative;
    overflow: hidden;
  }

  .cluster-hub-card::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 3px;
    background: linear-gradient(90deg, var(--cat-color, var(--color-primary-accent)), #7c3aed, #ec4899);
    opacity: 0.8;
  }

  .cluster-hub-card:hover {
    background-color: var(--color-surface);
    transform: translateY(-4px);
    box-shadow: var(--shadow-hover);
    border-color: var(--color-border-hover);
    text-decoration: none;
  }

  .cluster-card-top {
    display: flex;
    justify-content: center;
    align-items: center;
    margin-bottom: var(--space-4);
  }

  .cluster-icon {
    font-size: 2rem;
  }

  .cluster-count {
    font-size: 0.75rem;
    font-weight: 700;
    color: var(--slate-500);
    background-color: #ffffff;
    border: 1px solid var(--slate-200);
    padding: 0.15rem 0.5rem;
    border-radius: var(--radius-full);
  }

  .cluster-name {
    font-size: 1.3rem;
    font-weight: 700;
    line-height: 1.25;
    color: var(--color-text-primary);
    margin-top: 0;
    margin-bottom: var(--space-2);
  }

  .cluster-info {
    font-size: 0.9rem;
    color: var(--color-text-secondary);
    line-height: 1.55;
    margin: 0 0 var(--space-5);
    flex-grow: 1;
  }

  .cluster-topics-list {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    margin-bottom: 1rem;
    border-top: 1px solid var(--slate-200);
    padding-top: 0.75rem;
  }

  .cluster-mini-tag {
    font-size: 0.78rem;
    color: var(--slate-500);
  }

  .cluster-card-link {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    padding: 0.7rem 1rem;
    font-size: 0.85rem;
    font-weight: 700;
    color: var(--color-text-primary);
    background-color: var(--color-surface-subtle);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    margin-top: auto;
  }

  .cluster-hub-card:hover .cluster-card-link {
    color: #ffffff;
    background-color: var(--color-primary-accent);
    border-color: var(--color-primary-accent);
  }

  /* Compact utility navigation */
  .utility-nav-section {
    padding: 0 0 2.75rem;
    background-color: #ffffff;
  }

  .utility-nav-block {
    padding: var(--space-6) 0 0;
  }

  .utility-nav-heading {
    margin: 0 auto var(--space-5);
    text-align: center;
  }

  .utility-nav-heading h2 {
    margin: 0.4rem 0 0;
    font-size: clamp(1.65rem, 2.8vw, 2.25rem);
    font-weight: 800;
    line-height: 1.2;
    color: var(--color-text-primary);
  }

  .utility-nav-links {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--space-5);
  }

  .utility-nav-link {
    display: flex;
    position: relative;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 0.45rem;
    min-width: 0;
    min-height: 170px;
    padding: var(--space-6) var(--space-5);
    color: var(--color-text-primary);
    background-color: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-sm);
    text-decoration: none;
    text-align: center;
    transition: transform var(--transition-base), box-shadow var(--transition-base), border-color var(--transition-base);
    overflow: hidden;
  }

  .utility-nav-link::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 3px;
    background: linear-gradient(90deg, var(--color-primary-accent), #7c3aed, #ec4899);
    opacity: 0.8;
  }

  .utility-nav-link:hover {
    border-color: var(--color-border-hover);
    box-shadow: var(--shadow-hover);
    transform: translateY(-4px);
    text-decoration: none;
  }

  .utility-nav-icon { font-size: 2rem; }
  .utility-nav-link strong,
  .utility-nav-link small { display: block; }
  .utility-nav-link strong { font-size: 1.3rem; font-weight: 700; line-height: 1.25; }
  .utility-nav-link small { margin-top: 0.15rem; color: var(--color-text-secondary); font-size: 0.9rem; line-height: 1.5; }
  .utility-nav-arrow { position: absolute; top: 1rem; right: 1rem; color: var(--color-text-muted); }

  @media (max-width: 760px) {
    .hero-section { padding: 2.75rem 0 2.25rem; }
    .hero-subheading { font-size: 1rem; }
    .clusters-section { padding-top: 2.5rem; }
    .clusters-grid { grid-template-columns: 1fr; gap: 0.85rem; }
    .cluster-hub-card:nth-child(4),
    .cluster-hub-card:nth-child(5) { grid-column: auto; }
    .cluster-hub-card { min-height: 0; }
    .utility-nav-block { padding-top: var(--space-5); }
    .utility-nav-links { grid-template-columns: 1fr; }
    .utility-nav-link { min-height: 145px; }
  }

  /* Tools Showcase */
  .tools-showcase-section {
    padding: 4.5rem 0;
    background-color: var(--slate-50);
    border-top: 1px solid var(--slate-200);
    border-bottom: 1px solid var(--slate-200);
  }

  .tools-showcase-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(270px, 1fr));
    gap: 1.5rem;
    margin-bottom: 2rem;
  }

  .tool-showcase-card {
    background-color: #ffffff;
    border: 1px solid var(--slate-200);
    border-radius: var(--radius-lg);
    padding: 1.6rem;
    display: flex;
    flex-direction: column;
    box-shadow: var(--shadow-xs);
    transition: all var(--transition-normal);
  }

  .tool-showcase-card:hover {
    transform: translateY(-3px);
    box-shadow: var(--shadow-md);
  }

  .tool-showcase-meta {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 0.75rem;
  }

  .tool-badge-pill {
    background-color: var(--accent-blue-light);
    color: var(--accent-blue);
  }

  .tool-cat-badge {
    font-size: 0.75rem;
    font-weight: 600;
    color: var(--slate-500);
  }

  .tool-showcase-title {
    font-size: 1.2rem;
    margin-top: 0;
    margin-bottom: 0.4rem;
  }

  .tool-showcase-title a {
    color: var(--slate-900);
    text-decoration: none;
  }

  .tool-showcase-title a:hover {
    color: var(--accent-blue);
    text-decoration: underline;
  }

  .tool-showcase-summary {
    font-size: 0.9rem;
    color: var(--slate-600);
    line-height: 1.5;
    margin-bottom: 1.25rem;
    flex-grow: 1;
  }

  .tool-launch-btn {
    width: 100%;
  }

  .section-footer-link {
    text-align: center;
    margin-top: 1.5rem;
  }

  /* Guides Showcase */
  .guides-showcase-section {
    padding: 4.5rem 0;
    background-color: #ffffff;
  }

  .type-pill {
    font-size: 0.75rem;
    font-weight: 600;
    color: var(--slate-500);
  }

  /* Checklists Showcase */
  .checklists-showcase-section {
    padding: 4.5rem 0;
    background-color: var(--slate-50);
    border-top: 1px solid var(--slate-200);
    border-bottom: 1px solid var(--slate-200);
  }

  .checklists-showcase-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
    gap: 1.5rem;
  }

  .chk-showcase-card {
    background-color: #ffffff;
    border: 1px solid var(--slate-200);
    border-radius: var(--radius-lg);
    padding: 1.6rem;
    display: flex;
    flex-direction: column;
    box-shadow: var(--shadow-xs);
  }

  .chk-meta {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 0.75rem;
  }

  .chk-pill {
    background-color: var(--accent-emerald-light);
    color: var(--accent-emerald);
  }

  .chk-cat {
    font-size: 0.75rem;
    font-weight: 600;
    color: var(--slate-500);
  }

  .chk-title {
    font-size: 1.25rem;
    margin-top: 0;
    margin-bottom: 0.4rem;
  }

  .chk-title a {
    color: var(--slate-900);
    text-decoration: none;
  }

  .chk-title a:hover {
    color: var(--accent-blue);
    text-decoration: underline;
  }

  .chk-summary {
    font-size: 0.92rem;
    color: var(--slate-600);
    line-height: 1.5;
    margin-bottom: 1.25rem;
    flex-grow: 1;
  }

  .chk-btn {
    width: 100%;
  }

  /* Trust Banner */
  .trust-banner-section {
    padding: 2.75rem 0;
    background-color: #ffffff;
  }

  .trust-banner-inner {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
    gap: 1.5rem;
  }

  .trust-banner-col {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
  }

  .trust-shield-icon {
    font-size: 1.75rem;
    margin-bottom: 0.5rem;
  }

  .trust-banner-col h3 {
    font-size: 1.05rem;
    color: var(--slate-900);
    margin-top: 0;
    margin-bottom: 0.4rem;
  }

  .trust-banner-col p {
    max-width: 320px;
    font-size: 0.84rem;
    color: var(--slate-600);
    line-height: 1.5;
    margin: 0;
  }

  @media (max-width: 760px) {
    .trust-banner-section { padding: 2.25rem 0; }
  }
</style>
