---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import { CATEGORIES } from '../../utils/categories';
import { getCanonicalUrl, generateBreadcrumbSchema } from '../../utils/seo';

const checklists = await getCollection('checklists');

const breadcrumbs = [
  { label: 'Home', url: '/' },
  { label: 'Checklists & Printables', url: '/checklists/' },
];

const canonicalUrl = getCanonicalUrl('/checklists');

const breadcrumbSchema = generateBreadcrumbSchema([
  { name: 'Home', url: '/' },
  { name: 'Checklists & Printables', url: '/checklists' },
]);
---

<BaseLayout
  title="Printable Checklists & Interactive Cheat Sheets — LifeMode"
  description="Free printable home maintenance checklists, deep cleaning cheat sheets, pantry organization guides, and seasonal checklists."
  canonicalUrl={canonicalUrl}
  jsonLd={breadcrumbSchema}
>
  <div class="container checklists-directory-wrapper">
    <Breadcrumbs items={breadcrumbs} />

    <header class="directory-header">
      <span class="badge directory-badge">Printable &amp; Interactive</span>
      <h1 class="directory-title">Everyday Checklists &amp; Practical Cheat Sheets</h1>
      <p class="directory-subtitle">
        Structured task checklists with browser progress tracking, local storage persistence, and clean print styling for home and household management.
      </p>
    </header>

    <div class="checklists-grid">
      {checklists.map((chk) => {
        const cat = CATEGORIES[chk.data.category];
        const slug = chk.id.replace(/\.[^/.]+$/, '');
        const taskCount = chk.data.sections.reduce((acc, s) => acc + s.items.length, 0);

        return (
          <div class="checklist-directory-card">
            <div class="card-meta">
              <span class="badge checklist-pill">📋 {taskCount} Steps / Tasks</span>
              {cat && (
                <span class="cat-pill" style={`color: ${cat.badgeColor}; background-color: ${cat.lightBg};`}>
                  {cat.icon} {cat.title}
                </span>
              )}
            </div>
            <h2 class="card-title">
              <a href={`/checklists/${slug}/`}>{chk.data.title}</a>
            </h2>
            <p class="card-summary">{chk.data.summary}</p>
            <div class="card-footer">
              <a href={`/checklists/${slug}/`} class="btn btn-outline" style="font-size: 0.85rem;">Open &amp; Print Checklist &rarr;</a>
            </div>
          </div>
        );
      })}
    </div>
  </div>
</BaseLayout>

<style>
  .checklists-directory-wrapper {
    padding-top: var(--space-8);
    padding-bottom: var(--space-20);
  }

  .directory-header {
    margin-bottom: var(--space-10);
  }

  .directory-badge {
    display: inline-block;
    background-color: rgba(5, 150, 105, 0.1);
    color: #059669;
    border: 1px solid rgba(5, 150, 105, 0.2);
    font-size: 0.75rem;
    font-weight: 700;
    padding: 0.25rem 0.65rem;
    border-radius: var(--radius-full);
    margin-bottom: var(--space-3);
  }

  .directory-title {
    font-family: var(--font-display);
    font-size: clamp(2rem, 4vw, 2.75rem);
    font-weight: 700;
    color: var(--color-text-primary);
    margin-bottom: var(--space-3);
  }

  .directory-subtitle {
    font-size: 1.15rem;
    color: var(--color-text-secondary);
    line-height: 1.6;
    max-width: 780px;
    margin: 0;
  }

  .checklists-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(340px, 1fr));
    gap: var(--space-6);
  }

  .checklist-directory-card {
    background-color: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    padding: var(--space-6);
    display: flex;
    flex-direction: column;
    box-shadow: var(--shadow-sm);
    transition: all var(--transition-base);
  }

  .checklist-directory-card:hover {
    transform: translateY(-3px);
    box-shadow: var(--shadow-card);
    border-color: var(--color-border-hover);
  }

  .card-meta {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: var(--space-3);
  }

  .checklist-pill {
    background-color: rgba(5, 150, 105, 0.1);
    color: #059669;
    font-size: 0.75rem;
    font-weight: 700;
    padding: 0.2rem 0.55rem;
    border-radius: var(--radius-full);
  }

  .cat-pill {
    font-size: 0.75rem;
    font-weight: 700;
    padding: 0.2rem 0.55rem;
    border-radius: var(--radius-full);
  }

  .card-title {
    font-family: var(--font-display);
    font-size: 1.35rem;
    font-weight: 700;
    margin-top: 0;
    margin-bottom: var(--space-2);
  }

  .card-title a {
    color: var(--color-text-primary);
    text-decoration: none;
  }

  .card-title a:hover {
    color: var(--color-primary-accent);
    text-decoration: underline;
  }

  .card-summary {
    font-size: 0.95rem;
    color: var(--color-text-secondary);
    line-height: 1.6;
    margin-bottom: var(--space-6);
    flex-grow: 1;
  }

  .card-footer {
    border-top: 1px solid var(--color-border-subtle);
    padding-top: var(--space-4);
    margin-top: auto;
  }
</style>
