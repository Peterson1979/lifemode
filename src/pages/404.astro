---
import BaseLayout from '../layouts/BaseLayout.astro';
import { PILLARS, PILLAR_SLUGS } from '../config/site';
---

<BaseLayout
  title="Page Not Found — LifeMode"
  description="The requested article or page could not be located."
>
  <div class="page-shell container-prose" style="text-align: center; padding-top: var(--space-20); padding-bottom: var(--space-20);">
    <span class="hero-tag" style="color: var(--pillar-life);">Error 404</span>
    <h1 class="page-title" style="margin-top: var(--space-2); margin-bottom: var(--space-4); font-size: 2.75rem;">
      Page not found
    </h1>
    <p class="page-lead" style="margin-left: auto; margin-right: auto; max-width: 540px; margin-bottom: var(--space-8);">
      The page or article you were looking for does not exist, has been moved, or is temporarily unavailable.
    </p>

    <div style="margin-bottom: var(--space-12);">
      <a
        href="/"
        class="btn btn-primary"
      >
        &larr; Return to Homepage
      </a>
    </div>

    <div style="border-top: 1px solid var(--color-border); padding-top: var(--space-8); text-align: left;">
      <h2 style="font-size: 1.25rem; font-weight: 700; margin-bottom: var(--space-5); text-align: center;">
        Explore Topics
      </h2>
      <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: var(--space-4);">
        {PILLAR_SLUGS.map((slug) => {
          const pillar = PILLARS[slug];
          return (
            <a
              href={`/${pillar.slug}`}
              style="padding: var(--space-4); background-color: var(--color-surface); border: 1px solid var(--color-border); border-radius: var(--radius-md); box-shadow: var(--shadow-sm); text-decoration: none; display: flex; flex-direction: column; transition: transform var(--transition-fast), border-color var(--transition-fast);"
            >
              <span style={`font-weight: 800; color: ${pillar.color}; font-size: 0.95rem; text-transform: uppercase; letter-spacing: 0.05em;`}>
                {pillar.name}
              </span>
              <span style="font-size: 0.8rem; color: var(--color-text-muted); margin-top: 0.25rem; line-height: 1.4;">
                {pillar.tagline}
              </span>
            </a>
          );
        })}
      </div>
    </div>
  </div>
</BaseLayout>
