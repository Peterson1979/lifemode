---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import { CATEGORIES, CATEGORY_KEYS } from '../../utils/categories';
import { getCanonicalUrl, generateBreadcrumbSchema } from '../../utils/seo';

export async function getStaticPaths() {
  return CATEGORY_KEYS.map((catKey) => ({
    params: { category: catKey },
    props: { categoryKey: catKey },
  }));
}

const { categoryKey } = Astro.props;
const category = CATEGORIES[categoryKey];

const [allGuides, allTools, allChecklists] = await Promise.all([
  getCollection('guides', (g) => g.data.category === categoryKey),
  getCollection('tools', (t) => t.data.category === categoryKey),
  getCollection('checklists', (c) => c.data.category === categoryKey),
]);

const canonicalUrl = getCanonicalUrl(`/${category.slug}`);

const breadcrumbs = [
  { label: 'Home', url: '/' },
  { label: category.title, url: `/${category.slug}/` },
];

const breadcrumbSchema = generateBreadcrumbSchema([
  { name: 'Home', url: '/' },
  { name: category.title, url: `/${category.slug}` },
]);
---

<BaseLayout
  title={`${category.title} Practical Reference & Decision Guides — LifeMode`}
  description={category.metaDescription}
  canonicalUrl={canonicalUrl}
  jsonLd={breadcrumbSchema}
>
  <div class="container category-page-wrapper">
    <Breadcrumbs items={breadcrumbs} />

    <!-- Category Header Hero -->
    <header class="category-header-card" style={`border-top: 4px solid ${category.badgeColor};`}>
      <div class="cat-icon-lg">{category.icon}</div>
      <div class="cat-header-text">
        <span class="badge cat-badge" style={`color: ${category.badgeColor}; background-color: ${category.lightBg};`}>
          Knowledge Cluster
        </span>
        <h1 class="cat-title">{category.title}</h1>
        <p class="cat-description">{category.description}</p>
      </div>
    </header>

    <!-- Popular Topic Tags -->
    {category.popularTopics && category.popularTopics.length > 0 && (
      <div class="topic-chips-bar">
        <span class="topic-label">Core Topics:</span>
        <div class="chips-list">
          {category.popularTopics.map((topic) => (
            <span class="topic-chip">{topic}</span>
          ))}
        </div>
      </div>
    )}

    <!-- Category Interactive Tools & Checklists Spotlight -->
    {(allTools.length > 0 || allChecklists.length > 0) && (
      <section class="cat-utilities-section">
        <h2 class="section-title">
          <span>🛠️</span> {category.title} Interactive Tools &amp; Checklists
        </h2>
        <div class="utilities-grid">
          {allTools.map((tool) => (
            <a href={`/tools/${tool.id.replace(/\.[^/.]+$/, '')}/`} class="utility-card tool-card">
              <span class="utility-badge">🛠️ Interactive Tool</span>
              <h3>{tool.data.title}</h3>
              <p>{tool.data.summary}</p>
              <span class="utility-link-text">Launch Tool &rarr;</span>
            </a>
          ))}
          {allChecklists.map((chk) => (
            <a href={`/checklists/${chk.id.replace(/\.[^/.]+$/, '')}/`} class="utility-card check-card">
              <span class="utility-badge">📋 Printable Checklist</span>
              <h3>{chk.data.title}</h3>
              <p>{chk.data.summary}</p>
              <span class="utility-link-text">View Checklist &rarr;</span>
            </a>
          ))}
        </div>
      </section>
    )}

    <!-- All Reference & Decision Guides in this Cluster -->
    <section class="cat-guides-section">
      <h2 class="section-title">
        <span>📖</span> Reference &amp; Decision Guides ({allGuides.length})
      </h2>

      {allGuides.length === 0 ? (
        <p class="empty-text">New verified guides in {category.title} are currently being researched and added.</p>
      ) : (
        <div class="guide-grid">
          {allGuides.map((guide) => {
            const slug = guide.id.replace(/\.[^/.]+$/, '');
            return (
              <a href={`/${guide.data.category}/${slug}/`} class="guide-card">
                <div class="card-meta-top">
                  <span class="badge" style={`color: ${category.badgeColor}; background-color: ${category.lightBg};`}>
                    {guide.data.contentType === 'decision' ? '⚖️ Decision Guide' : '📖 Reference'}
                  </span>
                  {guide.data.difficulty && (
                    <span class="diff-badge">{guide.data.difficulty}</span>
                  )}
                </div>
                <h3>{guide.data.title}</h3>
                <p>{guide.data.quickSummary}</p>
                <div class="guide-card-footer">
                  <span>⏱️ {guide.data.readTime || '4 min read'}</span>
                  <span>Verified: {guide.data.updatedDate}</span>
                </div>
              </a>
            );
          })}
        </div>
      )}
    </section>
  </div>
</BaseLayout>

<style>
  .category-page-wrapper {
    padding-top: var(--space-8);
    padding-bottom: var(--space-20);
  }

  .category-header-card {
    background-color: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    padding: var(--space-8);
    display: flex;
    align-items: flex-start;
    gap: var(--space-6);
    box-shadow: var(--shadow-sm);
    margin-bottom: var(--space-8);
  }

  .cat-icon-lg {
    font-size: 3rem;
    background-color: var(--color-surface-subtle);
    border: 1px solid var(--color-border);
    width: 4.5rem;
    height: 4.5rem;
    border-radius: var(--radius-lg);
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }

  .cat-header-text {
    flex-grow: 1;
  }

  .cat-badge {
    display: inline-block;
    font-size: 0.75rem;
    font-weight: 700;
    padding: 0.25rem 0.65rem;
    border-radius: var(--radius-full);
    margin-bottom: var(--space-2);
  }

  .cat-title {
    font-family: var(--font-display);
    font-size: clamp(1.8rem, 3.5vw, 2.5rem);
    color: var(--color-text-primary);
    margin-bottom: var(--space-2);
  }

  .cat-description {
    font-size: 1.1rem;
    color: var(--color-text-secondary);
    line-height: 1.6;
    margin-bottom: 0;
  }

  .topic-chips-bar {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.75rem;
    margin-bottom: var(--space-10);
    padding: var(--space-4) var(--space-5);
    background-color: var(--color-surface-subtle);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
  }

  .topic-label {
    font-size: 0.8rem;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--color-text-muted);
  }

  .chips-list {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .topic-chip {
    background-color: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-full);
    padding: 0.25rem 0.75rem;
    font-size: 0.85rem;
    color: var(--color-text-primary);
    font-weight: 500;
  }

  .cat-utilities-section {
    margin-bottom: var(--space-12);
  }

  .section-title {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin-bottom: var(--space-5);
    font-family: var(--font-display);
    font-size: 1.5rem;
    font-weight: 700;
    color: var(--color-text-primary);
  }

  .utilities-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    gap: var(--space-5);
  }

  .utility-card {
    background-color: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    padding: var(--space-6);
    text-decoration: none;
    display: flex;
    flex-direction: column;
    box-shadow: var(--shadow-sm);
    transition: all var(--transition-base);
  }

  .utility-card:hover {
    transform: translateY(-3px);
    box-shadow: var(--shadow-card);
    text-decoration: none;
  }

  .tool-card { border-left: 4px solid var(--color-primary-accent); }
  .check-card { border-left: 4px solid #059669; }

  .utility-badge {
    font-size: 0.75rem;
    font-weight: 700;
    color: var(--color-text-muted);
    margin-bottom: 0.5rem;
  }

  .utility-card h3 {
    font-family: var(--font-sans);
    font-size: 1.2rem;
    font-weight: 700;
    color: var(--color-text-primary);
    margin-top: 0;
    margin-bottom: 0.4rem;
  }

  .utility-card p {
    font-size: 0.95rem;
    color: var(--color-text-secondary);
    margin-bottom: 1rem;
    flex-grow: 1;
  }

  .utility-link-text {
    font-size: 0.88rem;
    font-weight: 700;
    color: var(--color-primary-accent);
  }

  .guide-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
    gap: var(--space-6);
  }

  .guide-card {
    background-color: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    padding: var(--space-6);
    text-decoration: none;
    display: flex;
    flex-direction: column;
    box-shadow: var(--shadow-sm);
    transition: all var(--transition-base);
  }

  .guide-card:hover {
    transform: translateY(-3px);
    box-shadow: var(--shadow-card);
    border-color: var(--color-border-hover);
    text-decoration: none;
  }

  .card-meta-top {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 0.75rem;
  }

  .diff-badge {
    font-size: 0.75rem;
    font-weight: 600;
    color: var(--color-text-muted);
  }

  .guide-card h3 {
    font-family: var(--font-display);
    font-size: 1.25rem;
    font-weight: 700;
    color: var(--color-text-primary);
    margin-top: 0;
    margin-bottom: 0.5rem;
    line-height: 1.3;
  }

  .guide-card p {
    font-size: 0.92rem;
    color: var(--color-text-secondary);
    line-height: 1.55;
    margin-bottom: 1rem;
    flex-grow: 1;
  }

  .guide-card-footer {
    display: flex;
    justify-content: space-between;
    font-size: 0.78rem;
    color: var(--color-text-muted);
    border-top: 1px solid var(--color-border-subtle);
    padding-top: 0.75rem;
  }

  .empty-text {
    font-size: 1rem;
    color: var(--color-text-muted);
    font-style: italic;
  }
</style>
