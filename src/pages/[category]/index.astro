---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import { CATEGORIES, CATEGORY_KEYS } from '../../utils/categories';
import { getCanonicalUrl, generateBreadcrumbSchema } from '../../utils/seo';
import { isPubliclyVisibleGuide, guideSlug } from '../../utils/guides';

export async function getStaticPaths() {
  return CATEGORY_KEYS.map((catKey) => ({
    params: { category: catKey },
    props: { categoryKey: catKey },
  }));
}

const { categoryKey } = Astro.props;
const category = CATEGORIES[categoryKey];

const legacyToolSlugs = new Set(['protein-intake-calculator', 'zone-2-heart-rate-calculator']);

const [allGuides, allTools, allChecklists] = await Promise.all([
  getCollection('guides', (g: any) =>
    isPubliclyVisibleGuide(g) && g.data.category === categoryKey
  ).catch(() => []),
  getCollection('tools', (t: any) =>
    t.data.category === categoryKey && !legacyToolSlugs.has(t.id.replace(/\.[^/.]+$/, ''))
  ).catch(() => []),
  getCollection('checklists', (c: any) => c.data.category === categoryKey).catch(() => []),
]);

const sortedGuides = allGuides.sort(
  (a: any, b: any) => b.data.pubDate.getTime() - a.data.pubDate.getTime()
);

const canonicalUrl = getCanonicalUrl(`/${category.slug}`);

const breadcrumbs = [
  { label: 'Home', url: '/' },
  { label: category.title, url: `/${category.slug}/` },
];

const breadcrumbSchema = generateBreadcrumbSchema([
  { name: 'Home', url: '/' },
  { name: category.title, url: `/${category.slug}` },
]);

const hasResources = sortedGuides.length > 0 || allTools.length > 0 || allChecklists.length > 0;
---

<BaseLayout
  title={`${category.title} Practical Guides, Tools & Checklists — LifeMode`}
  description={category.metaDescription}
  canonicalUrl={canonicalUrl}
  jsonLd={breadcrumbSchema}
>
  <div class="container category-page-wrapper">
    <Breadcrumbs items={breadcrumbs} />

    <!-- Category Header Hero -->
    <header class="category-header-card" style={`border-top: 4px solid ${category.badgeColor};`}>
      <div class="cat-icon-lg">{category.icon}</div>
      <div class="cat-header-text">
        <h1 class="cat-title">{category.title}</h1>
        <p class="cat-description">{category.description}</p>
      </div>
    </header>

    <!-- Guides Section -->
    {sortedGuides.length > 0 && (
      <section class="cat-section">
        <div class="cat-section-header">
          <h2 class="section-title">
            <span>📖</span> {category.title} Guides
          </h2>
          <p class="section-subtitle">Comprehensive, evidence-based planning guides from initial assessment to actionable project plans.</p>
        </div>
        <div class="guide-grid">
          {sortedGuides.map((guide) => {
            const slug = guideSlug(guide.id);
            return (
              <a href={`/guides/${slug}/`} class="guide-card" style={`--accent-color: ${category.badgeColor};`}>
                {guide.data.readingTime && (
                  <div class="card-meta-top">
                    <span class="reading-time">⏱️ {guide.data.readingTime}</span>
                  </div>
                )}
                <h3>{guide.data.title}</h3>
                <p>{guide.data.description || guide.data.quickSummary}</p>
                <div class="guide-card-footer">
                  <span class="card-author">By {guide.data.author}</span>
                  <span class="read-link">Read Guide &rarr;</span>
                </div>
              </a>
            );
          })}
        </div>
      </section>
    )}

    <!-- Interactive Tools Section -->
    {allTools.length > 0 && (
      <section class="cat-section">
        <div class="cat-section-header">
          <h2 class="section-title">
            <span>🛠️</span> {category.title} Tools
          </h2>
          <p class="section-subtitle">Privacy-preserving calculators and customized decision assistants.</p>
        </div>
        <div class="utilities-grid">
          {allTools.map((tool) => {
            const slug = tool.id.replace(/\.[^/.]+$/, '');
            return (
              <a href={`/tools/${slug}/`} class="utility-card tool-card">
                <h3>{tool.data.title}</h3>
                <p>{tool.data.summary}</p>
                <span class="utility-link-text">Launch Tool &rarr;</span>
              </a>
            );
          })}
        </div>
      </section>
    )}

    <!-- Printable Checklists Section -->
    {allChecklists.length > 0 && (
      <section class="cat-section">
        <div class="cat-section-header">
          <h2 class="section-title">
            <span>📋</span> {category.title} Checklists
          </h2>
          <p class="section-subtitle">Printable routine cheat sheets with browser progress tracking.</p>
        </div>
        <div class="utilities-grid">
          {allChecklists.map((chk) => {
            const slug = chk.id.replace(/\.[^/.]+$/, '');
            const taskCount = chk.data.sections.reduce((acc: number, s: any) => acc + s.items.length, 0);
            return (
              <a href={`/checklists/${slug}/`} class="utility-card check-card">
                <span class="utility-badge">📋 {taskCount} Tasks</span>
                <h3>{chk.data.title}</h3>
                <p>{chk.data.summary}</p>
                <span class="utility-link-text">View Checklist &rarr;</span>
              </a>
            );
          })}
        </div>
      </section>
    )}

    <!-- Empty State for Categories in Preparation -->
    {!hasResources && (
      <section class="category-empty-state">
        <div class="empty-icon-large">{category.icon}</div>
        <h2 class="empty-title">{category.title} Hub in Editorial Development</h2>
        <p class="empty-lead">
          Our editorial team is currently developing authoritative, evidence-based guides, decision tools, and printable checklists for {category.title} according to our fact-checking standards.
        </p>
        <p class="empty-sub">
          We strictly adhere to a zero-filler policy: content is published only when thoroughly tested, researched against primary sources, and verified for practical utility.
        </p>

        <div class="empty-navigation-box">
          <span class="empty-nav-heading">Explore our active practical categories and resources:</span>
          <div class="empty-links-list">
            <a href="/food-kitchen/" class="empty-pill-link">🍳 Food &amp; Kitchen</a>
            <a href="/home-maintenance/" class="empty-pill-link">🔧 Home Maintenance</a>
            <a href="/cleaning-laundry/" class="empty-pill-link">✨ Cleaning &amp; Laundry</a>
            <a href="/home-organization/" class="empty-pill-link">📦 Home Organization</a>
            <a href="/tools/" class="empty-pill-link">🛠️ All Interactive Tools</a>
            <a href="/checklists/" class="empty-pill-link">📋 All Checklists</a>
          </div>
        </div>
      </section>
    )}
  </div>
</BaseLayout>

<style>
  .category-page-wrapper {
    padding-top: var(--space-8);
    padding-bottom: var(--space-20);
  }

  .category-header-card {
    background-color: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    padding: var(--space-8);
    display: flex;
    align-items: flex-start;
    gap: var(--space-6);
    box-shadow: var(--shadow-sm);
    margin-bottom: var(--space-8);
  }

  .cat-icon-lg {
    font-size: 3rem;
    background-color: var(--color-surface-subtle);
    border: 1px solid var(--color-border);
    width: 4.5rem;
    height: 4.5rem;
    border-radius: var(--radius-lg);
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }

  .cat-header-text {
    flex-grow: 1;
  }

  .cat-badge {
    display: inline-block;
    font-size: 0.75rem;
    font-weight: 700;
    padding: 0.25rem 0.65rem;
    border-radius: var(--radius-full);
    margin-bottom: var(--space-2);
  }

  .cat-title {
    font-family: var(--font-display);
    font-size: clamp(1.8rem, 3.5vw, 2.5rem);
    color: var(--color-text-primary);
    margin-bottom: var(--space-2);
  }

  .cat-description {
    font-size: 1.1rem;
    color: var(--color-text-secondary);
    line-height: 1.6;
    margin-bottom: 0;
  }

  .topic-chips-bar {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.75rem;
    margin-bottom: var(--space-10);
    padding: var(--space-4) var(--space-5);
    background-color: var(--color-surface-subtle);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
  }

  .topic-label {
    font-size: 0.8rem;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--color-text-muted);
  }

  .chips-list {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .topic-chip {
    background-color: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-full);
    padding: 0.25rem 0.75rem;
    font-size: 0.85rem;
    color: var(--color-text-primary);
    font-weight: 500;
  }

  .cat-section {
    margin-bottom: var(--space-12);
  }

  .cat-section-header {
    margin-bottom: var(--space-6);
  }

  .cat-section-badge {
    display: inline-block;
    font-size: 0.72rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--color-text-muted);
    margin-bottom: 0.35rem;
  }

  .section-title {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin-top: 0;
    margin-bottom: 0.35rem;
    font-family: var(--font-display);
    font-size: 1.5rem;
    font-weight: 700;
    color: var(--color-text-primary);
  }

  .section-subtitle {
    font-size: 0.95rem;
    color: var(--color-text-secondary);
    margin-bottom: 0;
  }

  .guide-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
    gap: var(--space-6);
  }

  .guide-card {
    background-color: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    padding: var(--space-6);
    text-decoration: none;
    display: flex;
    flex-direction: column;
    box-shadow: var(--shadow-sm);
    transition: all var(--transition-base);
  }

  .guide-card:hover {
    transform: translateY(-3px);
    box-shadow: var(--shadow-card);
    border-color: var(--color-border-hover);
    text-decoration: none;
  }

  .card-meta-top {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 0.75rem;
  }

  .guide-pill {
    font-size: 0.72rem;
    font-weight: 700;
    padding: 0.2rem 0.55rem;
    background-color: var(--color-surface-subtle);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-full);
    color: var(--color-text-muted);
  }

  .reading-time {
    font-size: 0.75rem;
    color: var(--color-text-muted);
  }

  .guide-card h3 {
    font-family: var(--font-display);
    font-size: 1.25rem;
    font-weight: 700;
    color: var(--color-text-primary);
    margin-top: 0;
    margin-bottom: 0.5rem;
    line-height: 1.3;
  }

  .guide-card p {
    font-size: 0.92rem;
    color: var(--color-text-secondary);
    line-height: 1.55;
    margin-bottom: 1.25rem;
    flex-grow: 1;
  }

  .guide-card-footer {
    display: flex;
    justify-content: space-between;
    align-items: center;
    font-size: 0.8rem;
    border-top: 1px solid var(--color-border-subtle);
    padding-top: 0.75rem;
  }

  .card-author {
    color: var(--color-text-muted);
  }

  .read-link {
    font-weight: 700;
    color: var(--color-primary-accent);
  }

  .utilities-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 300px), 1fr));
    gap: var(--space-5);
  }

  .utility-card {
    background-color: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    padding: var(--space-6);
    text-decoration: none;
    display: flex;
    flex-direction: column;
    min-height: 220px;
    height: 100%;
    box-shadow: var(--shadow-sm);
    transition: all var(--transition-base);
  }

  .utility-card:hover {
    transform: translateY(-3px);
    box-shadow: var(--shadow-card);
    text-decoration: none;
  }

  .tool-card { border-left: 4px solid var(--color-primary-accent); }
  .check-card { border-left: 4px solid #059669; }

  .utility-badge {
    font-size: 0.72rem;
    font-weight: 700;
    color: var(--color-text-muted);
    margin-bottom: 0.5rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .utility-card h3 {
    font-family: var(--font-sans);
    font-size: 1.2rem;
    font-weight: 700;
    color: var(--color-text-primary);
    margin-top: 0;
    margin-bottom: 0.4rem;
  }

  .utility-card p {
    font-size: 0.92rem;
    color: var(--color-text-secondary);
    margin-bottom: 1rem;
    flex-grow: 1;
    line-height: 1.5;
  }

  .utility-link-text {
    font-size: 0.88rem;
    font-weight: 700;
    color: var(--color-primary-accent);
  }

  /* Empty State */
  .category-empty-state {
    background-color: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    padding: var(--space-12) var(--space-8);
    text-align: center;
    max-width: 800px;
    margin: var(--space-8) auto 0;
    box-shadow: var(--shadow-sm);
  }

  .empty-state-badge {
    display: inline-block;
    font-size: 0.75rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: #059669;
    background-color: rgba(5, 150, 105, 0.1);
    border: 1px solid rgba(5, 150, 105, 0.2);
    padding: 0.25rem 0.75rem;
    border-radius: var(--radius-full);
    margin-bottom: var(--space-4);
  }

  .empty-icon-large {
    font-size: 3.5rem;
    margin-bottom: var(--space-3);
  }

  .empty-title {
    font-family: var(--font-display);
    font-size: clamp(1.5rem, 3vw, 2rem);
    font-weight: 700;
    color: var(--color-text-primary);
    margin-top: 0;
    margin-bottom: var(--space-3);
  }

  .empty-lead {
    font-size: 1.05rem;
    color: var(--color-text-primary);
    max-width: 640px;
    margin: 0 auto var(--space-3);
    line-height: 1.6;
  }

  .empty-sub {
    font-size: 0.9rem;
    color: var(--color-text-muted);
    max-width: 580px;
    margin: 0 auto var(--space-8);
    line-height: 1.5;
  }

  .empty-navigation-box {
    border-top: 1px solid var(--color-border-subtle);
    padding-top: var(--space-6);
  }

  .empty-nav-heading {
    display: block;
    font-size: 0.85rem;
    font-weight: 700;
    color: var(--color-text-secondary);
    margin-bottom: var(--space-4);
  }

  .empty-links-list {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.5rem;
  }

  .empty-pill-link {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    padding: 0.4rem 0.8rem;
    font-size: 0.825rem;
    font-weight: 600;
    color: var(--color-text-primary);
    background-color: var(--color-surface-subtle);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-full);
    text-decoration: none;
    transition: all var(--transition-fast);
  }

  .empty-pill-link:hover {
    background-color: var(--color-surface-tint);
    border-color: var(--color-border-hover);
    color: var(--color-primary-accent);
    text-decoration: none;
  }
</style>
