---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Privacy Policy — LifeMode"
  description="LifeMode Privacy Policy detailing our commitment to reader privacy and data protection standards."
>
  <div class="page-shell container-prose">
    <header style="margin-bottom: var(--space-8);">
      <span class="hero-tag">Legal &amp; Transparency</span>
      <h1 class="page-title">Privacy Policy</h1>
      <p class="page-lead">
        Your privacy and trust are paramount. LifeMode is designed with data minimization and transparency at its core.
      </p>
    </header>

    <div class="prose">
      <h2>Information We Collect</h2>
      <p>
        LifeMode operates primarily as a static, content-driven editorial publication. We do not require account creation to read articles and we minimize third-party tracking scripts.
      </p>

      <h2>Usage &amp; Performance</h2>
      <p>
        Standard server logs and anonymized metrics may be used strictly to ensure platform security, uptime, and high-performance content delivery.
      </p>

      <h2>Changes to This Policy</h2>
      <p>
        Any updates to our privacy standards will be reflected on this page with an updated timestamp.
      </p>
    </div>
  </div>
</BaseLayout>
