---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ArticleCard from '../../components/ArticleCard.astro';
import PillarBadge from '../../components/PillarBadge.astro';
import SubtopicCardGrid from '../../components/SubtopicCardGrid.astro';
import TopicDataSection from '../../components/topic-data/TopicDataSection.astro';
import { getCollection } from 'astro:content';
import { PILLARS } from '../../config/site';
import { CATEGORIES } from '../../utils/categories';
import { generateBreadcrumbSchema } from '../../utils/seo';

const pillar = PILLARS['home'];

const [allHomeArticles, allFoodArticles, allGuides, allTools] = await Promise.all([
  getCollection('home').catch(() => []),
  getCollection('food-drink').catch(() => []),
  getCollection('guides').catch(() => []),
  getCollection('tools').catch(() => []),
]);

const homeArticles = allHomeArticles.filter((a: any) => !a.data.draft);
const foodArticles = allFoodArticles.filter((a: any) => !a.data.draft);

// Combined editorial articles under Home umbrella
const allEditorialArticles = [...homeArticles, ...foodArticles].sort(
  (a: any, b: any) => new Date(b.data.pubDate).getTime() - new Date(a.data.pubDate).getTime()
);

const featuredGuides = allGuides.slice(0, 6);
const featuredTools = allTools.slice(0, 4);

const breadcrumbSchema = generateBreadcrumbSchema([
  { name: 'Home', url: '/' },
  { name: pillar.name, url: `/${pillar.slug}` },
]);
---

<BaseLayout
  title={`${pillar.name} — Food, Kitchen Care & Household Systems | LifeMode`}
  description={pillar.description}
  jsonLd={breadcrumbSchema}
>
  <!-- Breadcrumb Navigation -->
  <div class="container" style="padding-top: var(--space-6);">
    <nav aria-label="Breadcrumbs" class="breadcrumb-nav">
      <ol class="breadcrumb-list">
        <li><a href="/">Home</a></li>
        <li class="breadcrumb-separator" aria-hidden="true">&rsaquo;</li>
        <li class="breadcrumb-current" aria-current="page">{pillar.name}</li>
      </ol>
    </nav>
  </div>

  <!-- Pillar Hero Section -->
  <section class="hero-editorial" style="padding-top: var(--space-6); padding-bottom: var(--space-6);">
    <div class="container">
      <div style="margin-bottom: var(--space-3);">
        <PillarBadge pillar={pillar.slug} size="md" asLink={false} />
      </div>
      <h1 class="hero-heading" style="margin-bottom: var(--space-3);">
        {pillar.name} &amp; Living Systems
      </h1>
      <p class="hero-lead" style="max-width: 760px; margin-bottom: var(--space-6);">
        {pillar.description}
      </p>

      <!-- Category Navigation Cards Grid -->
      <SubtopicCardGrid
        subtopics={pillar.subtopics || []}
        pillarSlug={pillar.slug}
        pillarColor={pillar.color}
      />
    </div>
  </section>

  <!-- Featured Reference Guides in Home -->
  {featuredGuides.length > 0 && (
    <section class="section" style="padding-top: var(--space-8);">
      <div class="container">
        <div class="section-header">
          <div>
            <span class="section-kicker">Authoritative Reference</span>
            <h2 class="section-title">Home Reference &amp; Decision Guides</h2>
          </div>
          <a href="/guides" class="section-link">All guides &rarr;</a>
        </div>

        <div class="guides-home-grid" style="display: grid; grid-template-columns: repeat(auto-fill, minmax(320px, 1fr)); gap: var(--space-6);">
          {featuredGuides.map((guide) => {
            const cat = CATEGORIES[guide.data.category];
            const slug = guide.id.replace(/\.[^/.]+$/, '');
            return (
              <a href={`/${guide.data.category}/${slug}/`} style="background-color: var(--color-surface); border: 1px solid var(--color-border); border-radius: var(--radius-lg); padding: var(--space-6); text-decoration: none; display: flex; flex-direction: column; box-shadow: var(--shadow-sm); transition: all var(--transition-base);">
                <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: var(--space-3);">
                  {cat && (
                    <span class="badge" style={`color: ${cat.badgeColor}; background-color: ${cat.lightBg}; border: 1px solid ${cat.borderColor}; font-size: 0.725rem; font-weight: 700; padding: 0.15rem 0.55rem; border-radius: var(--radius-full);`}>
                      {cat.icon} {cat.title}
                    </span>
                  )}
                  <span style="font-size: 0.75rem; font-weight: 600; color: var(--color-text-muted);">
                    {guide.data.contentType === 'decision' ? '⚖️ Decision' : '📖 Reference'}
                  </span>
                </div>
                <h3 style="font-family: var(--font-display); font-size: 1.25rem; font-weight: 700; color: var(--color-text-primary); margin-bottom: var(--space-2); line-height: 1.3;">
                  {guide.data.title}
                </h3>
                <p style="font-size: 0.92rem; color: var(--color-text-secondary); line-height: 1.55; margin-bottom: var(--space-5); flex-grow: 1;">
                  {guide.data.quickSummary}
                </p>
                <div style="display: flex; justify-content: space-between; font-size: 0.78rem; color: var(--color-text-muted); border-top: 1px solid var(--color-border-subtle); padding-top: var(--space-3);">
                  <span>⏱️ {guide.data.readTime || '4 min read'}</span>
                  <span>Verified: {guide.data.updatedDate}</span>
                </div>
              </a>
            );
          })}
        </div>
      </div>
    </section>
  )}

  <!-- Editorial Stories & Food / Kitchen Craft -->
  {allEditorialArticles.length > 0 && (
    <section class="section section-alt" style="padding-top: var(--space-12); padding-bottom: var(--space-12);">
      <div class="container">
        <div class="section-header">
          <div>
            <span class="section-kicker">Culinary &amp; Living Craft</span>
            <h2 class="section-title">Home &amp; Culinary Articles</h2>
          </div>
          <a href="/food-drink" class="section-link">All recipes &rarr;</a>
        </div>

        <div class="grid-3">
          {allEditorialArticles.slice(0, 6).map((article: any) => {
            const articlePillar = article.collection === 'food-drink' ? 'food-drink' : 'home';
            return (
              <ArticleCard
                pillar={articlePillar}
                slug={article.id}
                title={article.data.title}
                description={article.data.description}
                pubDate={article.data.pubDate}
                author={article.data.author}
                image={article.data.image}
                imageAlt={article.data.imageAlt}
                readingTime={article.data.readingTime}
                format={article.data.format}
                tags={article.data.tags}
                variant="card"
              />
            );
          })}
        </div>
      </div>
    </section>
  )}

  <!-- Interactive Tools & Decision Calculators -->
  {featuredTools.length > 0 && (
    <section class="section" style="padding-top: var(--space-10); padding-bottom: var(--space-12);">
      <div class="container">
        <div class="section-header">
          <div>
            <span class="section-kicker">Interactive Solvers</span>
            <h2 class="section-title">Household Decision &amp; Planning Utilities</h2>
          </div>
          <a href="/tools" class="section-link">All tools &rarr;</a>
        </div>

        <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(270px, 1fr)); gap: var(--space-6);">
          {featuredTools.map((tool) => {
            const cat = CATEGORIES[tool.data.category];
            const slug = tool.id.replace(/\.[^/.]+$/, '');
            return (
              <div style="background-color: var(--color-surface); border: 1px solid var(--color-border); border-radius: var(--radius-lg); padding: var(--space-6); display: flex; flex-direction: column; box-shadow: var(--shadow-sm);">
                <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: var(--space-3); flex-wrap: wrap; gap: 0.4rem;">
                  <span class="badge" style="background-color: rgba(37, 99, 235, 0.1); color: var(--color-primary-accent); font-size: 0.725rem; font-weight: 700; padding: 0.15rem 0.5rem; border-radius: var(--radius-full);">
                    🛠️ Interactive Utility
                  </span>
                  {cat && (
                    <span style={`color: ${cat.badgeColor}; background-color: ${cat.lightBg}; font-size: 0.725rem; font-weight: 700; padding: 0.15rem 0.5rem; border-radius: var(--radius-full);`}>
                      {cat.icon} {cat.title}
                    </span>
                  )}
                </div>
                <h3 style="font-family: var(--font-sans); font-size: 1.15rem; font-weight: 700; margin-bottom: var(--space-2);">
                  <a href={`/tools/${slug}/`} style="color: var(--color-text-primary); text-decoration: none;">{tool.data.title}</a>
                </h3>
                <p style="font-size: 0.9rem; color: var(--color-text-secondary); line-height: 1.5; margin-bottom: var(--space-5); flex-grow: 1;">
                  {tool.data.summary}
                </p>
                <div>
                  <a href={`/tools/${slug}/`} class="btn btn-outline" style="font-size: 0.85rem; color: var(--color-primary-accent);">
                    Launch Tool &rarr;
                  </a>
                </div>
              </div>
            );
          })}
        </div>
      </div>
    </section>
  )}

  <!-- Topic Intelligence -->
  <TopicDataSection pillar="home" pillarName="Food & Kitchen" />
</BaseLayout>
