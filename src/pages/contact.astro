---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Contact — LifeMode"
  description="Get in touch with LifeMode for editorial inquiries, partnerships, press requests, and general correspondence."
>
  <div class="page-shell container-prose">
    <header style="margin-bottom: var(--space-8);">
      <span class="hero-tag">Inquiries &amp; Correspondence</span>
      <h1 class="page-title">Contact</h1>
      <p class="page-lead">
        We welcome editorial inquiries, partnerships, press requests, and general questions from readers and collaborators worldwide.
      </p>
    </header>

    <div class="prose">
      <h2>General &amp; Editorial Inquiries</h2>
      <p>
        For editorial feedback, story ideas, press inquiries, or partnership opportunities, please reach us directly by email:
      </p>
      <p>
        <strong>Email:</strong> <a href="mailto:contact@lifemode.life">contact@lifemode.life</a>
      </p>

      <h2>Publisher Information</h2>
      <p>
        <strong>Publication:</strong> LifeMode<br />
        <strong>Publisher:</strong> Oberhauser Péter Zoltán<br />
        <strong>Contact:</strong> <a href="mailto:contact@lifemode.life">contact@lifemode.life</a>
      </p>

      <blockquote>
        Please note that LifeMode maintains strict editorial independence across all published articles, guides, and reviews.
      </blockquote>
    </div>
  </div>
</BaseLayout>
