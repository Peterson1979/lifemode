---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Contact LifeMode Editorial"
  description="Get in touch with the LifeMode editorial team for press inquiries, editorial suggestions, and partnerships."
>
  <div class="page-shell container-prose">
    <header style="margin-bottom: var(--space-8);">
      <span class="hero-tag">Inquiries &amp; Correspondence</span>
      <h1 class="page-title">Contact Us</h1>
      <p class="page-lead">
        We welcome editorial pitches, thoughtful feedback, and partnership inquiries from around the world.
      </p>
    </header>

    <div class="prose">
      <h2>Editorial Inquiries</h2>
      <p>
        For story tips, editorial submissions, or feedback on published articles, please reach our editorial desk.
      </p>

      <h2>Press &amp; Partnerships</h2>
      <p>
        For media inquiries, syndication, or commercial partnerships, connect with our communications team.
      </p>

      <blockquote>
        Please note that LifeMode maintains strict editorial autonomy across all published dispatches and reviews.
      </blockquote>
    </div>
  </div>
</BaseLayout>
