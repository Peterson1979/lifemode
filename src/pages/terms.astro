---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Terms of Service — LifeMode"
  description="LifeMode terms of service and reader usage guidelines."
>
  <div class="page-shell container-prose">
    <header style="margin-bottom: var(--space-8);">
      <span class="hero-tag">Legal &amp; Guidelines</span>
      <h1 class="page-title">Terms of Service</h1>
      <p class="page-lead">
        Guidelines for reading, citing, and interacting with LifeMode editorial publications.
      </p>
    </header>

    <div class="prose">
      <h2>Editorial Content</h2>
      <p>
        All articles, guides, essays, and original commentary published on LifeMode are protected by copyright. Short quotations and links are welcomed with appropriate attribution to LifeMode.
      </p>

      <h2>Informational Purpose</h2>
      <p>
        LifeMode articles covering technology, finance, travel, and health are provided for informational and educational purposes only and should not be construed as individualized financial, medical, or legal advice.
      </p>
    </div>
  </div>
</BaseLayout>
