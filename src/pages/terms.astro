---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCanonicalUrl } from '../utils/seo';

const canonicalUrl = getCanonicalUrl('/terms');
---

<BaseLayout
  title="Terms of Service — LifeMode"
  description="LifeMode terms of service, editorial usage guidelines, tool usage rules, and publisher information."
  canonicalUrl={canonicalUrl}
>
  <div class="page-shell container-prose" style="padding-top: var(--space-8); padding-bottom: var(--space-20);">
    <header style="margin-bottom: var(--space-8);">
      <span class="badge" style="background-color: rgba(37, 99, 235, 0.1); color: var(--color-primary-accent); border: 1px solid rgba(37, 99, 235, 0.2); font-size: 0.75rem; font-weight: 700; padding: 0.25rem 0.65rem; border-radius: var(--radius-full); margin-bottom: var(--space-3); display: inline-block;">
        Legal &amp; Guidelines
      </span>
      <h1 class="page-title" style="font-family: var(--font-display); font-size: clamp(2rem, 4vw, 2.75rem); font-weight: 700; color: var(--color-text-primary); margin-bottom: var(--space-3);">
        Terms of Service
      </h1>
      <p class="page-lead" style="font-size: 1.15rem; color: var(--color-text-secondary); line-height: 1.6;">
        Guidelines for reading, using interactive utilities, citing, and interacting with LifeMode publications.
      </p>
    </header>

    <div class="prose">
      <h2>1. Overview</h2>
      <p>
        Welcome to LifeMode (<a href="https://lifemode.life">https://lifemode.life</a>), operated by Oberhauser Péter Zoltán (&ldquo;LifeMode&rdquo;, &ldquo;we&rdquo;, &ldquo;us&rdquo;). By accessing or using this website, you agree to these Terms of Service.
      </p>

      <h2>2. Editorial Content &amp; Intellectual Property</h2>
      <p>
        All original written guides, custom interactive tools, decision matrices, design schemas, recipes, and checklists published on LifeMode are protected by applicable copyright and intellectual property laws. Users are permitted to print checklists and guides for personal, non-commercial use. Commercial redistribution, wholesale scraping, or unauthorized republication without prior written consent is strictly prohibited.
      </p>

      <h2>3. Informational &amp; Educational Purpose</h2>
      <p>
        The content, calculators, recipes, decision guides, and checklists provided on LifeMode are for general educational, culinary reference, and household decision support purposes only. LifeMode does not provide professional architectural, structural engineering, electrical contracting, licensed plumbing, financial, legal, or medical advice. For complex structural, hazardous, or high-voltage situations, always consult certified licensed trade professionals.
      </p>

      <h2>4. External Links &amp; Third-Party Services</h2>
      <p>
        Our articles and pages may contain links to external websites and resources. We do not endorse and are not responsible for the availability, content, or practices of third-party websites.
      </p>

      <h2>5. Affiliate Links &amp; Recommendations</h2>
      <p>
        Some product recommendations, including links to Amazon.com, are affiliate links. LifeMode may receive a commission from a qualifying purchase at no additional cost to you. As an Amazon Associate I earn from qualifying purchases. This commercial relationship does not guarantee a recommendation; selections are made using our editorial criteria. See the <a href="/privacy#external-links">affiliate disclosure in our Privacy Policy</a> for more information.
      </p>

      <h2>6. AI-Assisted Content</h2>
      <p>
        Some editorial planning or drafting may use AI-assisted tools. Published content is reviewed and approved through LifeMode's editorial process, but it remains general informational material and should not be treated as professional advice. See our <a href="/ai-disclaimer">AI Disclaimer</a>.
      </p>

      <h2>7. Publisher &amp; Contact</h2>
      <p>
        <strong>Publication:</strong> LifeMode<br />
        <strong>Publisher / Operator:</strong> Oberhauser Péter Zoltán<br />
        <strong>Editorial Desk:</strong> <a href="mailto:editorial@lifemode.life">editorial@lifemode.life</a><br />
        <strong>General Inquiries:</strong> <a href="mailto:contact@lifemode.life">contact@lifemode.life</a>
      </p>
    </div>
  </div>
</BaseLayout>
