---
import { getCollection } from 'astro:content';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../../components/Breadcrumbs.astro';
import { getCanonicalUrl, generateBreadcrumbSchema } from '../../../utils/seo';
import { isPubliclyVisiblePicksArticle, picksArticleSlug, getPicksArticleCategories } from '../../../utils/picks';
import { getAllPicksCategories } from '../../../utils/picks-categories';

const articles = (await getCollection('picks', isPubliclyVisiblePicksArticle)).sort(
  (a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime()
);

const allCategories = getAllPicksCategories();

const breadcrumbs = [
  { label: 'Home', url: '/' },
  { label: 'LifeMode Picks', url: '/picks/' },
  { label: 'Picks Articles', url: '/picks/articles/' },
];

const canonicalUrl = getCanonicalUrl('/picks/articles');

const breadcrumbSchema = generateBreadcrumbSchema([
  { name: 'Home', url: '/' },
  { name: 'LifeMode Picks', url: '/picks' },
  { name: 'Picks Articles', url: '/picks/articles' },
]);

const dateFormatter = new Intl.DateTimeFormat('en-US', {
  year: 'numeric',
  month: 'short',
  day: 'numeric',
  timeZone: 'UTC',
});
---

<BaseLayout
  title="Editorial Picks Articles & Buying Roundups — LifeMode"
  description="Editorially vetted product roundups, gift guides, lifestyle essentials, and curated gear reviews tested for practical utility."
  canonicalUrl={canonicalUrl}
  jsonLd={breadcrumbSchema}
>
  <div class="container picks-articles-directory-wrapper">
    <Breadcrumbs items={breadcrumbs} />

    <header class="directory-header">
      <div class="directory-kicker">
        <span class="kicker-icon">⭐</span>
        <span>Editorial Recommendations</span>
      </div>
      <h1 class="directory-title">LifeMode Picks Articles</h1>
      <p class="directory-subtitle">
        In-depth buying guides, gift roundups, and vetted gear lists. Every recommendation is researched, tested, or editorially chosen for real-world value.
      </p>

      <!-- Category Filter Pills -->
      <nav class="picks-category-nav" aria-label="Picks categories">
        <a href="/picks/articles/" class="category-pill active">
          All Topics ({articles.length})
        </a>
        {allCategories.map((cat) => (
          <a href={`/picks/category/${cat.slug}/`} class="category-pill">
            <span class="cat-pill-icon">{cat.icon}</span>
            <span>{cat.shortTitle}</span>
          </a>
        ))}
      </nav>
    </header>

    {articles.length === 0 ? (
      <div class="picks-empty-state">
        <span class="picks-empty-icon" aria-hidden="true">🛍️</span>
        <h2 class="picks-empty-title">Picks articles are coming soon</h2>
        <p class="picks-empty-text">
          Our editorial team is compiling our next set of tested roundups and curated gift guides. In the meantime, browse our <a href="/picks/">curated product picks</a> or explore our <a href="/guides/">practical household guides</a>.
        </p>
      </div>
    ) : (
      <div class="picks-articles-grid">
        {articles.map((article) => {
          const slug = picksArticleSlug(article.id);
          const cats = getPicksArticleCategories(article);
          return (
            <article class="picks-article-card">
              {article.data.image && (
                <div class="card-image-wrapper">
                  <a href={`/picks/articles/${slug}/`} tabindex="-1" aria-hidden="true">
                    <img
                      src={article.data.image}
                      alt={article.data.imageAlt || article.data.title}
                      class="card-image"
                      loading="lazy"
                      decoding="async"
                    />
                  </a>
                </div>
              )}
              <div class="card-content">
                {cats.length > 0 && (
                  <div class="card-categories">
                    {cats.slice(0, 2).map((cat) => (
                      <a href={`/picks/category/${cat.slug}/`} class="category-tag" style={`border-color: ${cat.borderColor}; background-color: ${cat.lightBg}; color: ${cat.badgeColor};`}>
                        <span>{cat.icon}</span>
                        <span>{cat.shortTitle}</span>
                      </a>
                    ))}
                  </div>
                )}
                <h2 class="card-title">
                  <a href={`/picks/articles/${slug}/`}>{article.data.title}</a>
                </h2>
                <p class="card-summary">{article.data.description}</p>
                <div class="card-meta">
                  <span class="meta-author">{article.data.author}</span>
                  <span class="meta-dot">&bull;</span>
                  <time datetime={article.data.pubDate.toISOString()}>
                    {dateFormatter.format(article.data.pubDate)}
                  </time>
                  {article.data.readingTime && (
                    <>
                      <span class="meta-dot">&bull;</span>
                      <span class="meta-reading">⏱️ {article.data.readingTime}</span>
                    </>
                  )}
                </div>
                <div class="card-footer">
                  <a href={`/picks/articles/${slug}/`} class="read-more-link">
                    Read Roundup &rarr;
                  </a>
                </div>
              </div>
            </article>
          );
        })}
      </div>
    )}
  </div>
</BaseLayout>

<style>
  .picks-articles-directory-wrapper {
    padding-top: var(--space-6);
    padding-bottom: var(--space-20);
    max-width: 1100px;
  }

  .directory-header {
    margin-top: var(--space-4);
    margin-bottom: var(--space-10);
  }

  .directory-kicker {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    font-size: 0.8rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--color-primary-accent, #6366f1);
    background: rgba(99, 102, 241, 0.08);
    padding: 0.25rem 0.65rem;
    border-radius: var(--radius-full);
    margin-bottom: var(--space-2);
  }

  .directory-title {
    font-family: var(--font-display);
    font-size: clamp(2rem, 4vw, 2.75rem);
    font-weight: 700;
    color: var(--color-text-primary);
    line-height: 1.2;
    margin-bottom: var(--space-3);
  }

  .directory-subtitle {
    font-size: 1.15rem;
    color: var(--color-text-secondary);
    line-height: 1.6;
    max-width: 720px;
    margin-bottom: var(--space-6);
  }

  .picks-category-nav {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    padding-top: var(--space-2);
  }

  .category-pill {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    font-size: 0.85rem;
    font-weight: 500;
    color: var(--color-text-secondary);
    background-color: var(--color-surface, #ffffff);
    border: 1px solid var(--color-border, #e5e7eb);
    padding: 0.35rem 0.75rem;
    border-radius: var(--radius-full);
    text-decoration: none;
    transition: all 0.15s ease;
  }

  .category-pill:hover {
    color: var(--color-text-primary);
    border-color: var(--color-text-secondary);
    transform: translateY(-1px);
  }

  .category-pill.active {
    background-color: var(--color-text-primary, #111827);
    color: #ffffff;
    border-color: var(--color-text-primary, #111827);
  }

  .picks-articles-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
    gap: var(--space-8);
  }

  .picks-article-card {
    display: flex;
    flex-direction: column;
    background-color: var(--color-surface, #ffffff);
    border: 1px solid var(--color-border, #e5e7eb);
    border-radius: var(--radius-lg, 12px);
    overflow: hidden;
    transition: box-shadow 0.2s ease, transform 0.2s ease;
  }

  .picks-article-card:hover {
    box-shadow: 0 10px 25px -5px rgba(0, 0, 0, 0.08), 0 8px 10px -6px rgba(0, 0, 0, 0.04);
    transform: translateY(-2px);
  }

  .card-image-wrapper {
    position: relative;
    width: 100%;
    aspect-ratio: 16 / 9;
    overflow: hidden;
    background-color: var(--color-surface-subtle, #f3f4f6);
  }

  .card-image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.3s ease;
  }

  .picks-article-card:hover .card-image {
    transform: scale(1.03);
  }

  .card-content {
    display: flex;
    flex-direction: column;
    flex-grow: 1;
    padding: var(--space-5);
  }

  .card-categories {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem;
    margin-bottom: var(--space-3);
  }

  .category-tag {
    display: inline-flex;
    align-items: center;
    gap: 0.25rem;
    font-size: 0.725rem;
    font-weight: 600;
    padding: 0.15rem 0.5rem;
    border-radius: var(--radius-sm, 6px);
    border: 1px solid;
    text-decoration: none;
  }

  .card-title {
    font-size: 1.25rem;
    font-weight: 700;
    line-height: 1.35;
    margin-bottom: var(--space-2);
    color: var(--color-text-primary);
  }

  .card-title a {
    color: inherit;
    text-decoration: none;
  }

  .card-title a:hover {
    color: var(--color-primary-accent, #6366f1);
  }

  .card-summary {
    font-size: 0.925rem;
    color: var(--color-text-secondary);
    line-height: 1.55;
    margin-bottom: var(--space-4);
    flex-grow: 1;
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .card-meta {
    display: flex;
    align-items: center;
    font-size: 0.8rem;
    color: var(--color-text-muted, #6b7280);
    margin-bottom: var(--space-4);
    gap: 0.35rem;
  }

  .meta-dot {
    opacity: 0.6;
  }

  .card-footer {
    border-top: 1px solid var(--color-border-subtle, #f3f4f6);
    padding-top: var(--space-3);
  }

  .read-more-link {
    font-size: 0.875rem;
    font-weight: 600;
    color: var(--color-primary-accent, #6366f1);
    text-decoration: none;
  }

  .read-more-link:hover {
    text-decoration: underline;
  }

  .picks-empty-state {
    text-align: center;
    padding: var(--space-16) var(--space-6);
    background-color: var(--color-surface, #ffffff);
    border: 1px dashed var(--color-border, #e5e7eb);
    border-radius: var(--radius-lg, 12px);
  }

  .picks-empty-icon {
    font-size: 3rem;
    display: block;
    margin-bottom: var(--space-4);
  }

  .picks-empty-title {
    font-size: 1.5rem;
    font-weight: 700;
    color: var(--color-text-primary);
    margin-bottom: var(--space-2);
  }

  .picks-empty-text {
    font-size: 1rem;
    color: var(--color-text-secondary);
    max-width: 500px;
    margin: 0 auto;
    line-height: 1.6;
  }

  .picks-empty-text a {
    color: var(--color-primary-accent, #6366f1);
    text-decoration: underline;
  }
</style>

