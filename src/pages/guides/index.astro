---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import { getCanonicalUrl, generateBreadcrumbSchema } from '../../utils/seo';
import { isPubliclyVisibleGuide, guideSlug } from '../../utils/guides';

const guides = (await getCollection('guides', isPubliclyVisibleGuide)).sort(
  (a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime()
);

const breadcrumbs = [
  { label: 'Home', url: '/' },
  { label: 'Guides', url: '/guides/' },
];

const canonicalUrl = getCanonicalUrl('/guides');

const breadcrumbSchema = generateBreadcrumbSchema([
  { name: 'Home', url: '/' },
  { name: 'Guides', url: '/guides' },
]);
---

<BaseLayout
  title="Practical Household Guides — LifeMode"
  description="In-depth, practical planning guides for everyday household projects: kitchen organization, storage systems, decluttering frameworks, and weekend action plans."
  canonicalUrl={canonicalUrl}
  jsonLd={breadcrumbSchema}
>
  <div class="container guides-directory-wrapper">
    <Breadcrumbs items={breadcrumbs} />

    <header class="directory-header">
      <span class="badge directory-badge">In-Depth Planning Guides</span>
      <h1 class="directory-title">Practical Household Guides</h1>
      <p class="directory-subtitle">
        Longer-form, step-by-step planning guides that walk through a complete household project from assessment to action plan.
      </p>
    </header>

    {guides.length === 0 ? (
      <div class="guides-empty-state">
        <span class="guides-empty-icon" aria-hidden="true">📖</span>
        <h2 class="guides-empty-title">No guides published yet</h2>
        <p class="guides-empty-text">
          New planning guides are in preparation. In the meantime, explore our
          <a href="/tools/">interactive tools</a> and
          <a href="/checklists/">printable checklists</a>.
        </p>
      </div>
    ) : (
      <div class="guides-grid">
        {guides.map((guide) => {
          const slug = guideSlug(guide.id);
          return (
            <div class="guide-directory-card">
              <div class="card-meta">
                <span class="badge guide-pill">📖 Practical Guide</span>
                {guide.data.readingTime && (
                  <span class="reading-pill">⏱️ {guide.data.readingTime}</span>
                )}
              </div>
              <h2 class="card-title">
                <a href={`/guides/${slug}/`}>{guide.data.title}</a>
              </h2>
              <p class="card-summary">{guide.data.description}</p>
              <div class="card-footer">
                <a href={`/guides/${slug}/`} class="btn btn-outline" style="font-size: 0.85rem;">Read Guide &rarr;</a>
              </div>
            </div>
          );
        })}
      </div>
    )}
  </div>
</BaseLayout>

<style>
  .guides-directory-wrapper {
    padding-top: var(--space-8);
    padding-bottom: var(--space-20);
  }

  .directory-header {
    margin-bottom: var(--space-10);
  }

  .directory-badge {
    display: inline-block;
    background-color: rgba(124, 58, 237, 0.1);
    color: #7c3aed;
    border: 1px solid rgba(124, 58, 237, 0.2);
    font-size: 0.75rem;
    font-weight: 700;
    padding: 0.25rem 0.65rem;
    border-radius: var(--radius-full);
    margin-bottom: var(--space-3);
  }

  .directory-title {
    font-family: var(--font-display);
    font-size: clamp(2rem, 4vw, 2.75rem);
    font-weight: 700;
    color: var(--color-text-primary);
    margin-bottom: var(--space-3);
  }

  .directory-subtitle {
    font-size: 1.15rem;
    color: var(--color-text-secondary);
    line-height: 1.6;
    max-width: 780px;
    margin: 0;
  }

  .guides-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(340px, 1fr));
    gap: var(--space-6);
  }

  .guide-directory-card {
    background-color: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    padding: var(--space-6);
    display: flex;
    flex-direction: column;
    box-shadow: var(--shadow-sm);
    transition: all var(--transition-base);
  }

  .guide-directory-card:hover {
    transform: translateY(-3px);
    box-shadow: var(--shadow-card);
    border-color: var(--color-border-hover);
  }

  .card-meta {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-3);
    margin-bottom: var(--space-3);
  }

  .guide-pill {
    background-color: rgba(124, 58, 237, 0.1);
    color: #7c3aed;
    font-size: 0.75rem;
    font-weight: 700;
    padding: 0.2rem 0.55rem;
    border-radius: var(--radius-full);
  }

  .reading-pill {
    font-size: 0.75rem;
    font-weight: 600;
    color: var(--color-text-muted);
  }

  .card-title {
    font-family: var(--font-display);
    font-size: 1.35rem;
    font-weight: 700;
    margin-top: 0;
    margin-bottom: var(--space-2);
  }

  .card-title a {
    color: var(--color-text-primary);
    text-decoration: none;
  }

  .card-title a:hover {
    color: var(--color-primary-accent);
    text-decoration: underline;
  }

  .card-summary {
    font-size: 0.95rem;
    color: var(--color-text-secondary);
    line-height: 1.6;
    margin-bottom: var(--space-6);
    flex-grow: 1;
  }

  .card-footer {
    border-top: 1px solid var(--color-border-subtle);
    padding-top: var(--space-4);
    margin-top: auto;
  }

  .guides-empty-state {
    background-color: var(--color-surface);
    border: 1px dashed var(--color-border);
    border-radius: var(--radius-lg);
    padding: var(--space-10) var(--space-6);
    text-align: center;
  }

  .guides-empty-icon {
    font-size: 2rem;
  }

  .guides-empty-title {
    font-family: var(--font-display);
    font-size: 1.35rem;
    font-weight: 700;
    color: var(--color-text-primary);
    margin: var(--space-3) 0 var(--space-2);
  }

  .guides-empty-text {
    font-size: 0.95rem;
    color: var(--color-text-secondary);
    line-height: 1.6;
    max-width: 520px;
    margin: 0 auto;
  }
</style>
