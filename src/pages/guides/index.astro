---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import { CATEGORIES } from '../../utils/categories';
import { getCanonicalUrl, generateBreadcrumbSchema } from '../../utils/seo';

const guides = await getCollection('guides');

const breadcrumbs = [
  { label: 'Home', url: '/' },
  { label: 'All Guides', url: '/guides/' },
];

const canonicalUrl = getCanonicalUrl('/guides');

const breadcrumbSchema = generateBreadcrumbSchema([
  { name: 'Home', url: '/' },
  { name: 'All Guides', url: '/guides' },
]);
---

<BaseLayout
  title="All Everyday Reference & Decision Guides — LifeMode"
  description="Browse our complete library of practical, fact-checked reference guides, step-by-step instructions, and decision matrices for everyday household dilemmas."
  canonicalUrl={canonicalUrl}
  jsonLd={breadcrumbSchema}
>
  <div class="container guides-directory-wrapper">
    <Breadcrumbs items={breadcrumbs} />

    <header class="directory-header">
      <span class="badge directory-badge">Reference Library</span>
      <h1 class="directory-title">Everyday Practical Reference Library</h1>
      <p class="directory-subtitle">
        Vetted step-by-step instructions, material care guides, and objective decision guides. Researched, fact-checked, and updated regularly.
      </p>
    </header>

    <div class="guide-grid">
      {guides.map((guide) => {
        const cat = CATEGORIES[guide.data.category];
        const slug = guide.id.replace(/\.[^/.]+$/, '');
        return (
          <a href={`/${guide.data.category}/${slug}/`} class="guide-card">
            <div class="card-meta-top">
              {cat && (
                <span class="badge" style={`color: ${cat.badgeColor}; background-color: ${cat.lightBg}; border: 1px solid ${cat.borderColor};`}>
                  {cat.icon} {cat.title}
                </span>
              )}
              <span class="type-pill">{guide.data.contentType === 'decision' ? '⚖️ Decision' : '📖 Reference'}</span>
            </div>
            <h3>{guide.data.title}</h3>
            <p>{guide.data.quickSummary}</p>
            <div class="guide-card-footer">
              <span>⏱️ {guide.data.readTime || '4 min read'}</span>
              <span>Updated: {guide.data.updatedDate}</span>
            </div>
          </a>
        );
      })}
    </div>
  </div>
</BaseLayout>

<style>
  .guides-directory-wrapper {
    padding-top: var(--space-8);
    padding-bottom: var(--space-20);
  }

  .directory-header {
    margin-bottom: var(--space-10);
  }

  .directory-badge {
    display: inline-block;
    background-color: var(--color-surface-subtle);
    color: var(--color-text-secondary);
    border: 1px solid var(--color-border);
    font-size: 0.75rem;
    font-weight: 700;
    padding: 0.25rem 0.65rem;
    border-radius: var(--radius-full);
    margin-bottom: var(--space-3);
  }

  .directory-title {
    font-family: var(--font-display);
    font-size: clamp(2rem, 4vw, 2.75rem);
    font-weight: 700;
    color: var(--color-text-primary);
    margin-bottom: var(--space-3);
  }

  .directory-subtitle {
    font-size: 1.15rem;
    color: var(--color-text-secondary);
    line-height: 1.6;
    max-width: 780px;
    margin: 0;
  }

  .guide-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
    gap: var(--space-6);
  }

  .guide-card {
    background-color: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    padding: var(--space-6);
    text-decoration: none;
    display: flex;
    flex-direction: column;
    box-shadow: var(--shadow-sm);
    transition: all var(--transition-base);
  }

  .guide-card:hover {
    transform: translateY(-3px);
    box-shadow: var(--shadow-card);
    border-color: var(--color-border-hover);
    text-decoration: none;
  }

  .card-meta-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 0.75rem;
  }

  .type-pill {
    font-size: 0.75rem;
    font-weight: 600;
    color: var(--color-text-muted);
  }

  .guide-card h3 {
    font-family: var(--font-display);
    font-size: 1.25rem;
    font-weight: 700;
    color: var(--color-text-primary);
    margin-top: 0;
    margin-bottom: 0.5rem;
    line-height: 1.3;
  }

  .guide-card p {
    font-size: 0.92rem;
    color: var(--color-text-secondary);
    line-height: 1.55;
    margin-bottom: 1rem;
    flex-grow: 1;
  }

  .guide-card-footer {
    display: flex;
    justify-content: space-between;
    font-size: 0.78rem;
    color: var(--color-text-muted);
    border-top: 1px solid var(--color-border-subtle);
    padding-top: 0.75rem;
  }
</style>
