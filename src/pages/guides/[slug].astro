---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import RelatedCluster from '../../components/RelatedCluster.astro';
import {
  getCanonicalUrl,
  generateArticleSchema,
  generateBreadcrumbSchema,
} from '../../utils/seo';
import { isPubliclyVisibleGuide, guideSlug } from '../../utils/guides';

export async function getStaticPaths() {
  // Only publicly published guides become routes; DRAFT/REVIEWED/APPROVED/STORED
  // and ARCHIVED entries are never rendered.
  const guides = await getCollection('guides', isPubliclyVisibleGuide);
  return guides.map((guide) => ({
    params: { slug: guideSlug(guide.id) },
    props: { guide },
  }));
}

const { guide } = Astro.props;
const { Content } = await render(guide);
const slug = guideSlug(guide.id);

const canonicalUrl = getCanonicalUrl(`/guides/${slug}`);

const dateFormatter = new Intl.DateTimeFormat('en-US', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
  timeZone: 'UTC',
});
const pubDateFormatted = dateFormatter.format(guide.data.pubDate);

const articleSchema = generateArticleSchema({
  title: guide.data.title,
  description: guide.data.description,
  url: canonicalUrl,
  pubDate: guide.data.pubDate,
  updatedDate: guide.data.updatedDate,
  authorName: guide.data.author,
  image: guide.data.image,
  pillarName: 'Guides',
});

const breadcrumbSchema = generateBreadcrumbSchema([
  { name: 'Home', url: '/' },
  { name: 'Guides', url: '/guides/' },
  { name: guide.data.title, url: `/guides/${slug}/` },
]);

const breadcrumbs = [
  { label: 'Home', url: '/' },
  { label: 'Guides', url: '/guides/' },
  { label: guide.data.title, url: `/guides/${slug}/` },
];
---

<BaseLayout
  title={guide.data.title}
  description={guide.data.description}
  canonicalUrl={canonicalUrl}
  image={guide.data.image}
  type="article"
  pubDate={guide.data.pubDate}
  updatedDate={guide.data.updatedDate}
  author={guide.data.author}
  jsonLd={[articleSchema, breadcrumbSchema]}
>
  <article class="container guide-article-wrapper">
    <Breadcrumbs items={breadcrumbs} />

    <header class="guide-article-header">
      <h1 class="guide-article-title">{guide.data.title}</h1>
      <p class="guide-article-description">{guide.data.description}</p>
      <div class="guide-article-meta">
        <span class="meta-item">By {guide.data.author}</span>
        <span class="meta-item">Published {pubDateFormatted}</span>
        {guide.data.readingTime && <span class="meta-item">⏱️ {guide.data.readingTime}</span>}
      </div>
    </header>

    {guide.data.image && (
      <figure class="guide-featured-image-wrapper">
        <img
          src={guide.data.image}
          alt={guide.data.imageAlt || guide.data.title}
          class="guide-featured-image"
          loading="eager"
          decoding="async"
        />
      </figure>
    )}

    <div class="guide-article-body prose">
      <Content />
    </div>

    <!-- Related Resources & Connected Knowledge -->
    <RelatedCluster
      currentCategory={guide.data.category || ''}
      relatedGuides={guide.data.relatedGuides}
      relatedTools={guide.data.relatedTools}
      relatedChecklists={guide.data.relatedChecklists}
      relatedVideos={guide.data.relatedVideos}
    />
  </article>
</BaseLayout>

<style>
  .guide-article-wrapper {
    padding-top: var(--space-8);
    padding-bottom: var(--space-20);
    max-width: 820px;
  }

  .guide-article-header {
    margin-bottom: var(--space-10);
  }

  .guide-article-badge {
    display: inline-block;
    background-color: rgba(124, 58, 237, 0.1);
    color: #7c3aed;
    border: 1px solid rgba(124, 58, 237, 0.2);
    font-size: 0.75rem;
    font-weight: 700;
    padding: 0.25rem 0.65rem;
    border-radius: var(--radius-full);
    margin-bottom: var(--space-3);
  }

  .guide-article-title {
    font-family: var(--font-display);
    font-size: clamp(2rem, 4vw, 2.75rem);
    font-weight: 700;
    line-height: 1.2;
    color: var(--color-text-primary);
    margin-bottom: var(--space-3);
  }

  .guide-article-description {
    font-size: 1.15rem;
    color: var(--color-text-secondary);
    line-height: 1.6;
    margin-bottom: var(--space-4);
  }

  .guide-article-meta {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-4);
    font-size: 0.875rem;
    color: var(--color-text-muted);
  }

  .guide-featured-image-wrapper {
    margin: var(--space-6) 0 var(--space-8) 0;
    border-radius: var(--radius-xl, 16px);
    overflow: hidden;
    box-shadow: 0 10px 25px -5px rgba(15, 23, 42, 0.08);
    background-color: var(--color-surface, #f8fafc);
    border: 1px solid var(--color-border-subtle, #e2e8f0);
  }

  .guide-featured-image {
    width: 100%;
    max-height: 480px;
    object-fit: cover;
    display: block;
  }

  .guide-article-body {
    margin-top: var(--space-2);
  }

  :global(.guide-article-body > h1:first-child) {
    display: none;
  }

  :global(.product-callout) {
    background-color: var(--color-surface, #ffffff);
    border: 1px solid var(--color-border-subtle, #e2e8f0);
    border-radius: var(--radius-lg, 12px);
    padding: var(--space-6, 1.5rem);
    margin: var(--space-8, 2rem) 0;
    box-shadow: 0 4px 6px -1px rgba(15, 23, 42, 0.05);
  }

  :global(.product-callout-header) {
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: var(--space-2, 0.5rem);
    margin-bottom: var(--space-4, 1rem);
  }

  :global(.product-badge) {
    display: inline-block;
    background-color: rgba(16, 185, 129, 0.12);
    color: #059669;
    font-size: 0.75rem;
    font-weight: 700;
    padding: 0.2rem 0.65rem;
    border-radius: var(--radius-full, 9999px);
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  :global(.product-asin) {
    font-size: 0.8rem;
    color: var(--color-text-muted, #64748b);
    font-family: monospace;
  }

  :global(.product-callout-body) {
    display: flex;
    gap: var(--space-6, 1.5rem);
    align-items: center;
    margin-bottom: var(--space-4, 1rem);
  }

  :global(.product-image-container) {
    flex-shrink: 0;
    width: 220px;
    background-color: #ffffff;
    border: 1px solid var(--color-border-subtle, #e2e8f0);
    border-radius: var(--radius-md, 8px);
    padding: var(--space-3, 0.75rem);
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
  }

  :global(.product-image-link) {
    display: block;
    width: 100%;
    text-align: center;
    text-decoration: none !important;
  }

  :global(.product-callout-img) {
    width: 100%;
    height: auto;
    max-height: 180px;
    object-fit: contain;
    border-radius: var(--radius-sm, 4px);
    transition: transform 0.2s ease;
    display: block;
    margin: 0 auto;
  }

  :global(.product-image-link:hover .product-callout-img) {
    transform: scale(1.03);
  }

  :global(.product-info-container) {
    flex: 1;
    min-width: 0;
  }

  :global(.product-title) {
    font-size: 1.25rem;
    font-weight: 700;
    color: var(--color-text-primary, #0f172a);
    margin: 0 0 var(--space-2, 0.5rem) 0;
  }

  :global(.product-description) {
    font-size: 0.95rem;
    color: var(--color-text-secondary, #334155);
    line-height: 1.6;
    margin: 0 0 var(--space-4, 1rem) 0;
  }

  :global(.product-actions) {
    margin-bottom: var(--space-3, 0.75rem);
  }

  :global(.product-affiliate-link) {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    background-color: var(--color-primary, #0f766e);
    color: #ffffff !important;
    font-weight: 600;
    padding: 0.65rem 1.25rem;
    border-radius: var(--radius-md, 8px);
    text-decoration: none !important;
    transition: background-color 0.2s ease;
  }

  :global(.product-affiliate-link:hover) {
    background-color: #0d9488;
    color: #ffffff !important;
  }

  :global(.product-disclosure) {
    font-size: 0.8rem;
    color: var(--color-text-muted, #64748b);
    margin: 0;
  }

  @media (max-width: 640px) {
    :global(.product-callout-body) {
      flex-direction: column;
      align-items: stretch;
    }

    :global(.product-image-container) {
      width: 100%;
      max-height: 220px;
    }

    :global(.product-callout-img) {
      max-height: 190px;
    }
  }
</style>
