---
import BaseLayout from '../layouts/BaseLayout.astro';
import { PILLARS, PILLAR_SLUGS } from '../config/site';
---

<BaseLayout
  title="About — LifeMode"
  description="Learn about LifeMode, a global English-language lifestyle and media publication."
>
  <div class="page-shell container-prose">
    <header style="margin-bottom: var(--space-8);">
      <span class="hero-tag">About</span>
      <h1 class="page-title">LifeMode</h1>
      <p class="page-lead">
        A global English-language lifestyle and media publication exploring ideas, guides, and discoveries for living well now.
      </p>
    </header>

    <div class="prose">
      <h2>Our Mission</h2>
      <p>
        In an era of relentless information noise, LifeMode curates clarity. We publish thoughtful, original, and reader-focused editorial content across food &amp; drink, technology, travel, personal finance, wellbeing, design, and contemporary culture.
      </p>

      <h2>Topics We Cover</h2>
      <p>
        LifeMode covers our core editorial subjects:
      </p>

      <ul>
        {PILLAR_SLUGS.map((slug) => {
          const pillar = PILLARS[slug];
          return (
            <li>
              <strong><a href={`/${pillar.slug}`}>{pillar.name}</a>:</strong> {pillar.description}
            </li>
          );
        })}
      </ul>

      <h2>Editorial Standards</h2>
      <p>
        Our stories and guides prioritize substance, clarity, and everyday utility. To learn more about our commitment to factual accuracy, independent sourcing, and transparency, read our <a href="/editorial-standards">Editorial Standards</a>.
      </p>

      <h2>Publisher &amp; Contact</h2>
      <p>
        <strong>Publication:</strong> LifeMode<br />
        <strong>Published &amp; Operated by:</strong> Oberhauser Péter Zoltán<br />
        <strong>Editorial &amp; General Inquiries:</strong> <a href="mailto:contact@lifemode.life">contact@lifemode.life</a>
      </p>
    </div>
  </div>
</BaseLayout>
