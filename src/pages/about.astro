---
import BaseLayout from '../layouts/BaseLayout.astro';
import { PILLARS, PILLAR_SLUGS } from '../config/site';
---

<BaseLayout
  title="About — LifeMode"
  description="Learn about LifeMode and our commitment to clear, useful, and independent lifestyle journalism."
>
  <div class="page-shell container-prose">
    <header style="margin-bottom: var(--space-8);">
      <span class="hero-tag">About</span>
      <h1 class="page-title">LifeMode</h1>
      <p class="page-lead">
        Ideas, guides, and discoveries across technology, travel, personal finance, wellbeing, and everyday life.
      </p>
    </header>

    <div class="prose">
      <h2>Our mission</h2>
      <p>
        In an era of relentless information noise, LifeMode curates clarity. We share practical ideas, smart tools, and thoughtful guides designed to help you live well now.
      </p>

      <h2>Topics we cover</h2>
      <p>
        LifeMode covers seven core subjects:
      </p>

      <ul>
        {PILLAR_SLUGS.map((slug) => {
          const pillar = PILLARS[slug];
          return (
            <li>
              <strong><a href={`/${pillar.slug}`}>{pillar.name}</a>:</strong> {pillar.description}
            </li>
          );
        })}
      </ul>

      <h2>Editorial standards</h2>
      <p>
        Our stories and guides are guided by substance, accuracy, and everyday utility. We prioritize well-researched insights, practical frameworks, and clear explanations over fleeting hype.
      </p>
    </div>
  </div>
</BaseLayout>
