---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCanonicalUrl } from '../utils/seo';

const canonicalUrl = getCanonicalUrl('/about');
---

<BaseLayout
  title="About LifeMode — Practical Reference & Decision Platform"
  description="Learn about LifeMode's mission to provide reliable, practical, and fact-checked everyday household reference, culinary craft, and decision support."
  canonicalUrl={canonicalUrl}
>
  <div class="page-shell container-prose" style="padding-top: var(--space-8); padding-bottom: var(--space-20);">
    <header style="margin-bottom: var(--space-8);">
      <span class="badge" style="background-color: rgba(37, 99, 235, 0.1); color: var(--color-primary-accent); border: 1px solid rgba(37, 99, 235, 0.2); font-size: 0.75rem; font-weight: 700; padding: 0.25rem 0.65rem; border-radius: var(--radius-full); margin-bottom: var(--space-3); display: inline-block;">
        About
      </span>
      <h1 class="page-title" style="font-family: var(--font-display); font-size: clamp(2rem, 4vw, 2.75rem); font-weight: 700; color: var(--color-text-primary); margin-bottom: var(--space-3);">
        About LifeMode
      </h1>
      <p class="page-lead" style="font-size: 1.15rem; color: var(--color-text-secondary); line-height: 1.6;">
        Authoritative reference guidance, culinary inspiration, and interactive decision tools for thoughtful everyday living.
      </p>
    </header>

    <div class="prose">
      <h2>Why We Built LifeMode</h2>
      <p>
        <strong>LifeMode</strong> was created to serve as a modern practical reference library and culinary hub. In a digital ecosystem saturated with content noise and superficial summaries, we prioritize clarity, scientific fact-checking, step-by-step instructional integrity, and interactive decision-support utilities over vanity metrics.
      </p>

      <h2>Our Core Knowledge Domains</h2>
      <p>
        LifeMode organizes practical knowledge into focused, structured domains:
      </p>

      <ul>
        <li>
          <strong><a href="/health">Health</a>:</strong> Trend-driven longevity science, metabolic health, sleep &amp; recovery protocols, and evidence-based wellness.
        </li>
        <li>
          <strong><a href="/wealth">Wealth</a>:</strong> Practical guides to online side hustles, digital products, freelancing, and personal cashflow systems.
        </li>
        <li>
          <strong><a href="/home">Home</a>:</strong> Everyday household systems, food &amp; kitchen care, stain chemistry, cleaning protocols, and spatial organization.
        </li>
        <li>
          <strong><a href="/life">Life</a>:</strong> Capsule style, habit stacking, daily routines, focus architecture, and mindful travel journeys.
        </li>
        <li>
          <strong><a href="/tech-ai">Tech &amp; AI</a>:</strong> Plain-language AI workflows, practical everyday tools, prompt engineering, and digital automation for ordinary users.
        </li>
        <li>
          <strong><a href="/tools">Interactive Tools</a>:</strong> Privacy-preserving browser calculators, stain diagnosis assistants, decision matrices, and printable checklists.
        </li>
        <li>
          <strong><a href="/life-hacks">Life Hacks</a>:</strong> Curated video-first visual problem solving, household shortcuts, and smart hacks.
        </li>
        <li>
          <strong><a href="/daily-ideas">Daily Ideas Store</a>:</strong> Curated everyday essentials vetted for real-world utility, durability, and practical value.
        </li>
      </ul>

      <h2>Rigorous Verification Standards</h2>
      <p>
        All content published on LifeMode undergoes strict research, cross-referencing with authoritative extension offices, agricultural guidelines, manufacturer technical manuals, and consumer safety testing standards.
      </p>

      <h2>Publisher &amp; Contact</h2>
      <p>
        <strong>Publication:</strong> LifeMode<br />
        <strong>Published &amp; Operated by:</strong> Oberhauser Péter Zoltán<br />
        <strong>Editorial Desk:</strong> <a href="mailto:editorial@lifemode.life">editorial@lifemode.life</a><br />
        <strong>General Inquiries:</strong> <a href="mailto:contact@lifemode.life">contact@lifemode.life</a>
      </p>
    </div>
  </div>
</BaseLayout>
