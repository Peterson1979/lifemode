---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCanonicalUrl } from '../utils/seo';

const canonicalUrl = getCanonicalUrl('/about');
---

<BaseLayout
  title="About LifeMode — Practical Reference & Decision Platform"
  description="Learn about LifeMode's mission to provide reliable, practical, and fact-checked everyday household reference, culinary craft, and decision support."
  canonicalUrl={canonicalUrl}
>
  <div class="page-shell container-prose" style="padding-top: var(--space-8); padding-bottom: var(--space-20);">
    <header style="margin-bottom: var(--space-8);">
      <h1 class="page-title" style="font-family: var(--font-display); font-size: clamp(2rem, 4vw, 2.75rem); font-weight: 700; color: var(--color-text-primary); margin-bottom: var(--space-3);">
        About LifeMode
      </h1>
      <p class="page-lead" style="font-size: 1.15rem; color: var(--color-text-secondary); line-height: 1.6;">
        Authoritative reference guidance, culinary inspiration, and interactive decision tools for thoughtful everyday living.
      </p>
    </header>

    <div class="prose">
      <h2>Why We Built LifeMode</h2>
      <p>
        <strong>LifeMode</strong> was created to serve as a modern practical reference library and culinary hub. In a digital ecosystem saturated with content noise and superficial summaries, we prioritize clarity, scientific fact-checking, step-by-step instructional integrity, and interactive decision-support utilities over vanity metrics.
      </p>

      <h2>Our Six Core Categories</h2>
      <p>
        LifeMode organizes practical home and lifestyle guidance across six dedicated categories:
      </p>

      <ul>
        <li>
          <strong>Food &amp; Kitchen:</strong> Practical culinary guidance, cookware care, kitchen cutlery maintenance, food preservation, and pantry safety.
        </li>
        <li>
          <strong>Home Maintenance:</strong> Preventative seasonal upkeep, plumbing troubleshooting, appliance care, and essential DIY repair fundamentals.
        </li>
        <li>
          <strong>Cleaning &amp; Laundry:</strong> Evidence-based stain removal chemistry, textile wash protocols, care label deciphering, and deep sanitation routines.
        </li>
        <li>
          <strong>Home Organization:</strong> Spatial efficiency frameworks, small kitchen storage systems, closet capacity planning, and decluttering methods.
        </li>
        <li>
          <strong>Smart Home:</strong> Practical home automation, energy-efficiency monitoring, connected device standards, and privacy-first tech integrations.
        </li>
        <li>
          <strong>Home &amp; Garden:</strong> Indoor plant care, seasonal outdoor maintenance, patio upkeep, and garden living solutions.
        </li>
      </ul>

      <h2>Practical Resources &amp; Decision Utilities</h2>
      <p>
        Alongside comprehensive guides, LifeMode provides interactive browser utilities and printable references:
      </p>

      <ul>
        <li>
          <strong><a href="/tools/">Interactive Tools</a>:</strong> Privacy-preserving browser calculators, stain diagnosis assistants, decision matrices, and seasonal planners.
        </li>
        <li>
          <strong><a href="/checklists/">Printable Checklists</a>:</strong> Structured cleaning cheat sheets, laundry care routines, and seasonal inspection protocols.
        </li>
        <li>
          <strong><a href="/guides/">Planning Guides</a>:</strong> In-depth, step-by-step household guides from initial assessment to actionable execution.
        </li>
        <li>
          <strong><a href="/life-hacks/">Life Hacks</a>:</strong> Curated visual problem-solving videos, clever household shortcuts, and smart hacks.
        </li>
        <li>
          <strong><a href="/daily-ideas/">Daily Ideas Store</a>:</strong> Curated everyday essentials vetted for real-world utility, durability, and practical value.
        </li>
      </ul>

      <h2>Rigorous Verification Standards</h2>
      <p>
        All content published on LifeMode undergoes strict research, cross-referencing with authoritative extension offices, agricultural guidelines, manufacturer technical manuals, and consumer safety testing standards.
      </p>

      <h2>Publisher &amp; Contact</h2>
      <p>
        <strong>Publication:</strong> LifeMode<br />
        <strong>Published &amp; Operated by:</strong> Oberhauser Péter Zoltán<br />
        <strong>Website:</strong> <a href="https://lifemode.site">https://lifemode.site</a><br />
        <strong>Editorial Desk:</strong> <a href="mailto:editorial@lifemode.site">editorial@lifemode.site</a><br />
        <strong>General Inquiries:</strong> <a href="mailto:contact@lifemode.site">contact@lifemode.site</a>
      </p>
    </div>
  </div>
</BaseLayout>
