---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PillarBadge from '../../components/PillarBadge.astro';
import ArticleCard from '../../components/ArticleCard.astro';
import OwnedProjectCta from '../../components/OwnedProjectCta.astro';
import RecipeDetails from '../../components/RecipeDetails.astro';
import TopicDataSection from '../../components/topic-data/TopicDataSection.astro';
import { getCollection, render } from 'astro:content';
import { PILLARS, PILLAR_SLUGS, type PillarSlug } from '../../config/site';
import { matchOwnedProject } from '../../lib/projects/index';
import { formatDate, toISODate } from '../../utils/date';
import {
  generateArticleSchema,
  generateRecipeSchema,
  generateBreadcrumbSchema,
  getCanonicalUrl,
} from '../../utils/seo';

export async function getStaticPaths() {
  const paths = [];

  for (const slug of PILLAR_SLUGS) {
    const pillarConfig = PILLARS[slug];
    // @ts-ignore
    const rawEntries = await getCollection(slug);

    for (const entry of rawEntries) {
      // Get related entries from the same pillar (excluding current)
      const relatedEntries = rawEntries
        .filter((e: any) => e.id !== entry.id && !e.data.draft)
        .slice(0, 3);

      paths.push({
        params: { pillar: slug, slug: entry.id },
        props: { entry, pillar: pillarConfig, relatedEntries },
      });
    }
  }

  return paths;
}

export interface Props {
  pillar: (typeof PILLARS)[PillarSlug];
  entry: any;
  relatedEntries: any[];
}

const { entry, pillar, relatedEntries } = Astro.props;
const { Content } = await render(entry);

const canonicalUrl = getCanonicalUrl(`/${pillar.slug}/${entry.id}`);
const pubDateFormatted = formatDate(entry.data.pubDate, {
  month: 'long',
  day: 'numeric',
  year: 'numeric',
});
const updatedDateFormatted = entry.data.updatedDate
  ? formatDate(entry.data.updatedDate, {
      month: 'long',
      day: 'numeric',
      year: 'numeric',
    })
  : null;

const displayReadingTime =
  entry.data.readingTime || `${Math.max(3, Math.ceil((entry.body?.length || 1500) / 900))} min read`;

const isRecipe = entry.data.format === 'recipe' || (entry.data.ingredients && entry.data.ingredients.length > 0);
const showFormat = entry.data.format && entry.data.format !== 'standard';

// Deterministic article-to-owned-project routing based on article metadata
const matchedProject = matchOwnedProject({
  pillar: pillar.slug,
  title: entry.data.title,
  description: entry.data.description,
  tags: entry.data.tags,
  topicId: entry.data.topicId,
  audience: entry.data.audience,
  primaryIntent: entry.data.primaryIntent,
  secondaryIntent: entry.data.secondaryIntent,
  targetProject: entry.data.targetProject,
});

// JSON-LD Structured Data for Article or Recipe & Breadcrumbs
const contentJsonLd = isRecipe
  ? generateRecipeSchema({
      title: entry.data.title,
      description: entry.data.description,
      url: canonicalUrl,
      pubDate: entry.data.pubDate,
      updatedDate: entry.data.updatedDate,
      authorName: entry.data.author,
      image: entry.data.image,
      prepTime: entry.data.prepTime,
      cookTime: entry.data.cookTime,
      totalTime: entry.data.totalTime,
      servings: entry.data.servings,
      cuisine: entry.data.cuisine,
      mealType: entry.data.mealType,
      ingredients: entry.data.ingredients,
      directions: entry.data.directions,
    })
  : generateArticleSchema({
      title: entry.data.title,
      description: entry.data.description,
      url: canonicalUrl,
      pubDate: entry.data.pubDate,
      updatedDate: entry.data.updatedDate,
      authorName: entry.data.author,
      pillarName: pillar.name,
    });

const breadcrumbJsonLd = generateBreadcrumbSchema([
  { name: 'Home', url: '/' },
  { name: pillar.name, url: `/${pillar.slug}` },
  { name: entry.data.title, url: `/${pillar.slug}/${entry.id}` },
]);

const combinedJsonLd = [contentJsonLd, breadcrumbJsonLd];
---

<BaseLayout
  title={`${entry.data.title} — LifeMode ${pillar.name}`}
  description={entry.data.description}
  canonicalUrl={canonicalUrl}
  type="article"
  pubDate={entry.data.pubDate}
  updatedDate={entry.data.updatedDate}
  author={entry.data.author}
  image={entry.data.image}
  jsonLd={combinedJsonLd}
>
  <div class="container-narrow" style="padding-top: var(--space-8); padding-bottom: var(--space-20);">
    <!-- Breadcrumb Navigation -->
    <nav aria-label="Breadcrumbs" class="breadcrumb-nav">
      <ol class="breadcrumb-list">
        <li><a href="/">Home</a></li>
        <li class="breadcrumb-separator" aria-hidden="true">&rsaquo;</li>
        <li><a href={`/${pillar.slug}`}>{pillar.name}</a></li>
        <li class="breadcrumb-separator" aria-hidden="true">&rsaquo;</li>
        <li class="breadcrumb-current" aria-current="page">{entry.data.title}</li>
      </ol>
    </nav>

    <!-- Article Header -->
    <article>
      <header class="article-header">
        <div style="display: flex; align-items: center; gap: 0.75rem; margin-bottom: var(--space-4); flex-wrap: wrap;">
          <PillarBadge pillar={pillar.slug} size="md" />
          {showFormat && (
            <span class="badge-format">
              {entry.data.format.replace('-', ' ')}
            </span>
          )}
          <span class="badge-reading-time">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <circle cx="12" cy="12" r="10"></circle>
              <polyline points="12 6 12 12 16 14"></polyline>
            </svg>
            {displayReadingTime}
          </span>
        </div>

        <h1 class="article-headline">
          {entry.data.title}
        </h1>

        <p class="article-lead">
          {entry.data.description}
        </p>

        <!-- Byline & Editorial Metadata Bar -->
        <div class="article-byline-bar">
          <div class="article-byline-meta">
            <span>By <strong style="color: var(--color-text-primary); font-family: var(--font-sans);">{entry.data.author || 'LifeMode'}</strong></span>
            <span style="color: var(--color-text-dim);">&bull;</span>
            <span>Published on <time datetime={toISODate(entry.data.pubDate)} style="color: var(--color-text-primary); font-weight: 600;">{pubDateFormatted}</time></span>
            {updatedDateFormatted && entry.data.updatedDate && (
              <>
                <span style="color: var(--color-text-dim);">&bull;</span>
                <span>Updated <time datetime={toISODate(entry.data.updatedDate)} style="color: var(--color-text-primary); font-weight: 600;">{updatedDateFormatted}</time></span>
              </>
            )}
          </div>
          <div style={`font-size: 0.75rem; font-weight: 800; letter-spacing: 0.08em; text-transform: uppercase; color: ${pillar.color};`}>
            LifeMode &bull; {pillar.name}
          </div>
        </div>
      </header>

      <!-- Hero Photography Banner (Image or Quiet Fallback) -->
      {entry.data.image ? (
        <div class="article-hero-media">
          <img
            src={entry.data.image}
            alt={entry.data.imageAlt || entry.data.title}
            class="article-hero-img"
            loading="eager"
          />
          {entry.data.imageSource && (
            <figcaption class="article-hero-caption" style="margin-top: 0.5rem; font-size: 0.75rem; color: var(--color-text-dim, #94a3b8); text-align: right; padding-right: 0.5rem;">
              Photo / Source: {entry.data.imageSource}
            </figcaption>
          )}
        </div>
      ) : (
        <div class="article-hero-media">
          <div class="article-hero-fallback">
            <div style="text-align: center; padding: var(--space-8);">
              <span style={`font-family: var(--font-display); font-size: 2.8rem; font-style: italic; font-weight: 700; color: ${pillar.color}; display: block; margin-bottom: 0.25rem;`}>LM</span>
              <span style="font-family: var(--font-sans); font-size: 0.75rem; font-weight: 800; text-transform: uppercase; letter-spacing: 0.12em; color: var(--color-text-muted);">
                {pillar.name}
              </span>
            </div>
          </div>
        </div>
      )}

      <!-- Main Reading Column (Prose) -->
      <div class="prose" style="margin-bottom: var(--space-8);">
        <Content />
      </div>

      <!-- Dedicated Lifestyle Recipe Presentation (For Recipe format) -->
      {isRecipe && (
        <RecipeDetails recipe={entry.data} />
      )}

      <!-- Visible Sources & Research Grounding Section -->
      {entry.data.sources && entry.data.sources.length > 0 && (
        <section class="article-sources-section" style="margin-top: var(--space-8); margin-bottom: var(--space-12); padding-top: var(--space-6); border-top: 1px solid var(--color-border);">
          <h2 style="font-family: var(--font-display); font-size: 1.25rem; font-weight: 700; color: var(--color-text-primary); margin-bottom: var(--space-3); letter-spacing: -0.01em;">
            Sources &amp; References
          </h2>
          <ul style="list-style: none; padding: 0; margin: 0; display: flex; flex-direction: column; gap: 0.5rem;">
            {entry.data.sources.map((source: { name: string; url: string }) => (
              <li style="font-size: 0.85rem; color: var(--color-text-muted); display: flex; align-items: baseline; gap: 0.5rem;">
                <span style={`color: ${pillar.color};`}>&bull;</span>
                {source.url ? (
                  <a
                    href={source.url}
                    target="_blank"
                    rel="noopener noreferrer"
                    style="color: var(--color-text-primary); text-decoration: underline; text-underline-offset: 3px;"
                  >
                    {source.name}
                  </a>
                ) : (
                  <span>{source.name}</span>
                )}
              </li>
            ))}
          </ul>
        </section>
      )}

      <!-- Article Footer / Return Navigation -->
      <footer style="margin-top: var(--space-12); padding-top: var(--space-8); border-top: 1px solid var(--color-border);">
        <div style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 1rem;">
          <a href={`/${pillar.slug}`} class="btn btn-outline" style="font-size: 0.8125rem;">
            &larr; More in {pillar.name}
          </a>
          <a href="/" class="btn btn-outline" style="font-size: 0.8125rem; color: var(--color-primary-accent);">
            All stories &rarr;
          </a>
        </div>
      </footer>
    </article>

    <!-- Relevant Owned Project Recommendation (Rendered only when high relevance is matched) -->
    {matchedProject && (
      <section class="article-project-cta-section" style="margin-top: var(--space-12); padding-top: var(--space-8); border-top: 1px solid var(--color-border);">
        <div style="max-width: 640px; margin: 0 auto;">
          <OwnedProjectCta project={matchedProject} compact={true} />
        </div>
      </section>
    )}

    <!-- Related Stories -->
    {relatedEntries.length > 0 && (
      <section style="margin-top: var(--space-16); padding-top: var(--space-10); border-top: 1px solid var(--color-border);">
        <div class="section-header">
          <div>
            <span class="section-kicker">Related Stories</span>
            <h2 class="section-title">More in {pillar.name}</h2>
          </div>
          <a href={`/${pillar.slug}`} class="section-link">
            See all {pillar.name} &rarr;
          </a>
        </div>
        <div class="grid-3">
          {relatedEntries.map((related) => (
            <ArticleCard
              pillar={pillar.slug}
              slug={related.id}
              title={related.data.title}
              description={related.data.description}
              pubDate={related.data.pubDate}
              author={related.data.author}
              image={related.data.image}
              imageAlt={related.data.imageAlt}
              readingTime={related.data.readingTime}
              format={related.data.format}
              tags={related.data.tags}
              variant="card"
            />
          ))}
        </div>
      </section>
    )}
  </div>

  <!-- API / Current-Data / Topic Intelligence Block -->
  <TopicDataSection pillar={pillar.slug as PillarSlug} pillarName={pillar.name} />
</BaseLayout>
