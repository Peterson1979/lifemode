---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PillarBadge from '../../components/PillarBadge.astro';
import ArticleCard from '../../components/ArticleCard.astro';
import { getCollection, render } from 'astro:content';
import { PILLARS, PILLAR_SLUGS, type PillarSlug } from '../../config/site';
import { formatDate, toISODate } from '../../utils/date';
import { generateArticleSchema, generateBreadcrumbSchema, getCanonicalUrl } from '../../utils/seo';

export async function getStaticPaths() {
  const paths = [];

  for (const slug of PILLAR_SLUGS) {
    const pillarConfig = PILLARS[slug];
    // @ts-ignore
    const rawEntries = await getCollection(slug);

    for (const entry of rawEntries) {
      // Get related entries from the same pillar (excluding current)
      const relatedEntries = rawEntries
        .filter((e: any) => e.id !== entry.id)
        .slice(0, 3);

      paths.push({
        params: { pillar: slug, slug: entry.id },
        props: { entry, pillar: pillarConfig, relatedEntries },
      });
    }
  }

  return paths;
}

interface Props {
  pillar: (typeof PILLARS)[PillarSlug];
  entry: any;
  relatedEntries: any[];
}

const { entry, pillar, relatedEntries } = Astro.props;
const { Content } = await render(entry);

const canonicalUrl = getCanonicalUrl(`/${pillar.slug}/${entry.id}`);
const pubDateFormatted = formatDate(entry.data.pubDate, {
  month: 'long',
  day: 'numeric',
  year: 'numeric',
});
const updatedDateFormatted = entry.data.updatedDate
  ? formatDate(entry.data.updatedDate, {
      month: 'long',
      day: 'numeric',
      year: 'numeric',
    })
  : null;

// JSON-LD Structured Data for Article & Breadcrumbs
const articleJsonLd = generateArticleSchema({
  title: entry.data.title,
  description: entry.data.description,
  url: canonicalUrl,
  pubDate: entry.data.pubDate,
  updatedDate: entry.data.updatedDate,
  authorName: entry.data.author,
  pillarName: pillar.name,
});

const breadcrumbJsonLd = generateBreadcrumbSchema([
  { name: 'Home', url: '/' },
  { name: pillar.name, url: `/${pillar.slug}` },
  { name: entry.data.title, url: `/${pillar.slug}/${entry.id}` },
]);

const combinedJsonLd = [articleJsonLd, breadcrumbJsonLd];
---

<BaseLayout
  title={`${entry.data.title} — LifeMode ${pillar.name}`}
  description={entry.data.description}
  canonicalUrl={canonicalUrl}
  type="article"
  pubDate={entry.data.pubDate}
  updatedDate={entry.data.updatedDate}
  author={entry.data.author}
  jsonLd={combinedJsonLd}
>
  <div class="container-narrow" style="padding-top: var(--space-10); padding-bottom: var(--space-16);">
    <!-- Breadcrumb Navigation -->
    <nav aria-label="Breadcrumbs" style="margin-bottom: var(--space-6); font-size: 0.8rem; color: var(--color-text-dim);">
      <ol style="list-style: none; display: flex; align-items: center; gap: 0.5rem; flex-wrap: wrap;">
        <li><a href="/" style="color: var(--color-text-muted);">Home</a></li>
        <li aria-hidden="true">&rsaquo;</li>
        <li><a href={`/${pillar.slug}`} style="color: var(--color-text-muted);">{pillar.name}</a></li>
        <li aria-hidden="true">&rsaquo;</li>
        <li style="color: var(--color-text-secondary);" aria-current="page">{entry.data.title}</li>
      </ol>
    </nav>

    <!-- Article Header -->
    <article>
      <header style="margin-bottom: var(--space-8); border-bottom: 1px solid var(--color-border-subtle); padding-bottom: var(--space-8);">
        <div style="margin-bottom: var(--space-4);">
          <PillarBadge pillar={pillar.slug} size="md" />
        </div>

        <h1 style="font-size: clamp(2.2rem, 4.5vw, 3.25rem); font-weight: 900; line-height: 1.15; letter-spacing: -0.03em; color: #ffffff; margin-bottom: var(--space-4);">
          {entry.data.title}
        </h1>

        <p style="font-size: 1.2rem; line-height: 1.6; color: var(--color-text-secondary); margin-bottom: var(--space-6);">
          {entry.data.description}
        </p>

        <!-- Byline & Meta Info -->
        <div style="display: flex; align-items: center; gap: 1rem; flex-wrap: wrap; font-size: 0.875rem; color: var(--color-text-muted); padding-top: var(--space-4); border-top: 1px solid var(--color-border-subtle);">
          <div>
            <span>By <strong style="color: var(--color-text-primary);">{entry.data.author}</strong></span>
          </div>
          <span style="color: var(--color-text-dim);">&bull;</span>
          <div>
            <span>Published on <time datetime={toISODate(entry.data.pubDate)} style="color: var(--color-text-primary); font-family: var(--font-mono);">{pubDateFormatted}</time></span>
          </div>
          {updatedDateFormatted && (
            <>
              <span style="color: var(--color-text-dim);">&bull;</span>
              <div>
                <span>Updated on <time datetime={toISODate(entry.data.updatedDate)} style="color: var(--color-text-primary); font-family: var(--font-mono);">{updatedDateFormatted}</time></span>
              </div>
            </>
          )}
        </div>
      </header>

      <!-- Main Prose Body -->
      <div class="prose">
        <Content />
      </div>

      <!-- Article Footer / Navigation -->
      <footer style="margin-top: var(--space-12); padding-top: var(--space-6); border-top: 1px solid var(--color-border);">
        <div style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 1rem;">
          <a href={`/${pillar.slug}`} class="read-more" style="font-weight: 600;">
            &larr; Back to all {pillar.name} dispatches
          </a>
          <a href="/" class="read-more" style="font-weight: 600; color: var(--color-text-muted);">
            Return to Homepage &rarr;
          </a>
        </div>
      </footer>
    </article>

    <!-- Related Content Section -->
    {relatedEntries.length > 0 && (
      <section style="margin-top: var(--space-16); padding-top: var(--space-10); border-top: 1px solid var(--color-border);">
        <h2 style="font-size: 1.35rem; font-weight: 800; margin-bottom: var(--space-6);">
          More in {pillar.name}
        </h2>
        <div class="grid-3">
          {relatedEntries.map((related) => (
            <ArticleCard
              pillar={pillar.slug}
              slug={related.id}
              title={related.data.title}
              description={related.data.description}
              pubDate={related.data.pubDate}
              author={related.data.author}
              variant="card"
            />
          ))}
        </div>
      </section>
    )}
  </div>
</BaseLayout>
