---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PillarBadge from '../../components/PillarBadge.astro';
import ArticleCard from '../../components/ArticleCard.astro';
import EcosystemCard from '../../components/EcosystemCard.astro';
import { getCollection, render } from 'astro:content';
import { PILLARS, PILLAR_SLUGS, type PillarSlug } from '../../config/site';
import { ECOSYSTEM_PROJECTS } from '../../config/ecosystem';
import { formatDate, toISODate } from '../../utils/date';
import { generateArticleSchema, generateBreadcrumbSchema, getCanonicalUrl } from '../../utils/seo';

export async function getStaticPaths() {
  const paths = [];

  for (const slug of PILLAR_SLUGS) {
    const pillarConfig = PILLARS[slug];
    // @ts-ignore
    const rawEntries = await getCollection(slug);

    for (const entry of rawEntries) {
      // Get related entries from the same pillar (excluding current)
      const relatedEntries = rawEntries
        .filter((e: any) => e.id !== entry.id)
        .slice(0, 3);

      paths.push({
        params: { pillar: slug, slug: entry.id },
        props: { entry, pillar: pillarConfig, relatedEntries },
      });
    }
  }

  return paths;
}

export interface Props {
  pillar: (typeof PILLARS)[PillarSlug];
  entry: any;
  relatedEntries: any[];
}

const { entry, pillar, relatedEntries } = Astro.props;
const { Content } = await render(entry);

const canonicalUrl = getCanonicalUrl(`/${pillar.slug}/${entry.id}`);
const pubDateFormatted = formatDate(entry.data.pubDate, {
  month: 'long',
  day: 'numeric',
  year: 'numeric',
});
const updatedDateFormatted = entry.data.updatedDate
  ? formatDate(entry.data.updatedDate, {
      month: 'long',
      day: 'numeric',
      year: 'numeric',
    })
  : null;

const displayReadingTime =
  entry.data.readingTime || `${Math.max(3, Math.ceil((entry.body?.length || 1500) / 900))} min read`;

const showFormat = entry.data.format && entry.data.format !== 'standard';

// Find relevant ecosystem project for this pillar
const relevantEcosystem = ECOSYSTEM_PROJECTS.find((p) =>
  p.relevantPillars.includes(pillar.slug as PillarSlug)
);

// JSON-LD Structured Data for Article & Breadcrumbs
const articleJsonLd = generateArticleSchema({
  title: entry.data.title,
  description: entry.data.description,
  url: canonicalUrl,
  pubDate: entry.data.pubDate,
  updatedDate: entry.data.updatedDate,
  authorName: entry.data.author,
  pillarName: pillar.name,
});

const breadcrumbJsonLd = generateBreadcrumbSchema([
  { name: 'Home', url: '/' },
  { name: pillar.name, url: `/${pillar.slug}` },
  { name: entry.data.title, url: `/${pillar.slug}/${entry.id}` },
]);

const combinedJsonLd = [articleJsonLd, breadcrumbJsonLd];
---

<BaseLayout
  title={`${entry.data.title} — LifeMode ${pillar.name}`}
  description={entry.data.description}
  canonicalUrl={canonicalUrl}
  type="article"
  pubDate={entry.data.pubDate}
  updatedDate={entry.data.updatedDate}
  author={entry.data.author}
  image={entry.data.image}
  jsonLd={combinedJsonLd}
>
  <div class="container-narrow" style="padding-top: var(--space-8); padding-bottom: var(--space-20);">
    <!-- Breadcrumb Navigation -->
    <nav aria-label="Breadcrumbs" class="breadcrumb-nav">
      <ol class="breadcrumb-list">
        <li><a href="/">Home</a></li>
        <li class="breadcrumb-separator" aria-hidden="true">&rsaquo;</li>
        <li><a href={`/${pillar.slug}`}>{pillar.name}</a></li>
        <li class="breadcrumb-separator" aria-hidden="true">&rsaquo;</li>
        <li class="breadcrumb-current" aria-current="page">{entry.data.title}</li>
      </ol>
    </nav>

    <!-- Article Header -->
    <article>
      <header class="article-header">
        <div style="display: flex; align-items: center; gap: 0.75rem; margin-bottom: var(--space-4); flex-wrap: wrap;">
          <PillarBadge pillar={pillar.slug} size="md" />
          {showFormat && (
            <span class="badge-format">
              {entry.data.format.replace('-', ' ')}
            </span>
          )}
          <span class="badge-reading-time">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <circle cx="12" cy="12" r="10"></circle>
              <polyline points="12 6 12 12 16 14"></polyline>
            </svg>
            {displayReadingTime}
          </span>
        </div>

        <h1 class="article-headline">
          {entry.data.title}
        </h1>

        <p class="article-lead">
          {entry.data.description}
        </p>

        <!-- Byline & Editorial Metadata Bar -->
        <div class="article-byline-bar">
          <div class="article-byline-meta">
            <span>By <strong style="color: var(--color-text-primary); font-family: var(--font-sans);">{entry.data.author || 'LifeMode Editorial'}</strong></span>
            <span style="color: var(--color-text-dim);">&bull;</span>
            <span>Published on <time datetime={toISODate(entry.data.pubDate)} style="color: var(--color-text-primary);">{pubDateFormatted}</time></span>
            {updatedDateFormatted && entry.data.updatedDate && (
              <>
                <span style="color: var(--color-text-dim);">&bull;</span>
                <span>Updated <time datetime={toISODate(entry.data.updatedDate)} style="color: var(--color-text-primary);">{updatedDateFormatted}</time></span>
              </>
            )}
          </div>
          <div style="font-size: 0.75rem; letter-spacing: 0.08em; text-transform: uppercase; color: var(--color-olive);">
            LifeMode &bull; {pillar.name}
          </div>
        </div>
      </header>

      <!-- Hero Photography Banner (Image or Quiet Fallback) -->
      {entry.data.image ? (
        <div class="article-hero-media">
          <img
            src={entry.data.image}
            alt={entry.data.title}
            class="article-hero-img"
            loading="eager"
          />
        </div>
      ) : (
        <div class="article-hero-media">
          <div class="article-hero-fallback">
            <div style="text-align: center; padding: var(--space-8);">
              <span style="font-family: var(--font-display); font-size: 2.5rem; font-style: italic; font-weight: 700; color: var(--color-text-muted); display: block; margin-bottom: 0.25rem;">LM</span>
              <span style="font-family: var(--font-sans); font-size: 0.75rem; text-transform: uppercase; letter-spacing: 0.12em; color: var(--color-text-muted);">
                {pillar.name} &bull; Editorial Dispatch
              </span>
            </div>
          </div>
        </div>
      )}

      <!-- Main Reading Column (Prose) -->
      <div class="prose" style="margin-bottom: var(--space-12);">
        <Content />
      </div>

      <!-- Article Footer / Return Navigation -->
      <footer style="margin-top: var(--space-12); padding-top: var(--space-8); border-top: 1px solid var(--color-border);">
        <div style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 1rem;">
          <a href={`/${pillar.slug}`} class="btn btn-outline" style="font-size: 0.8125rem;">
            &larr; More in {pillar.name}
          </a>
          <a href="/" class="btn btn-outline" style="font-size: 0.8125rem; color: var(--color-olive);">
            Front Page Dispatches &rarr;
          </a>
        </div>
      </footer>
    </article>

    <!-- Relevant Ecosystem Recommendation -->
    {relevantEcosystem && (
      <section style="margin-top: var(--space-12); padding-top: var(--space-8); border-top: 1px solid var(--color-border);">
        <div style="max-width: 640px; margin: 0 auto;">
          <EcosystemCard project={relevantEcosystem} compact={true} />
        </div>
      </section>
    )}

    <!-- Curated Related Dispatches -->
    {relatedEntries.length > 0 && (
      <section style="margin-top: var(--space-16); padding-top: var(--space-10); border-top: 1px solid var(--color-border);">
        <div class="section-header">
          <div>
            <span class="section-kicker">Curated Reading</span>
            <h2 class="section-title">Related Dispatches in {pillar.name}</h2>
          </div>
          <a href={`/${pillar.slug}`} class="section-link">
            Explore Pillar &rarr;
          </a>
        </div>
        <div class="grid-3">
          {relatedEntries.map((related) => (
            <ArticleCard
              pillar={pillar.slug}
              slug={related.id}
              title={related.data.title}
              description={related.data.description}
              pubDate={related.data.pubDate}
              author={related.data.author}
              image={related.data.image}
              readingTime={related.data.readingTime}
              format={related.data.format}
              tags={related.data.tags}
              variant="card"
            />
          ))}
        </div>
      </section>
    )}
  </div>
</BaseLayout>
