---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ArticleCard from '../../components/ArticleCard.astro';
import PillarBadge from '../../components/PillarBadge.astro';
import EcosystemCard from '../../components/EcosystemCard.astro';
import { getCollection } from 'astro:content';
import { PILLARS, PILLAR_SLUGS, type PillarSlug } from '../../config/site';
import { ECOSYSTEM_PROJECTS } from '../../config/ecosystem';
import { generateBreadcrumbSchema } from '../../utils/seo';

export async function getStaticPaths() {
  const paths = await Promise.all(
    PILLAR_SLUGS.map(async (slug) => {
      const pillar = PILLARS[slug];
      // @ts-ignore
      const rawArticles = await getCollection(slug);
      const articles = rawArticles.sort(
        (a: any, b: any) => new Date(b.data.pubDate).getTime() - new Date(a.data.pubDate).getTime()
      );
      return {
        params: { pillar: slug },
        props: { pillar, articles },
      };
    })
  );

  return paths;
}

export interface Props {
  pillar: (typeof PILLARS)[PillarSlug];
  articles: Array<{
    id: string;
    data: {
      title: string;
      description: string;
      pubDate: Date;
      updatedDate?: Date;
      author?: string;
      featured?: boolean;
      image?: string;
      imageAlt?: string;
      readingTime?: string;
      format?: string;
      tags?: string[];
    };
  }>;
}

const { pillar, articles } = Astro.props;

const relevantEcosystem = ECOSYSTEM_PROJECTS.find((p) =>
  p.relevantPillars.includes(pillar.slug as PillarSlug)
);

const breadcrumbSchema = generateBreadcrumbSchema([
  { name: 'Home', url: '/' },
  { name: pillar.name, url: `/${pillar.slug}` },
]);
---

<BaseLayout
  title={`${pillar.name} — ${pillar.tagline} | LifeMode`}
  description={pillar.description}
  jsonLd={breadcrumbSchema}
>
  <!-- Breadcrumb Navigation -->
  <div class="container" style="padding-top: var(--space-6);">
    <nav aria-label="Breadcrumbs" class="breadcrumb-nav">
      <ol class="breadcrumb-list">
        <li><a href="/">Home</a></li>
        <li class="breadcrumb-separator" aria-hidden="true">&rsaquo;</li>
        <li class="breadcrumb-current" aria-current="page">{pillar.name}</li>
      </ol>
    </nav>
  </div>

  <!-- Pillar Hero Section -->
  <section class="hero-editorial" style="padding-top: var(--space-6); padding-bottom: var(--space-10);">
    <div class="container">
      <div style="margin-bottom: var(--space-3);">
        <PillarBadge pillar={pillar.slug} size="md" asLink={false} />
      </div>
      <h1 class="hero-heading" style="margin-bottom: var(--space-3);">
        {pillar.name}
      </h1>
      <p style="font-family: var(--font-serif); font-size: 1.35rem; font-style: italic; color: var(--color-text-secondary); margin-bottom: var(--space-4); max-width: 680px;">
        "{pillar.tagline}"
      </p>
      <p class="hero-lead" style="max-width: 720px; margin-bottom: 0;">
        {pillar.description}
      </p>
    </div>
  </section>

  <!-- Article Grid / Archive -->
  <section class="section">
    <div class="container">
      <div class="section-header">
        <div>
          <span class="section-kicker">Articles</span>
          <h2 class="section-title">Articles in {pillar.name}</h2>
          <p class="section-subtitle">
            Showing {articles.length} {articles.length === 1 ? 'article' : 'articles'}
          </p>
        </div>
      </div>

      {articles.length > 0 ? (
        <div>
          {articles.length >= 3 ? (
            <div>
              <!-- Lead Article Feature -->
              <div style="margin-bottom: var(--space-10); padding-bottom: var(--space-10); border-bottom: 1px solid var(--color-border);">
                <ArticleCard
                  pillar={pillar.slug}
                  slug={articles[0].id}
                  title={articles[0].data.title}
                  description={articles[0].data.description}
                  pubDate={articles[0].data.pubDate}
                  author={articles[0].data.author}
                  image={articles[0].data.image}
                  imageAlt={articles[0].data.imageAlt}
                  readingTime={articles[0].data.readingTime}
                  format={articles[0].data.format}
                  tags={articles[0].data.tags}
                  variant="lead"
                  featured={true}
                />
              </div>

              <!-- Remaining Articles Grid -->
              <div class="grid-3">
                {articles.slice(1).map((article) => (
                  <ArticleCard
                    pillar={pillar.slug}
                    slug={article.id}
                    title={article.data.title}
                    description={article.data.description}
                    pubDate={article.data.pubDate}
                    author={article.data.author}
                    image={article.data.image}
                    imageAlt={article.data.imageAlt}
                    readingTime={article.data.readingTime}
                    format={article.data.format}
                    tags={article.data.tags}
                    variant="card"
                  />
                ))}
              </div>
            </div>
          ) : (
            <div class="grid-3">
              {articles.map((article) => (
                <ArticleCard
                  pillar={pillar.slug}
                  slug={article.id}
                  title={article.data.title}
                  description={article.data.description}
                  pubDate={article.data.pubDate}
                  author={article.data.author}
                  image={article.data.image}
                  imageAlt={article.data.imageAlt}
                  readingTime={article.data.readingTime}
                  format={article.data.format}
                  tags={article.data.tags}
                  variant="card"
                />
              ))}
            </div>
          )}
        </div>
      ) : (
        <div class="empty-state-card">
          <div class="empty-state-icon">
            <span style="font-family: var(--font-display); font-size: 2.2rem; font-style: italic; color: var(--color-olive); font-weight: 700;">LM</span>
          </div>
          <h3 style="font-family: var(--font-display); font-size: 1.4rem; margin-bottom: var(--space-2); color: var(--color-text-primary);">
            Articles coming soon
          </h3>
          <p style="color: var(--color-text-secondary); font-size: 0.95rem; line-height: 1.6; max-width: 480px; margin-inline: auto; margin-bottom: var(--space-6);">
            Articles for {pillar.name} will appear here soon.
          </p>
          <a href="/" class="btn btn-outline">Return to homepage</a>
        </div>
      )}

      <!-- Related Projects Extension -->
      {relevantEcosystem && (
        <div style="margin-top: var(--space-16); padding-top: var(--space-10); border-top: 1px solid var(--color-border);">
          <div class="section-header">
            <div>
              <span class="section-kicker">From our projects</span>
              <h2 class="section-title">Apps & tools</h2>
            </div>
          </div>
          <div style="max-width: 680px;">
            <EcosystemCard project={relevantEcosystem} />
          </div>
        </div>
      )}
    </div>
  </section>
</BaseLayout>
