---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ArticleCard from '../../components/ArticleCard.astro';
import PillarBadge from '../../components/PillarBadge.astro';
import { getCollection } from 'astro:content';
import { PILLARS, PILLAR_SLUGS, type PillarSlug } from '../../config/site';
import { generateBreadcrumbSchema } from '../../utils/seo';

export async function getStaticPaths() {
  const paths = await Promise.all(
    PILLAR_SLUGS.map(async (slug) => {
      const pillar = PILLARS[slug];
      // @ts-ignore
      const rawArticles = await getCollection(slug);
      const articles = rawArticles.sort(
        (a: any, b: any) => new Date(b.data.pubDate).getTime() - new Date(a.data.pubDate).getTime()
      );
      return {
        params: { pillar: slug },
        props: { pillar, articles },
      };
    })
  );

  return paths;
}

interface Props {
  pillar: (typeof PILLARS)[PillarSlug];
  articles: Array<{
    id: string;
    data: {
      title: string;
      description: string;
      pubDate: Date;
      updatedDate?: Date;
      author?: string;
      featured?: boolean;
    };
  }>;
}

const { pillar, articles } = Astro.props;

const breadcrumbSchema = generateBreadcrumbSchema([
  { name: 'Home', url: '/' },
  { name: pillar.name, url: `/${pillar.slug}` },
]);
---

<BaseLayout
  title={`${pillar.name} — ${pillar.tagline} | LifeMode`}
  description={pillar.description}
  jsonLd={breadcrumbSchema}
>
  <!-- Pillar Hero -->
  <section
    class="hero-editorial"
    style={`background: radial-gradient(circle at 50% 0%, ${pillar.bgLight} 0%, transparent 70%);`}
  >
    <div class="container">
      <div style="margin-bottom: var(--space-3);">
        <PillarBadge pillar={pillar.slug} size="md" asLink={false} />
      </div>
      <h1 class="hero-heading" style="margin-bottom: var(--space-3);">
        {pillar.name}
      </h1>
      <p style="font-size: 1.25rem; font-weight: 600; color: #ffffff; margin-bottom: var(--space-3);">
        {pillar.tagline}
      </p>
      <p class="hero-lead">
        {pillar.description}
      </p>
    </div>
  </section>

  <!-- Article Grid / Archive -->
  <section class="section">
    <div class="container">
      <div class="section-header">
        <div>
          <h2 class="section-title">Published Dispatches</h2>
          <p class="section-subtitle">
            Showing {articles.length} curated {articles.length === 1 ? 'story' : 'stories'} in {pillar.name}
          </p>
        </div>
      </div>

      {articles.length > 0 ? (
        <div class="grid-3">
          {articles.map((article) => (
            <ArticleCard
              pillar={pillar.slug}
              slug={article.id}
              title={article.data.title}
              description={article.data.description}
              pubDate={article.data.pubDate}
              author={article.data.author}
              variant="card"
            />
          ))}
        </div>
      ) : (
        <div style="padding: var(--space-12); text-align: center; background-color: var(--color-surface); border: 1px solid var(--color-border); border-radius: var(--radius-lg);">
          <p style="color: var(--color-text-secondary); font-size: 1.1rem;">
            No published dispatches in this pillar yet. Check back soon for new editorial content.
          </p>
        </div>
      )}
    </div>
  </section>
</BaseLayout>
