# LifeMode Environment Configuration Template
# Copy this file to .env and configure local values as needed.

PUBLIC_SITE_URL=http://localhost:4321
SITE_NAME=LifeMode

# Discovery Engine Providers (Leave empty for default fixture mode)
# PINTEREST_ACCESS_TOKEN=
# PINTEREST_APP_ID=
# GOOGLE_TRENDS_API_KEY=
# CONTENT_ENGINE_API_KEY=

# AI Router V1 Configuration
# Provider Order Priority (comma-separated: gemini,groq or fixture)
# AI_PROVIDER_ORDER=gemini,groq

# Google Gemini Provider
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.5-flash
# GEMINI_DAILY_TOKEN_BUDGET=1000000
# GEMINI_TPM_LIMIT=1000000

# Groq Cloud Provider
# GROQ_API_KEY=
# GROQ_MODEL=openai/gpt-oss-20b
# GROQ_DAILY_TOKEN_BUDGET=1000000
# GROQ_TPM_LIMIT=8000

# AI Router Limits & Budgets
# AI_REQUEST_TIMEOUT_MS=30000
# AI_MAX_ATTEMPTS=3
# AI_RETRY_DELAY_MS=1000
# AI_DAILY_TOTAL_TOKEN_BUDGET=2000000
# AI_RPM_LIMIT=30
# AI_RPD_LIMIT=1000

# Publishing V1 Configuration (Defaults to safe dry-run)
# PUBLISHING_PROVIDER=fixture
# PUBLISHING_DRY_RUN=true
# PUBLISHING_DEFAULT_AUTHOR=LifeMode Editorial
# PUBLISHING_MIN_SCORE=85
# PUBLISHING_MIN_SAFETY_SCORE=85
# PUBLISHING_MIN_FACTUALITY_SCORE=85

# Editorial Automation V1 Configuration (CLI & Manual)
# EDITORIAL_AUTOMATION_ENABLED=false
# EDITORIAL_AUTOMATION_MAX_OPPORTUNITIES=1
# EDITORIAL_AUTOMATION_DRY_RUN=true
# EDITORIAL_AUTOMATION_MIN_SCORE=80
# EDITORIAL_AUTOMATION_PROVIDER=fixture

# Scheduled Editorial Automation V1 Configuration (Scheduler & GitHub Actions)
# LIFEMODE_AUTOMATION_ENABLED=false          # Master switch (must be true for execution)
# LIFEMODE_AUTOMATION_DRY_RUN=true           # Safe default: true (no Git commits, no pushes)
# LIFEMODE_AUTOMATION_COMMIT=false           # Set true to create local publication commits
# LIFEMODE_AUTOMATION_PUSH=false             # Set true to push published articles to remote master
# LIFEMODE_AUTOMATION_MAX_OPPORTUNITIES=1    # Maximum articles to process per scheduled run
# LIFEMODE_AUTOMATION_MIN_SCORE=80           # Minimum discovery score threshold (0-100)
# LIFEMODE_AUTOMATION_PROVIDER=router        # Provider mode: 'router' (AI Router) or 'fixture' (Offline)
# LIFEMODE_AUTOMATION_GIT_REMOTE=origin      # Remote name for Git push
# LIFEMODE_AUTOMATION_GIT_BRANCH=master      # Branch name for Git push


